.state {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  padding: 56rpx 40rpx;
  background: #fbfcf8;
  border: 2rpx dashed #c3d3c7;
  border-radius: 24rpx;
}
.state-compact {
  padding: 36rpx 32rpx;
}
.state-error {
  background: #fdf6f1;
  border-color: #eccfbf;
}
.state-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #e8efe8;
  margin-bottom: 20rpx;
}
.state-error .state-icon {
  background: #f8e2d6;
}
.state-glyph {
  font-family: "Songti SC", "STSong", "Noto Serif SC", serif;
  font-size: 36rpx;
  font-weight: 800;
  color: #164945;
}
.state-error .state-glyph {
  color: #a75132;
}
.state-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #172b2a;
  line-height: 1.5;
}
.state-desc {
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #657a73;
  max-width: 560rpx;
}
.state-actions {
  display: flex;
  justify-content: center;
  margin-top: 28rpx;
}
.state-btn {
  margin: 0 10rpx;
}
.spinner {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  border: 5rpx solid #cfe0d4;
  border-top-color: #164945;
  animation: spin 0.8s linear infinite;
}
@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}
