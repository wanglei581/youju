<view class="row {{last ? '' : 'row--line'}}">
  <view class="head" bindtap="open">
    <text class="tag tag--{{kindCls}}">{{doc.kind}}</text>
    <text wx:if="{{statusText}}" class="status status--{{statusCls}}">{{statusText}}</text>
    <text class="region">{{label || doc.region}}</text>
    <text wx:if="{{due}}" class="due {{due.tone ? 'due--' + due.tone : ''}}">{{due.text}}</text>
    <text wx:elif="{{dueNote}}" class="due">{{dueNote}}</text>
  </view>
  <view class="title" bindtap="open"><text wx:for="{{segs}}" wx:key="index" class="{{item.hl ? 'hl' : ''}}">{{item.t}}</text></view>
  <!-- 机器摘录的截止（D-061）：同一条里写明未经人工核对，并附原文那句话 -->
  <view wx:if="{{excerpt}}" class="excerpt" bindtap="open"><text class="excerpt-tag">{{excerpt.label}}</text><text class="excerpt-quote">原文：{{excerpt.quote}}</text></view>
  <view wx:if="{{issuerLong}}" class="issuer">{{doc.issuer}}</view>
  <view class="meta">
    <text><text wx:if="{{!issuerLong && doc.issuer}}">{{doc.issuer}}</text><text wx:if="{{!issuerLong && doc.issuer && doc.date}}"> · </text><text wx:if="{{doc.date}}">{{doc.date}}</text></text>
    <!-- 原网页已撤下或改了地址（后台每周检查，连续两次打不开才算，youju/link_check.py） -->
    <text wx:if="{{doc.link_gone}}" class="gone">原网页已失效</text>
    <view class="copy" catchtap="copy" aria-role="button" aria-label="复制原文链接">
      <t-icon name="copy" size="28rpx" />
      <text>复制原文链接</text>
    </view>
  </view>
  <!-- 转发版本：同一份部里通知的其他地方版本，各自的截止和原文在各自的详情里 -->
  <view wx:if="{{groupText}}" class="group" catchtap="toggleGroup" aria-role="button" aria-expanded="{{groupOpen}}">
    <text>{{groupText}}</text>
    <t-icon name="{{groupOpen ? 'chevron-up' : 'chevron-down'}}" size="28rpx" />
  </view>
  <view wx:if="{{groupText && groupOpen}}" class="versions">
    <view wx:for="{{doc.group.items}}" wx:key="id" class="version" data-id="{{item.id}}" catchtap="openVersion" aria-role="link" aria-label="{{item.label}}：{{item.issuer}}">
      <view class="version-main">
        <text class="version-label">{{item.label}}</text>
        <text class="version-meta">{{item.issuer}}<text wx:if="{{item.date}}"> · {{item.date}}</text></text>
      </view>
      <view class="version-copy" data-url="{{item.url}}" catchtap="copyVersion" aria-role="button" aria-label="复制{{item.label}}的原文链接">复制原文链接</view>
    </view>
    <view class="versions-note">各版本的截止日期、报送要求可能不同，以各自原文为准</view>
  </view>
</view>
