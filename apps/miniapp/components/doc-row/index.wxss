.row { padding: 28rpx 0 26rpx; }
.row--line { border-bottom: 2rpx solid var(--line); }
.head { display: flex; flex-wrap: wrap; align-items: center; gap: 12rpx; row-gap: 8rpx; }
.region { font-size: 24rpx; color: var(--t2); white-space: nowrap; }
.title { margin-top: 14rpx; font-size: 32rpx; font-weight: 600; line-height: 48rpx; color: var(--t1); }
.hl { color: var(--brand); }
.issuer { margin-top: 14rpx; font-size: 25rpx; line-height: 1.6; color: var(--t2); }
.meta { margin-top: 14rpx; display: flex; align-items: center; gap: 24rpx; font-size: 25rpx; color: var(--t2); }
.issuer + .meta { margin-top: 4rpx; }
.copy { margin-left: auto; flex-shrink: 0; display: flex; align-items: center; gap: 6rpx; color: var(--brand); white-space: nowrap; }
.group { margin-top: 16rpx; display: inline-flex; align-items: center; gap: 6rpx; padding: 6rpx 16rpx; border-radius: 8rpx; background: var(--fill); font-size: 25rpx; line-height: 1.6; color: var(--t2); }
.versions { margin-top: 12rpx; padding: 4rpx 20rpx; border-left: 4rpx solid var(--line2); }
.version { display: flex; align-items: center; gap: 16rpx; padding: 16rpx 0; border-bottom: 2rpx solid var(--line); }
.version-main { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 2rpx; }
.version-label { font-size: 27rpx; font-weight: 600; color: var(--t1); }
.version-meta { font-size: 24rpx; line-height: 1.5; color: var(--t2); }
.version-copy { flex-shrink: 0; font-size: 24rpx; color: var(--brand); white-space: nowrap; }
.versions-note { padding: 14rpx 0 6rpx; font-size: 23rpx; line-height: 1.6; color: var(--t3); }
/* 机器摘录的截止（D-061）：灰色标签 + 原句，和核对过的区分开 */
.due--excerpt { color: var(--t2); }
.excerpt { margin-top: 8rpx; display: flex; flex-direction: column; gap: 4rpx; }
.excerpt-tag { align-self: flex-start; padding: 2rpx 10rpx; border-radius: 6rpx; background: var(--fill); color: var(--t2); font-size: 22rpx; }
.excerpt-quote { font-size: 24rpx; line-height: 1.6; color: var(--t2); overflow: hidden; text-overflow: ellipsis; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }
