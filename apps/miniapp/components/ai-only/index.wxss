.ai-only { margin: 16rpx 32rpx 0; padding: 16rpx 24rpx; border-radius: 12rpx; background: var(--brand-tint); font-size: 26rpx; color: var(--t1); }
.ai-only-row { display: flex; align-items: center; justify-content: space-between; gap: 24rpx; }
/* 从 AI 首页的两项能力来选通知时，下面一行写怎么选 */
.ai-only-hint { margin-top: 8rpx; font-size: 24rpx; line-height: 1.6; color: var(--t2); }
/* 去掉了那一条、还在选通知时只剩这一行 */
.ai-only--hint { font-size: 24rpx; line-height: 1.6; color: var(--t2); }
