<view wx:if="{{variant === 'exit'}}" class="exit-btn exit-btn--main" bindtap="remove" aria-role="button">去掉“{{only}}”</view>
<view wx:elif="{{variant === 'hint'}}" class="ai-only ai-only--hint">{{hint}}</view>
<view wx:else class="ai-only">
  <view class="ai-only-row"><text>{{only}}通知</text><text class="link" bindtap="remove" aria-role="button">去掉</text></view>
  <view wx:if="{{hint}}" class="ai-only-hint">{{hint}}</view>
</view>
