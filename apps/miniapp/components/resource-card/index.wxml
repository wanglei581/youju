<view class="rc {{selected ? 'rc-on' : ''}}" hover-class="rc-hover" hover-stay-time="80" bindtap="onOpen" aria-role="link" aria-label="查看详情：{{item.title}}">
  <view class="rc-top">
    <view wx:if="{{selectable}}" class="rc-check-hit" catchtap="onToggle" aria-role="checkbox" aria-checked="{{selected}}" aria-label="{{selected ? '取消选择' : '选择导出'}}：{{item.title}}">
      <view class="rc-check {{selected ? 'rc-check-on' : ''}}"><view wx:if="{{selected}}" class="rc-tick"></view></view>
    </view>
    <view class="rc-title">{{item.title}}</view>
  </view>

  <view class="rc-tags">
    <text class="tag tag-{{item.coverageTone}}">{{item.coverageLabel}}</text>
    <text class="tag">{{item.kindLabel}}</text>
    <text wx:if="{{item.region}}" class="tag tag-line">{{item.region}}</text>
    <text wx:if="{{item.industry}}" class="tag tag-line">{{item.industry}}</text>
    <text class="tag {{item.publishedAt ? 'tag-line' : 'tag-warn'}}">{{item.dateLabel}}</text>
  </view>

  <view wx:if="{{item.verified}}" class="rc-answer">
    <text class="rc-answer-label">答案</text>
    <text class="rc-answer-text" user-select>{{item.answer}}</text>
    <view wx:if="{{item.evidenceLocator}}" class="rc-evidence">证据位置：{{item.evidenceLocator}}</view>
  </view>
  <view wx:else class="rc-answer rc-answer-none">
    <text>{{item.coverageDesc}}</text>
  </view>

  <view wx:if="{{item.summary}}" class="rc-summary">
    <text class="rc-summary-label">摘要</text><text user-select>{{item.summary}}</text>
  </view>

  <view class="rc-foot">
    <view class="rc-source">
      <text class="rc-publisher">{{item.publisher}}</text>
      <text class="rc-meta">{{item.rightsLabel}} · v{{item.versionNo}}</text>
    </view>
    <view class="rc-actions">
      <view class="rc-copy" hover-class="btn-hover" catchtap="onCopy" aria-role="button" aria-label="复制原站链接">复制原站</view>
      <view class="rc-more">详情<view class="chevron rc-chevron"></view></view>
    </view>
  </view>
</view>
