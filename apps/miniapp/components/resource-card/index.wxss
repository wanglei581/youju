.rc {
  background: #ffffff;
  border: 1rpx solid #e2e8e0;
  border-radius: 24rpx;
  padding: 26rpx 28rpx 22rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 6rpx 20rpx rgba(31, 64, 51, 0.035);
  position: relative;
}
.rc-on {
  border-color: #6aa98c;
  box-shadow: 0 0 0 3rpx #dbede2, 0 6rpx 20rpx rgba(31, 64, 51, 0.05);
}
.rc-hover {
  background: #fbfcf9;
}
.rc-top {
  display: flex;
  align-items: flex-start;
}
.rc-check-hit {
  padding: 4rpx 18rpx 12rpx 0;
  margin: -4rpx 0 0 -4rpx;
  flex-shrink: 0;
}
.rc-check {
  width: 40rpx;
  height: 40rpx;
  border-radius: 12rpx;
  border: 3rpx solid #b9cabe;
  background: #ffffff;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
}
.rc-check-on {
  background: #164945;
  border-color: #164945;
}
.rc-tick {
  width: 10rpx;
  height: 20rpx;
  border-right: 4rpx solid #ffffff;
  border-bottom: 4rpx solid #ffffff;
  transform: rotate(45deg) translate(-2rpx, -2rpx);
}
.rc-title {
  flex: 1;
  min-width: 0;
  font-size: 31rpx;
  font-weight: 700;
  line-height: 1.45;
  color: #172b2a;
}
.rc-tags {
  display: flex;
  flex-wrap: wrap;
  margin-top: 16rpx;
}
.rc-answer {
  margin-top: 6rpx;
  padding: 18rpx 20rpx;
  border-radius: 16rpx;
  background: #eef5ef;
  font-size: 27rpx;
  line-height: 1.7;
  color: #22443a;
}
.rc-answer-label {
  display: inline-block;
  font-size: 21rpx;
  font-weight: 800;
  color: #ffffff;
  background: #276f53;
  border-radius: 8rpx;
  padding: 0 10rpx;
  margin-right: 12rpx;
  line-height: 34rpx;
  vertical-align: 2rpx;
}
.rc-answer-text {
  font-weight: 600;
}
.rc-evidence {
  margin-top: 8rpx;
  font-size: 23rpx;
  color: #4b6a5f;
}
.rc-answer-none {
  background: #f5f5f1;
  color: #6c7d75;
  font-size: 24rpx;
}
.rc-summary {
  margin-top: 14rpx;
  font-size: 25rpx;
  line-height: 1.7;
  color: #4d625b;
}
.rc-summary-label {
  font-weight: 800;
  color: #8c4f31;
  margin-right: 10rpx;
}
.rc-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 18rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #eef1ec;
}
.rc-source {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}
.rc-publisher {
  font-size: 24rpx;
  color: #33504a;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.rc-meta {
  font-size: 22rpx;
  color: #93a39c;
}
.rc-actions {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  margin-left: 16rpx;
}
.rc-copy {
  font-size: 23rpx;
  font-weight: 700;
  color: #164945;
  background: #e8efe8;
  border-radius: 999rpx;
  padding: 10rpx 20rpx;
}
.rc-more {
  display: flex;
  align-items: center;
  font-size: 23rpx;
  color: #657a73;
  margin-left: 18rpx;
}
.rc-chevron {
  width: 12rpx;
  height: 12rpx;
  margin-left: 6rpx;
}
