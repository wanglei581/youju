.tool-fab {
  position: fixed;
  right: 24rpx;
  z-index: 110;
  width: 112rpx;
  min-height: 112rpx;
  margin: 0;
  padding: 16rpx 8rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #2A5CE0;
  color: #FFFFFF;
  font-size: 30rpx;
  line-height: 1.5;
  white-space: normal;
  box-shadow: 0 4rpx 16rpx rgba(42, 92, 224, 0.18);
}
.tool-fab::after { border: 0; }
.tool-spacer { width: 100%; }
