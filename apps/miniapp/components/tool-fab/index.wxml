  <button wx:if="{{!blocked}}" class="tool-fab" style="bottom: calc({{bottomRpx}}rpx + env(safe-area-inset-bottom) + 24rpx)" bindtap="open" aria-label="打开 AI 内测">AI 内测</button>
</block>
