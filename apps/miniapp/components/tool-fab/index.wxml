<view class="tool-spacer" style="height: calc({{barHeight || bottomRpx + 'rpx'}} + {{enabled ? '160rpx' : '80rpx'}} + env(safe-area-inset-bottom))"></view>
<button wx:if="{{enabled && visible && !blocked && !keyboard && !overlay}}" class="tool-fab" style="bottom: calc({{barHeight || bottomRpx + 'rpx'}} + env(safe-area-inset-bottom) + 24rpx)" bindtap="open" aria-label="打开工具"><text wx:if="{{aiEnabled}}">AI 顾问</text><text wx:else>工具</text></button>
