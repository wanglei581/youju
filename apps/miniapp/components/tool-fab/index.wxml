<view wx:if="{{loginOpen}}" class="tool-spacer" style="height: calc({{barHeight || bottomRpx + 'rpx'}} + {{enabled ? '160rpx' : '80rpx'}} + env(safe-area-inset-bottom))"></view>
<button wx:if="{{enabled && visible && !blocked && !keyboard && !overlay}}" class="tool-fab" style="bottom: calc({{barHeight || bottomRpx + 'rpx'}} + env(safe-area-inset-bottom) + 24rpx)" bindtap="open" aria-label="打开工具">工具</button>
