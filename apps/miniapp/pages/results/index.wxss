.result-item { padding: 28rpx 0; border-bottom: 1rpx solid var(--line); font-size: 26rpx; line-height: 1.8; }
.title { color: var(--brand); font-size: 30rpx; font-weight: 600; }
.muted { margin-top: 16rpx; font-size: 24rpx; line-height: 1.7; }
.source { word-break: break-all; }
.source text { display: block; }
button { margin-top: 24rpx; font-size: 26rpx; }
.error { color: var(--red); }
