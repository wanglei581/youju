<notice-bar />
<view class="top">
  <view class="search-row">
    <view class="search-box">
      <t-icon name="search" size="34rpx" color="#4E5969" />
      <input class="search-input" value="{{q}}" placeholder="搜申报通知、名单、政策或文号" confirm-type="search" bindinput="onInput" aria-label="搜索关键词" />
      <view wx:if="{{q}}" class="clear" bindtap="clearQ" aria-role="button" aria-label="清空"><t-icon name="close" size="20rpx" color="#FFFFFF" /></view>
    </view>
    <text class="cancel" bindtap="cancel">取消</text>
  </view>
  <view class="kind-tabs" aria-role="tablist">
    <view wx:for="{{tabs}}" wx:key="key" class="kind-tab {{tab === item.key ? 'kind-tab--on' : ''}}" data-key="{{item.key}}" bindtap="pickTab" aria-role="tab" aria-selected="{{tab === item.key}}">
      <text>{{item.label}}{{tab === item.key && !loading && !error ? ' ' + total : ''}}</text>
      <view wx:if="{{tab === item.key}}" class="kind-bar"></view>
    </view>
  </view>
</view>

<!-- 筛选入口（D-061：地区、时间、状态、部门放外面，类型在上面的页签里，其余在"筛选"里）：固定文字，管的组里有已选时变品牌蓝（发布时间默认的近 30 天不算），具体值只在下面的已选条件条里 -->
<view class="chips">
  <view class="chip {{entries.region.on ? 'chip--on' : ''}}" data-group="{{entries.region.group}}" bindtap="openFilter">地区<t-icon name="chevron-down" size="26rpx" color="{{entries.region.on ? '#2A5CE0' : '#4E5969'}}" /></view>
  <view class="chip {{entries.time.on ? 'chip--on' : ''}}" data-group="{{entries.time.group}}" bindtap="openFilter">时间<t-icon name="chevron-down" size="26rpx" color="{{entries.time.on ? '#2A5CE0' : '#4E5969'}}" /></view>
  <view class="chip {{entries.status.on ? 'chip--on' : ''}}" data-group="{{entries.status.group}}" bindtap="openFilter">状态<t-icon name="chevron-down" size="26rpx" color="{{entries.status.on ? '#2A5CE0' : '#4E5969'}}" /></view>
  <view class="chip {{entries.dept.on ? 'chip--on' : ''}}" data-group="{{entries.dept.group}}" bindtap="openFilter">部门<t-icon name="chevron-down" size="26rpx" color="{{entries.dept.on ? '#2A5CE0' : '#4E5969'}}" /></view>
  <view class="filter-link {{moreOn ? 'filter-link--on' : ''}}" bindtap="openFilter"><t-icon name="filter" size="34rpx" color="{{moreOn ? '#2A5CE0' : '#1D2129'}}" />筛选</view>
</view>

<!-- 已选条件：横向滚动，点一个就去掉这个条件并重新查；最后是"清空"。没有已选条件时不显示 -->
<scroll-view wx:if="{{activeChips.length}}" class="picked-bar" scroll-x enhanced show-scrollbar="{{false}}">
  <view class="picked-row">
    <view wx:for="{{activeChips}}" wx:key="key" class="picked" data-group="{{item.group}}" data-option="{{item.option}}" bindtap="removePicked" aria-role="button" aria-label="去掉条件：{{item.label}}">{{item.label}}<t-icon name="close" size="20rpx" color="#2A5CE0" /></view>
    <view class="picked-clear" bindtap="resetFilter" aria-role="button">清空</view>
  </view>
</scroll-view>

<!-- 只看能解读的（D-075，从板块首页进来时带上）：只管这一次，可以去掉；不进关注和转发 -->
<ai-only wx:if="{{aiOnly}}" bind:remove="removeAi" />
<!-- 结果信息：第一行是份数，写明当前看的发布时间（默认近 30 天，10/15 走查：只写"3 份 不限时间共 12 份"看不懂；改为"近 30 天 3 份 · 共 12 份"，字数和原来差不多、不挤换行；选了不限时只写份数）、排序、选择、关注；有折叠时第二行写折叠了几篇 -->
<view wx:if="{{!loading && !error}}" class="summary">
  <view class="summary-left"><text wx:if="{{chipTime !== '不限'}}" class="weak">{{chipTime}} </text><text class="b">{{total}}</text> 份<text wx:if="{{chipTime !== '不限'}}" class="weak summary-all"> · 共 {{totalAll}} 份</text></view>
  <view class="summary-right">
    <text>按发布时间 ↓</text>
    <text class="link" bindtap="select" aria-role="button">{{selecting ? '完成' : '选择'}}</text>
    <!-- 关注这个搜索（含已选条件，有新文件时在关注页标出）。协议定稿前不显示（D-056） -->
    <view wx:if="{{loginOpen}}" class="follow-mini" bindtap="follow" aria-role="button" aria-label="关注这个搜索"><t-icon name="notification" size="26rpx" />关注</view>
  </view>
</view>
<view wx:if="{{!loading && !error && fold.text}}" class="fold-note" bindtap="toggleGuides" aria-role="button">{{fold.text}}<text class="link">{{fold.link}}</text></view>
<!-- 选了"只看未截止"、有结果时也写明口径（10/22 走查：原来只在没有结果时才说），和筛选面板里那句同一口径 -->
<view wx:if="{{!loading && !error && total && picked.open.length}}" class="fold-note">“只看未截止”：{{openNote}}</view>
<!-- 同一份部里通知的各地转发版本合为一条（D-055），份数按合并后的算 -->
<view wx:if="{{!loading && !error && reposts}}" class="fold-note">同一通知的各地转发版本合为一条，另有 {{reposts}} 个转发版本未重复计算</view>

<view class="card">
  <view wx:if="{{loading}}" class="empty muted">正在加载…<view wx:if="{{serviceStarting}}">正在连接，比平时慢一点，请稍等…</view></view>
  <block wx:if="{{!error}}">
  <view wx:for="{{items}}" wx:key="id" class="pick-row" data-id="{{item.id}}" bindtap="togglePick">
    <view wx:if="{{selecting}}" class="pick-box {{chosen[item.id] ? 'pick-box--on' : ''}}" aria-role="checkbox" aria-checked="{{chosen[item.id] ? 'true' : 'false'}}" aria-label="选择这份文件"><t-icon wx:if="{{chosen[item.id]}}" name="check" size="28rpx" color="#FFFFFF" /></view>
    <view class="pick-main"><doc-row doc="{{item}}" q="{{q}}" last="{{index === items.length - 1}}" today="{{today}}" selecting="{{selecting}}" /></view>
  </view>
  </block>
  <view wx:if="{{error}}" class="empty">{{error}}<text class="link" bindtap="retry">　重试</text></view>
  <view wx:elif="{{!items.length && !loading && uncovered}}" class="empty">{{uncovered}}还没收录，暂时查不到这个地区的文件。<text wx:if="{{loginOpen}}">想要这个地区，可以在"我的 → 申请覆盖"告诉我们</text></view>
  <view wx:elif="{{!items.length && !loading}}" class="empty">
    <view class="empty-title">没有符合条件的文件</view>
    <!-- 出路放在最前面：选了"只看未截止"时先去掉它（它不含没写明截止日期、或截止日期还没理清的通知）；别的时间段有结果时直接去看 -->
    <view wx:if="{{aiOnly}}" class="exits"><ai-only variant="exit" bind:remove="removeAi" /></view>
    <view wx:if="{{picked.open.length || (totalAll > 0 && chipTime !== '不限')}}" class="exits">
      <view wx:if="{{picked.open.length}}" class="exit-btn exit-btn--main" bindtap="removeOpen" aria-role="button">去掉“只看未截止”</view>
      <view wx:if="{{picked.open.length}}" class="empty-note exit-note">“只看未截止”只含能看到截止日期、还没截止的通知，加上可能 7 天内截止、日期还没核对的</view>
      <view wx:if="{{totalAll > 0 && chipTime !== '不限'}}" class="exit-btn exit-btn--main" bindtap="allTime" aria-role="button">查看不限发布时间的 {{totalAll}} 份</view>
    </view>
    <view wx:if="{{emptyHint}}" class="empty-note">{{emptyHint}}</view>
    <!-- 列出已选条件，每个可以单独去掉；没有已选条件时提示换关键词 -->
    <block wx:if="{{activeChips.length}}">
      <view class="empty-conds">
        <view wx:for="{{activeChips}}" wx:key="key" class="empty-cond">
          <text class="empty-cond-label">{{item.label}}</text>
          <text class="link empty-cond-off" data-group="{{item.group}}" data-option="{{item.option}}" bindtap="removePicked" aria-role="button" aria-label="去掉条件：{{item.label}}">去掉</text>
        </view>
      </view>
      <view class="empty-clear" bindtap="resetFilter" aria-role="button">清空条件</view>
    </block>
    <view wx:else class="empty-note">换个关键词或放宽筛选试试</view>
    <view wx:if="{{notCoveredNote}}" class="empty-note">暂未收录的地区：{{notCoveredNote}}</view>
  </view>
  <view wx:elif="{{items.length < total}}" class="load-more" bindtap="loadMore">已显示 {{items.length}}/{{total}} 份 · <text class="link">{{loading ? '加载中…' : '加载更多'}}</text></view>
  <view wx:elif="{{items.length}}" class="load-more">共 {{items.length}} 份，已全部显示</view>
</view>
<view wx:if="{{loginOpen}}" class="feedback" bindtap="feedback">没找到想要的？<text class="link">告诉我们</text></view>
<view style="height: {{selecting ? '200rpx' : '80rpx'}}"></view>

<view wx:if="{{selecting}}" class="pick-bar">
  <text class="pick-count">已选 {{chosenCount}} 份</text>
  <text class="link pick-all" bindtap="pickAll">全选已加载</text>
  <view class="btn-primary pick-go {{chosenCount ? '' : 'pick-go--off'}}" bindtap="exportChosen"><t-icon name="download" size="32rpx" color="#FFFFFF" />导出</view>
</view>

<!-- 原生省市区选择器在独立层渲染，筛选弹层和遮罩都必须在它下方。 -->
<t-popup visible="{{filterOpen}}" placement="bottom" z-index="{{900}}" overlay-props="{{ { zIndex: 899 } }}" bind:visible-change="onFilterVisible">
  <view class="sheet">
    <view class="sheet-head">
      <text class="sheet-title">筛选</text>
      <view class="sheet-close" bindtap="closeFilter" aria-role="button" aria-label="关闭"><t-icon name="close" size="40rpx" color="#1D2129" /></view>
    </view>
    <view class="sheet-main">
      <!-- 左栏：组名，旁边是这一组已选几项 -->
      <scroll-view class="side" scroll-y enhanced show-scrollbar="{{false}}" aria-role="tablist">
        <view wx:for="{{groups}}" wx:for-item="g" wx:key="key" class="side-item {{activeGroup === g.key ? 'side-item--on' : ''}}" data-key="{{g.key}}" bindtap="pickGroup"
              aria-role="tab" aria-selected="{{activeGroup === g.key}}" aria-label="{{g.title}}{{counts[g.key] ? '，已选 ' + counts[g.key] + ' 项' : ''}}">
          <text>{{g.title}}</text><text wx:if="{{counts[g.key]}}" class="side-count">{{counts[g.key]}}</text>
        </view>
      </scroll-view>
      <!-- 右栏：当前组的选项。每组一个滚动区，换组时从顶上开始看 -->
      <block wx:for="{{groups}}" wx:for-item="g" wx:key="key">
        <scroll-view wx:if="{{activeGroup === g.key}}" class="pane" scroll-y enhanced show-scrollbar="{{false}}">
          <view class="pane-inner">
            <view class="group-title">{{g.title}}<text class="group-hint">{{g.hint}}</text></view>
            <!-- 省市区三级（mode="region" 默认三级），每列顶部的“全部”：城市一栏选它是全省，区县一栏选它只查这个市的市级来源。
                 10/22 走查：原来挤在一段里，拆成短句放在选择器上面（先看规则再选）；"点一下移除"放到已选的城市、区县下面 -->
            <block wx:if="{{g.key === 'city'}}">
              <view class="group-note">城市一栏选“全部”：查全省（只查全省，也可以直接在“地区”里选省份）。</view>
              <view class="group-note">区县一栏选“全部”：只查这个市已收录的市级来源，不含区县；要查区县，请选具体区县。</view>
              <view class="group-note">直辖市例外：区县一栏选“全部”时，按省级范围查询。</view>
              <picker mode="region" custom-item="全部" value="{{cityRegion}}" bindchange="chooseCity"><view class="option">选择省、市或区县</view></picker>
              <view class="group-note">{{cityCoverageNote}}<text class="link" bindtap="loadCities">　刷新收录范围</text></view>
              <view wx:if="{{cityError}}" class="group-note">{{cityError}}</view>
              <view class="group-note">选择器打不开时，请升级微信。</view>
            </block>
            <view wx:if="{{g.tagged}}" class="tag-note">{{tagNote}}</view>
            <view class="options">
              <view wx:for="{{g.options}}" wx:for-item="o" wx:key="*this" class="option {{pickedMap[g.key + ':' + o] ? 'option--on' : ''}}"
                    data-group="{{g.key}}" data-option="{{o}}" bindtap="pickOption">{{o}}</view>
            </view>
            <view wx:if="{{g.key === 'city' && districtOptions.length}}" class="options">
              <view wx:for="{{districtOptions}}" wx:key="key" class="option option--on" data-group="district" data-option="{{item.key}}" bindtap="removePicked"
                    aria-role="button" aria-label="移除区县：{{item.label}}">{{item.label}}</view>
            </view>
            <view wx:if="{{g.key === 'city' && (g.options.length || districtOptions.length)}}" class="group-note">已选的城市、区县，点一下移除。</view>
            <view wx:if="{{g.note}}" class="group-note">{{g.note}}</view>
            <view wx:if="{{g.extra}}" class="group-note">{{g.extra}}</view>
          </view>
        </scroll-view>
      </block>
    </view>
    <view class="sheet-foot">
      <view class="btn-reset" bindtap="resetFilter">重置</view>
      <view class="btn-primary btn-apply" bindtap="closeFilter">查看 {{total}} 份结果</view>
    </view>
  </view>
</t-popup>
