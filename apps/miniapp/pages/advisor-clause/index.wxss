@import "../advisor-interpret/index.wxss";
.task-section-title { margin: 32rpx 32rpx 16rpx; font-size: 34rpx; font-weight: 600; }
.clause-control { display: block; box-sizing: border-box; margin-top: 16rpx; padding: 24rpx; width: 100%; min-height: 88rpx; height: auto; background: var(--fill); border-radius: 12rpx; font-size: 30rpx; line-height: 1.8; }
