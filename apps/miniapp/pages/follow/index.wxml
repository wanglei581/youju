<notice-bar />
<feature-closed wx:if="{{!loginOpen}}" />
<block wx:else>
<view wx:if="{{loading}}" class="card muted loading-card">正在加载…<view wx:if="{{serviceStarting}}">正在连接，比平时慢一点，请稍等…</view></view>
<view wx:if="{{mode === 'demo' && !loading}}" class="local">演示数据：连上接口并登录后，这里显示你自己的关注</view>

<view wx:if="{{mode === 'gated'}}" class="card gate">
  <view class="gate-title">关注条件，有新文件时标出来</view>
  <view class="muted gate-text">在搜索结果页点"关注这个搜索"，把地区、主题、类型等条件存下来；有新文件时在这里标出<text wx:if="{{remindOpen}}">，也可以订阅微信提醒</text>。</view>
  <view class="btn-primary gate-btn" bindtap="enable">登录后使用</view>
</view>

<block wx:else>
  <view wx:if="{{!loading && !error}}" class="hero">
    <view wx:if="{{mode === 'demo'}}" class="hero-sub">本周（{{weekStart}}起）你关注的条件有</view>
    <!-- 有关注暂不可查询时只写可查询那部分的数，没有这个数就不写数字，不显示成 0 -->
    <view wx:elif="{{partialNote}}" class="hero-sub">{{partialNote}}{{newTotal === null ? '' : '；上次查看之后，其余关注有'}}</view>
    <view wx:else class="hero-sub">上次查看之后，你关注的条件有</view>
    <view wx:if="{{newTotal !== null}}" class="hero-row">
      <view><text class="hero-num">{{newTotal}}</text><text class="hero-unit"> 份新文件</text></view>
    </view>
  </view>

  <view wx:if="{{error}}" class="card load-error"><text>{{error}}</text><text class="link retry" bindtap="load">重试</text></view>

  <view class="card">
    <view class="section-title">我的关注 {{loading || error ? '' : follows.length}}<text wx:if="{{follows.length}}" class="link manage" bindtap="toggleManage">{{managing ? '完成' : '管理'}}</text></view>
    <view wx:if="{{!error}}" wx:for="{{follows}}" wx:key="id" class="sub" data-id="{{item.id}}" data-name="{{item.name}}" bindtap="openFollow">
      <view class="sub-icon sub-icon--{{item.tone}}"><t-icon name="{{item.icon}}" size="40rpx" color="#FFFFFF" /></view>
      <view class="sub-main">
        <view class="sub-name">{{item.name}}</view>
        <view class="sub-desc">{{item.desc}}</view>
        <!-- 暂不可查询：条件原样保留，点卡片或下面的链接回搜索修改；不写"没有新文件" -->
        <view wx:if="{{item.unavailable}}" class="sub-left">{{item.queryMessage}}</view>
        <text wx:if="{{mode === 'live'}}" class="link" data-id="{{item.id}}" catchtap="searchFollow">{{item.unavailable ? '回搜索修改条件' : '按此条件搜索'}}</text>
        <view wx:if="{{mode === 'live' && remindOpen && remindLeft}}" class="sub-left {{remindLeft[item.id] ? 'sub-left--on' : ''}}">{{remindLeft[item.id] ? '微信提醒还剩 ' + remindLeft[item.id] + ' 次' : '未订阅微信提醒，点"提醒"订阅'}}</view>
      </view>
      <text wx:if="{{managing}}" class="sub-del" data-id="{{item.id}}" data-name="{{item.name}}" catchtap="remove" aria-role="button">删除</text>
      <block wx:else>
        <text wx:if="{{item.newCount}}" class="sub-n">新 {{item.newCount}}</text>
        <!-- 订阅消息模板申请下来之前不显示（utils/subscribe.js 的 remindOpen） -->
        <text wx:if="{{remindOpen}}" class="sub-remind" data-id="{{item.id}}" catchtap="remind" aria-role="button">提醒</text>
      </block>
    </view>
    <view wx:if="{{mode === 'live' && !follows.length && !loading && !error}}" class="empty muted">还没有关注。在搜索结果页点"关注这个搜索"就能加上。</view>
    <view class="add" bindtap="addSub"><t-icon name="add" size="32rpx" color="#2A5CE0" />去搜索，按 地区 × 主题 × 类型 关注</view>
  </view>

  <view wx:if="{{changesError}}" class="card load-error"><text>{{changesError}}</text><text class="link retry" bindtap="load">重试</text></view>
  <view wx:if="{{changes.length}}" class="card">
    <view class="section-title">新文件</view>
    <doc-row wx:for="{{changes}}" wx:key="id" doc="{{item}}" label="{{item.label}}" last="{{index === changes.length - 1}}" today="{{today}}" />
  </view>

  <view wx:if="{{remindOpen}}" class="card remind">
    <view class="remind-main">
      <view class="remind-title">微信提醒</view>
      <view class="muted remind-text">按次订阅：在关注旁点"提醒"，这个关注有新文件时用微信提醒你一次；想继续收到，提醒后再点一次。</view>
    </view>
  </view>
</block>
</block>
<view class="tab-page-bottom"></view>
