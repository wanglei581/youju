.local { margin: 16rpx 24rpx 0; padding: 16rpx 24rpx; background: var(--brand-tint); border-radius: 16rpx; font-size: 24rpx; color: var(--t2); }
.hero { margin: 20rpx 24rpx 0; padding: 32rpx 40rpx; border-radius: 24rpx; background: linear-gradient(135deg, var(--brand-g1), var(--brand-g2)); color: #FFFFFF; }
.hero-sub { font-size: 26rpx; opacity: 0.9; }
.hero-row { margin-top: 8rpx; display: flex; align-items: center; justify-content: space-between; }
.hero-num { font-size: 72rpx; font-weight: 700; }
.hero-unit { font-size: 30rpx; }
.hero-btn { height: 64rpx; padding: 0 28rpx; display: flex; align-items: center; border-radius: 32rpx; background: rgba(255, 255, 255, 0.2); font-size: 28rpx; }
.manage { font-size: 28rpx; font-weight: 400; }
.sub { display: flex; align-items: center; gap: 24rpx; padding: 24rpx 0; border-bottom: 2rpx solid var(--line); }
.sub-icon { width: 76rpx; height: 76rpx; flex-shrink: 0; border-radius: 22rpx; display: flex; align-items: center; justify-content: center; }
.sub-icon--orange { background: linear-gradient(145deg, #FFAB5C, var(--orange)); }
.sub-icon--blue { background: linear-gradient(145deg, #5B8CFF, var(--brand)); }
.sub-main { flex: 1; min-width: 0; }
.sub-name { font-size: 30rpx; font-weight: 600; }
.sub-desc { margin-top: 2rpx; font-size: 24rpx; color: var(--t2); }
.sub-n { height: 44rpx; padding: 0 16rpx; display: flex; align-items: center; border-radius: 22rpx; background: var(--brand-tint); color: var(--brand); font-size: 24rpx; font-weight: 600; }
.add { margin: 24rpx 0 28rpx; height: 80rpx; display: flex; align-items: center; justify-content: center; gap: 8rpx; border: 2rpx dashed var(--brand); border-radius: 40rpx; color: var(--brand); font-size: 28rpx; }
.load-more { height: 96rpx; display: flex; align-items: center; justify-content: center; gap: 12rpx; border-top: 2rpx solid var(--line); font-size: 26rpx; color: var(--t3); }
.remind { padding: 28rpx 32rpx; display: flex; align-items: center; gap: 24rpx; }
.remind-main { flex: 1; min-width: 0; }
.remind-title { font-size: 30rpx; font-weight: 600; }
.remind-text { margin-top: 6rpx; font-size: 24rpx; line-height: 1.5; }
.remind-btn { flex-shrink: 0; height: 72rpx; padding: 0 32rpx; display: flex; align-items: center; border-radius: 36rpx; background: var(--brand); color: #FFFFFF; font-size: 28rpx; font-weight: 500; white-space: nowrap; }
.remind-btn--on { background: var(--fill); color: var(--t2); }
.gate { padding-top: 36rpx; padding-bottom: 36rpx; }
.gate-title { font-size: 32rpx; font-weight: 600; }
.gate-text { margin-top: 12rpx; font-size: 26rpx; line-height: 1.7; }
.gate-btn { margin-top: 28rpx; }
.sub-remind { flex-shrink: 0; height: 52rpx; padding: 0 20rpx; display: flex; align-items: center; border-radius: 26rpx; border: 2rpx solid var(--brand); color: var(--brand); font-size: 24rpx; }
.sub-del { flex-shrink: 0; color: var(--red); font-size: 26rpx; padding: 8rpx 0 8rpx 16rpx; }
.empty { padding: 32rpx 0 8rpx; font-size: 26rpx; }
