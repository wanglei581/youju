.top {
  padding-left: 32rpx;
  padding-right: 32rpx;
  padding-bottom: 60rpx;
  background: linear-gradient(180deg, var(--brand-g1) 0%, var(--brand-g2) 100%);
  color: #FFFFFF;
}
.brand-row { display: flex; align-items: center; gap: 20rpx; box-sizing: border-box; }
.brand { font-size: 40rpx; font-weight: 700; letter-spacing: 2rpx; }
.badge { font-size: 23rpx; color: rgba(255, 255, 255, 0.88); padding: 2rpx 12rpx; border: 2rpx solid rgba(255, 255, 255, 0.4); border-radius: 8rpx; }
.scopes { min-height: 72rpx; display: flex; gap: 44rpx; font-size: 30rpx; }
.scope { display: flex; flex-direction: column; justify-content: center; align-items: center; gap: 8rpx; color: rgba(255, 255, 255, 0.8); }
.scope--on { color: #FFFFFF; font-weight: 700; }
.scope-bar { width: 36rpx; height: 6rpx; border-radius: 4rpx; background: #FFFFFF; }
.search { margin-top: 12rpx; height: 88rpx; display: flex; align-items: center; gap: 16rpx; padding: 0 8rpx 0 28rpx; background: #FFFFFF; border-radius: 44rpx; box-shadow: 0 8rpx 28rpx rgba(20, 45, 120, 0.18); }
.search-ph { flex: 1; min-width: 0; color: var(--t3); font-size: 28rpx; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.search-btn { height: 72rpx; padding: 0 36rpx; display: flex; align-items: center; background: var(--brand); color: #FFFFFF; border-radius: 36rpx; font-size: 28rpx; font-weight: 500; }
.hot { margin-top: 20rpx; display: flex; flex-wrap: wrap; gap: 12rpx 28rpx; font-size: 24rpx; }
.hot-label { color: rgba(255, 255, 255, 0.68); }
.hot-word { color: rgba(255, 255, 255, 0.95); }

.entries { position: relative; margin: -28rpx 24rpx 0; padding: 28rpx 8rpx 24rpx; background: var(--card); border-radius: 24rpx; box-shadow: 0 4rpx 20rpx rgba(29, 33, 41, 0.05); display: grid; grid-template-columns: repeat(6, 1fr); }
.entry { display: flex; flex-direction: column; align-items: center; gap: 12rpx; font-size: 25rpx; color: var(--t1); }
.tile { width: 84rpx; height: 84rpx; border-radius: 26rpx; display: flex; align-items: center; justify-content: center; }
.tile--blue { background: linear-gradient(145deg, #5B8CFF, var(--brand)); }
.tile--orange { background: linear-gradient(145deg, #FFAB5C, var(--orange)); }
.tile--green { background: linear-gradient(145deg, #3FD0A6, var(--green)); }
.tile--plain { background: var(--fill); }

.summary { margin: 20rpx 24rpx 0; min-height: 116rpx; padding: 16rpx 32rpx; box-sizing: border-box; display: flex; align-items: center; gap: 24rpx; background: var(--card); border-radius: 24rpx; }
.summary-num { flex-shrink: 0; }
.summary-label { display: block; font-size: 24rpx; color: var(--t2); line-height: 1.3; }
.big { font-size: 40rpx; font-weight: 700; line-height: 1.25; color: var(--brand); }
.unit { font-size: 24rpx; font-weight: 500; color: var(--t2); }
.vline { width: 2rpx; height: 56rpx; background: var(--line); }
.summary-text { flex: 1; min-width: 0; font-size: 24rpx; line-height: 1.6; color: var(--t2); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.b { color: var(--t1); font-weight: 700; }

.mine { margin: 20rpx 24rpx 0; min-height: 96rpx; padding: 12rpx 28rpx; box-sizing: border-box; display: flex; align-items: center; gap: 20rpx; background: var(--brand-tint); border-radius: 24rpx; }
.mine-text { flex: 1; font-size: 28rpx; }
.mine-n { color: var(--brand); font-weight: 700; }
.mine .link { font-size: 26rpx; }

.tabs { min-height: 92rpx; display: flex; gap: 40rpx; border-bottom: 2rpx solid var(--line); }
.tab { display: flex; flex-direction: column; justify-content: flex-end; align-items: center; gap: 18rpx; font-size: 30rpx; color: var(--t2); }
.tab--on { color: var(--t1); font-weight: 600; }
.tab-bar { width: 32rpx; height: 6rpx; border-radius: 4rpx; background: var(--brand); }
.tab:not(.tab--on) { padding-bottom: 24rpx; }
.more { min-height: 96rpx; display: flex; align-items: center; justify-content: center; gap: 8rpx; color: var(--brand); font-size: 28rpx; }

.footer { margin: 28rpx 24rpx 0; padding: 24rpx 28rpx; display: flex; gap: 20rpx; background: var(--card); border-radius: 24rpx; }
.footer-text { font-size: 24rpx; line-height: 1.5; color: var(--t2); }
.footer-link { margin-top: 12rpx; }
.list-tip { padding: 48rpx 0; text-align: center; font-size: 26rpx; color: var(--t2); }
