<!-- 首页（D-061）：品牌蓝顶部（字标、第三方整理角标、搜索范围、搜索框、热词）→ 3 个入口 →（有活动时）申报季加量 →（没关掉时）三步上手 → 本周新增 → 7 天内截止 → 最新申报通知 -->
<view class="top" style="padding-top: {{statusBarHeight}}px">
  <view class="brand-row" style="height: {{navHeight}}px; padding-right: {{menuWidth}}px">
    <text class="brand">有据</text>
    <text class="badge">第三方整理 · 非政府平台</text>
  </view>
  <view class="scopes" aria-role="tablist" aria-label="搜索范围">
    <view wx:for="{{scopes}}" wx:key="key" class="scope {{scope === index ? 'scope--on' : ''}}" data-index="{{index}}" bindtap="pickScope" aria-role="tab" aria-selected="{{scope === index}}">
      <text>{{item.label}}</text>
      <view class="scope-bar" wx:if="{{scope === index}}"></view>
    </view>
  </view>
  <view class="search" bindtap="goSearch" aria-role="button" aria-label="搜索">
    <t-icon name="search" size="36rpx" color="#86909C" />
    <text class="search-ph">{{scopes[scope].placeholder}}</text>
    <view class="search-btn">搜索</view>
  </view>
  <view class="hot">
    <text class="hot-label">大家在查</text>
    <text wx:for="{{hot}}" wx:key="*this" class="hot-word" data-q="{{item}}" bindtap="goSearch">{{item}}</text>
  </view>
</view>

<view class="entries {{tools ? 'entries--tools' : ''}}">
  <view class="entry" data-url="/pages/report/index" bindtap="goEntry">
    <view class="tile tile--green"><t-icon name="hourglass" size="44rpx" color="#FFFFFF" /></view>
    <text class="entry-name">截止</text><text class="entry-sub">7 / 14 / 30 天</text>
  </view>
  <view class="entry" data-url="/pages/clients/index" bindtap="goEntry">
    <view class="tile tile--blue"><t-icon name="user" size="44rpx" color="#FFFFFF" /></view>
    <text class="entry-name">我的客户</text><text class="entry-sub">按客户看通知</text>
  </view>
  <view class="entry" data-url="/pages/lists/index" bindtap="goEntry">
    <view class="tile tile--orange"><t-icon name="bulletpoint" size="44rpx" color="#FFFFFF" /></view>
    <text class="entry-name">查名单</text><text class="entry-sub">政府公开名单</text>
  </view>
  <view wx:if="{{tools}}" class="entry" data-url="/pages/advisor/index" bindtap="goEntry">
    <view class="tile tile--blue"><t-icon name="app" size="44rpx" color="#FFFFFF" /></view>
    <text class="entry-name">工具中心</text><text class="entry-sub">批量处理</text>
  </view>
</view>

<!-- 申报季加量（D-070 ⑤）：提前一周公布起止日期，文字和工具中心、批量工具页同一句（utils/boost.js 的 seasonLine）。
     没有这项活动、批量工具没开、取不到时不显示；不提购买、不加红点、不弹窗；点了去工具中心 -->
<view wx:if="{{seasonText}}" class="season" data-url="/pages/advisor/index" bindtap="goEntry" aria-role="button" aria-label="批量处理客户名单（机构用）：{{seasonText}}。去工具中心">
  <t-icon name="calendar" size="36rpx" color="#2A5CE0" />
  <view class="season-body">
    <view class="season-title">批量处理客户名单（机构用）</view>
    <view class="season-text">{{seasonText}}</view>
  </view>
  <t-icon name="chevron-right" size="28rpx" color="#2A5CE0" />
</view>

<!-- 新手引导（D-070 ④）"三步上手"：普通卡片，不弹窗、不遮挡下面的内容，没有奖励；点"不再显示"后本机记住、不再出现 -->
<view wx:if="{{guide}}" class="card guide">
  <view class="guide-head">
    <text class="guide-title">三步上手</text>
    <view class="guide-close" bindtap="closeGuide" aria-role="button" aria-label="关闭三步上手，以后不再显示"><text>不再显示</text><t-icon name="close" size="24rpx" /></view>
  </view>
  <view wx:for="{{guideSteps}}" wx:key="key" class="guide-step" hover-class="guide-step--pressed" data-key="{{item.key}}" bindtap="goGuide" aria-role="button" aria-label="第{{index + 1}}步，{{item.name}}：{{item.text}}">
    <text class="guide-no">{{index + 1}}</text>
    <view class="guide-body">
      <view class="guide-name">{{item.name}}</view>
      <view class="guide-text">{{item.text}}</view>
    </view>
    <t-icon name="chevron-right" size="28rpx" color="#B4BAC6" />
  </view>
</view>

<view wx:if="{{error}}" class="card load-error"><text>{{error}}</text><text class="link retry" bindtap="reload">重试</text></view>
<!-- 本周新增：数据到之前用灰色占位块占住位置 -->
<view wx:if="{{!stats && !error}}" class="summary" aria-label="正在加载">
  <view class="summary-num"><view class="sk sk-label"></view><view class="sk sk-big"></view></view>
  <view class="vline"></view>
  <view class="summary-text"><view class="sk sk-text"></view><view class="sk sk-text sk-line--short"></view></view>
</view>
<!-- 本周 0 份时只写"本周暂无新文件"和最近一次成功检查的时间，不推测原因 -->
<view wx:if="{{loading && serviceStarting && !fresh}}" class="muted startup-note">正在连接，比平时慢一点，请稍等…</view>
<!-- 显示的是本机存的上次数据时写明（10/12）：正在更新，或这次没更新成功 -->
<view wx:if="{{cachedText && (loading || error)}}" class="muted cached-note">下面是{{cachedText}}的数据{{loading ? '，正在更新…' : ''}}</view>
<view class="summary" wx:if="{{stats}}" bindtap="goSearch">
  <block wx:if="{{stats.week_total}}">
    <view class="summary-num">
      <text class="summary-label">本周新增</text>
      <view><text class="big">{{stats.week_total}}</text><text class="unit"> 份</text></view>
    </view>
    <view class="vline"></view>
    <view class="summary-text">
      <view>申报 <text class="b">{{stats.apply}}</text> · 名单与公示 <text class="b">{{stats.lists}}</text> · 其他 <text class="b">{{stats.other}}</text></view>
      <view>来自 {{stats.provinces}} 个省和国家部委<text wx:if="{{stats.cities}}">、{{stats.cities}} 个城市</text> · 每条都有出处</view>
      <!-- 同一份部里通知的各地转发版本按 1 份计（D-055） -->
      <view wx:if="{{stats.week_reposts}}" class="summary-reposts">另有 {{stats.week_reposts}} 个转发版本，未重复计算</view>
    </view>
  </block>
  <view wx:else class="summary-text">
    <view class="summary-zero">本周暂无新文件<text wx:if="{{checkedText}}"> · 最近检查 {{checkedText}}</text></view>
    <view>来自 {{stats.provinces}} 个省和国家部委<text wx:if="{{stats.cities}}">、{{stats.cities}} 个城市</text> · 每条都有出处</view>
  </view>
  <t-icon name="chevron-right" size="32rpx" color="#86909C" />
</view>

<view class="mine" wx:if="{{loginOpen && stats && stats.followed_new}}" bindtap="goFollow">
  <t-icon name="notification" size="36rpx" color="#2A5CE0" />
  <text class="mine-text">你关注的条件本周有 <text class="mine-n">{{stats.followed_new}}</text> 份新文件</text>
  <text class="link">去看看</text>
  <t-icon name="chevron-right" size="28rpx" color="#2A5CE0" />
</view>
<!-- 部分关注暂不可查询（如城市来源停用）：followed_new 为 null，只写可查询那部分的本周新增，不当作 0 -->
<view class="mine" wx:elif="{{loginOpen && stats && stats.followed_unavailable}}" bindtap="goFollow">
  <t-icon name="notification" size="36rpx" color="#2A5CE0" />
  <view class="mine-text">
    <view>部分关注暂不可查询<text wx:if="{{stats.followed_available_new}}">；其余关注本周有 <text class="mine-n">{{stats.followed_available_new}}</text> 份新文件</text></view>
    <view wx:if="{{stats.followed_message}}" class="muted">{{stats.followed_message}}</view>
  </view>
  <text class="link">去看看</text>
  <t-icon name="chevron-right" size="28rpx" color="#2A5CE0" />
</view>

<!-- 7 天内截止：日期只放人工核对过的，最多 5 条（D-061）；还没核对的只写份数、不写日期。
     一份都没核对时也显示这一块，免得顾问以为这周没有要截止的（10/13 Grok、Codex 审查）；两样都没有才不显示 -->
<view wx:if="{{soon.length || soonUnverified}}" class="card soon">
  <view class="card-head" data-url="/pages/report/index" bindtap="goEntry">
    <text class="card-title">7 天内截止</text><text class="link card-more">全部 <t-icon name="chevron-right" size="26rpx" /></text>
  </view>
  <view wx:if="{{reviewNote}}" class="soon-stale">{{reviewNote}}</view>
  <view wx:for="{{soon}}" wx:key="id" class="soon-item" data-id="{{item.id}}" bindtap="openDoc">
    <view class="soon-title">{{item.title}}</view>
    <view class="soon-line"><text class="soon-when">{{item.kindText}} {{item.dateText}} {{item.week}}</text><view class="soon-right"><text class="pill pill--{{item.tone}}">{{item.days === 0 ? '今天截止' : '剩 ' + item.days + ' 天'}}</text><ai-button doc-id="{{item.id}}" doc-title="{{item.title}}" ai="{{item.ai}}" /></view></view>
  </view>
  <view wx:if="{{soonUnverified}}" class="soon-foot {{soon.length ? '' : 'soon-foot--only'}}" data-url="/pages/report/index" bindtap="goEntry">{{soon.length ? '另有 ' + soonUnverified + ' 份可能 7 天内截止，日期还没核对 ›' : soonUnverified + ' 份通知可能 7 天内截止，日期还没核对，点开看是哪些 ›'}}</view>
</view>

<view class="card">
  <view class="card-head"><text class="card-title">最新申报通知</text></view>
  <view wx:if="{{!loaded && !error}}" aria-label="正在加载">
    <view wx:for="{{[1, 2, 3]}}" wx:key="*this" class="sk-row">
      <view class="sk-head"><view class="sk sk-tag"></view><view class="sk sk-chip"></view></view>
      <view class="sk sk-line"></view>
      <view class="sk sk-line sk-line--short"></view>
      <view class="sk sk-meta"></view>
    </view>
  </view>
  <doc-row wx:if="{{loaded}}" wx:for="{{items}}" wx:key="id" doc="{{item}}" today="{{today}}" />
  <view wx:if="{{!items.length && loaded && !error}}" class="list-tip">暂时没有新的申报通知</view>
  <view class="more" bindtap="goMore">查看近 7 天的申报通知 <t-icon name="chevron-right" size="28rpx" /></view>
</view>

<view class="footer">
  <t-icon name="secured" size="36rpx" color="#4E5969" />
  <view class="footer-text">
    <!-- 栏目数和省份数到了才写那半句，不出现空着的数字 -->
    <text><text wx:if="{{stats}}">数据来自 {{stats.sources}} 个政府网站栏目，覆盖国家部委和 {{stats.provinces}} 个省<text wx:if="{{stats.cities}}">、{{stats.cities}} 个城市</text>，</text>每条都注明出处。有据不代办申报。</text>
    <view class="link footer-link" bindtap="goCoverage">覆盖说明 ›</view>
  </view>
</view>
<view class="tab-page-bottom"></view>
