@import "../../utils/advisor.wxss";

/* 顶部：和付款页、奖励规则页同一种蓝色渐变 */
.iv-hero { margin: 20rpx 24rpx 0; padding: 36rpx 40rpx 36rpx; border-radius: 24rpx; background: linear-gradient(135deg, var(--brand-g1), var(--brand-g2)); color: #FFFFFF; }
.iv-hero-title { font-size: 40rpx; font-weight: 700; line-height: 1.3; }
.iv-hero-sub { margin-top: 16rpx; font-size: 26rpx; line-height: 1.7; opacity: 0.95; }
.iv-count { margin-top: 28rpx; padding: 16rpx 24rpx; border-radius: 12rpx; background: rgba(255, 255, 255, 0.16); font-size: 26rpx; line-height: 1.5; }

.iv-card { padding-top: 32rpx; padding-bottom: 28rpx; }
.iv-title { font-size: 30rpx; font-weight: 600; color: var(--t1); }
.iv-rule { margin-top: 20rpx; display: flex; align-items: flex-start; gap: 16rpx; }
.iv-dot { flex-shrink: 0; margin-top: 18rpx; width: 10rpx; height: 10rpx; border-radius: 50%; background: var(--brand); }
.iv-rule-text { flex: 1; min-width: 0; font-size: 28rpx; line-height: 1.7; color: var(--t1); }

.iv-space { height: calc(180rpx + env(safe-area-inset-bottom)); }
.iv-bar { position: fixed; left: 0; right: 0; bottom: 0; padding: 16rpx 32rpx calc(24rpx + env(safe-area-inset-bottom)); background: var(--card); box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.06); }
/* 微信的 button 默认是固定宽度，这里要占满一行 */
.iv-share { width: 100% !important; margin: 0; min-height: 96rpx; font-size: 32rpx; line-height: 96rpx; padding: 0; }
.iv-share::after { border: 0; }
