<notice-bar />
<feature-closed wx:if="{{!loginOpen}}" />
<block wx:else>
<view wx:if="{{title}}" class="card about">
  <view class="weak about-label">针对这份文件</view>
  <view class="about-title">{{title}}</view>
</view>
<view class="card box">
  <textarea class="input" value="{{content}}" maxlength="{{max}}" placeholder="{{coverage ? '想增加哪个地区、哪个部门的栏目？写下名称，有网址更好' : pay ? '遇到了什么问题？比如已经付款还没开通、退款没到账、发票没收到' : '哪里不对？比如截止日期、发文机关、名单状态和原文不一致，或者希望增加的地区和栏目'}}" placeholder-class="ph" bindinput="onInput" auto-height aria-label="{{coverage ? '申请覆盖内容' : pay ? '支付和订单问题' : '纠错与建议内容'}}" />
  <view wx:if="{{coverage}}" class="note weak">最多 {{max}} 字，另加“申请覆盖：”5 字</view>
  <view class="count weak">{{count}}/{{max}}</view>
</view>
<view class="note weak">{{coverage ? '我们会评估后接入，只接入政府网站公开发布的栏目。' : pay ? '我们会核对订单后尽快处理；订单号已自动带上。请不要填写银行卡号、密码。' : '我们会对照原文核对后修正。'}}处理结果会写在“我的 → 我的数据”里。请不要填写姓名、电话等个人信息；提交的内容会经过微信内容安全检查。</view>
<view wx:if="{{reward && !coverage && !pay}}" class="note weak">{{reward}}</view>
<view class="btn-primary submit {{sending ? 'submit--off' : ''}}" bindtap="submit" aria-role="button">{{sending ? '正在提交…' : '提交'}}</view>
</block>
