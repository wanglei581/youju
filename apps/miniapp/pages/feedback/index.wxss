.about { padding-top: 24rpx; padding-bottom: 24rpx; }
.about-label { font-size: 24rpx; }
.about-title { margin-top: 8rpx; font-size: 28rpx; line-height: 1.6; color: var(--t1); }
.box { padding-top: 24rpx; padding-bottom: 16rpx; }
.input { width: 100%; min-height: 280rpx; font-size: 28rpx; line-height: 1.7; color: var(--t1); }
