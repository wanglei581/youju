<notice-bar />
<view wx:if="{{loading}}" class="card advisor-card muted">正在读取工具与额度…</view>
<view wx:elif="{{error}}" class="card advisor-card"><view>{{error}}</view><button wx:if="{{gate === 'consent'}}" class="advisor-button btn-primary" bindtap="consent">阅读并同意</button><button wx:else class="advisor-button" bindtap="load">重试</button></view>
<view wx:elif="{{accepted}}" class="card advisor-card"><view class="advisor-title">已提交</view><view class="advisor-text">可以离开页面，稍后到“我的记录”查看结果。</view><button class="advisor-button btn-primary" bindtap="tasks">查看任务</button></view>
<block wx:elif="{{enabled}}">
  <view class="card advisor-card">
    <view class="advisor-title">{{title}}</view>
    <view class="advisor-text muted">{{statusLine}}</view>
    <view wx:if="{{countRule}}" class="advisor-text muted">{{countRule}}</view>
    <view wx:if="{{trialEnded}}" class="advisor-text muted">{{trialEnded}}</view>
    <view wx:if="{{seasonLine}}" class="advisor-text">{{seasonLine}}</view>
    <!-- 体验中当天次数用完：和免费次数用完一样在上面说清楚，不只写"还能提交 0 次" -->
    <view wx:if="{{trialActive && !passActive && !trialLeft}}" class="advisor-error">{{trialCap}}</view>
    <view wx:if="{{!passActive && !trialActive && !remaining}}" class="advisor-error">本月免费次数已用完，下月{{offer ? ' 1 日恢复' : '可继续使用。不需要购买'}}。{{trialAvailable ? '也可以先开始 3 天加量体验（见下方）。' : ''}}若上次提交状态未确认，可预览同一内容后重试。</view>
    <!-- 加量体验（D-070 ③）：有资格就一直有入口；本月免费次数用完、或这次超过 50 家时放显眼（推荐）。不提购买 -->
    <view wx:if="{{trialAvailable}}" class="advisor-trial {{!remaining || rowCount > maxRows ? 'advisor-trial-strong' : ''}}">
      <view class="advisor-text">{{trialPitch}}</view>
      <button class="advisor-button {{!remaining || rowCount > maxRows ? 'btn-primary' : ''}}" bindtap="openTrial">了解加量体验</button>
    </view>
    <!-- 只在超出免费量、且服务端在售时出现；查信息的过程中不出现付费提示（D-058 第六节） -->
    <view wx:if="{{offer && !passActive && !trialActive && (!remaining || rowCount > maxRows)}}" class="advisor-offer">
      <view class="advisor-text">批量工具：{{offer.line}}，不限次数，每次 500 家以内。一次付清，到期不再扣钱。</view>
      <button class="advisor-button" bindtap="buyPass">了解批量工具</button>
    </view>
    <!-- 使用期 3 天内到期（在售时）：续买的规则只在这里和"我的 → 批量工具"出现，不发消息催买（D-070 ⑥） -->
    <view wx:if="{{offer && passActive && passNotice}}" class="advisor-offer">
      <view class="advisor-text">{{passNotice}}</view>
      <view wx:if="{{offer.renew}}" class="advisor-text">{{offer.renew.text}}</view>
      <button class="advisor-button" bindtap="buyPass">续买批量工具</button>
    </view>
    <!-- 10/22 走查：通知表不是按企业名称对通知，常显一句说清按什么列 -->
    <view wx:if="{{kind === 'track'}}" class="advisor-text">按每行的省份和填了的条件，列出近 90 天发布、还没核对为已截止的申报通知；关键词不填就不限主题；客户名称只用来标出是哪家。</view>
    <view class="advisor-actions"><button class="advisor-button {{mode === 'paste' ? 'selected' : ''}}" data-mode="paste" bindtap="mode" disabled="{{previewing || submitting}}">粘贴文本</button><button class="advisor-button {{mode === 'file' ? 'selected' : ''}}" data-mode="file" bindtap="mode" disabled="{{previewing || submitting}}">选择文件</button></view>
    <block wx:if="{{mode === 'paste'}}">
      <view class="advisor-text">{{kind === 'compare' ? '一行一家，填写企业名称或统一社会信用代码' : '一行一家：客户名称,省份,关键词,支持方式,城市,区县；后四项可留空；关键词、支持方式多项用分号分隔，城市只填一个，区县也只填一个，写在第 6 列；旧四列、五列格式仍有效'}}</view>
      <!-- 固定高度、框内滚动：加量体验一次可贴 500 家，自动增高会把预览、提交按钮推到几千像素以下 -->
      <textarea class="advisor-input advisor-paste" value="{{text}}" maxlength="30000" placeholder="{{kind === 'compare' ? '示例科技有限公司' : '示例科技有限公司,山东,高新技术,资金支持,青岛,市南区'}}" bindinput="input" disabled="{{previewing || submitting}}" />
    </block>
    <block wx:else>
      <view class="advisor-text">只支持 XLSX / CSV（旧版 .xls 请先另存为 .xlsx），文件不超过 60 KB。{{kind === 'compare' ? '使用企业名称或统一社会信用代码表头，无表头时读取第一列。' : '表头须有客户名称、省份；可选关键词、支持方式、城市、区县（第 6 列，表头写“区县”）。'}}其他列（如联系人、电话）不使用、不保存，建议上传前删掉。</view>
      <!-- 10/18 验收：第一次用的人不知道表格要先放进微信聊天才能选 -->
      <view class="advisor-text muted">电脑或手机里的表格，请先发到微信聊天里（例如发给“文件传输助手”），再点“从聊天中选文件”。</view>
      <button class="advisor-button" bindtap="choose" disabled="{{previewing || submitting}}">{{fileName ? '重新选择文件' : '从聊天中选文件'}}</button>
      <view class="advisor-text muted">{{fileName || '还没有选择文件'}}</view>
    </block>
    <view wx:if="{{kind === 'track'}}" class="advisor-text link" bindtap="toggleFillHelp" aria-role="button">{{showFillHelp ? '收起填写说明' : '省、市、区县怎么填'}}</view>
    <view wx:if="{{kind === 'track' && showFillHelp}}" class="advisor-text muted">省市支持全称或简称（如山东省、青岛市），区县写完整名称（如市南区）；城市、区县须已收录，不填城市按全省、不填区县按全市；直辖市不填区县时按省级，填区县时城市写本市（如北京,北京,朝阳区）；国家部委不填城市和区县。填写城市后包含国家部委、本省省级和该市通知，填写区县后的范围见结果中的查询说明。城市、区县未收录或省市区不匹配会在结果中注明未查询，不改为全市或全省，不代表没有相关通知。</view>
    <view class="advisor-text">输入 {{rowCount}} 行{{previewed ? '，服务器预览通过' : ''}}</view>
    <view class="advisor-text muted">预览会把内容发到服务器临时解析行数，不保存，也不创建任务、不占次数。请先确认有权提交；不要填写个人姓名、身份证号、手机号或银行账号。</view>
    <view wx:if="{{inputError}}" class="advisor-error">{{inputError}}</view>
    <!-- 提示里推荐了加量体验（超过 50 家、本月免费次数用完）：按钮紧跟在提示下面，不用翻回页面上方找；别的提示下面不出现 -->
    <button wx:if="{{inputError && inputError === trialHint && trialAvailable && !passActive}}" class="advisor-button" bindtap="openTrial">了解加量体验</button>
    <button class="advisor-button" bindtap="preview" loading="{{previewing}}" disabled="{{previewing || submitting}}">预览并核对行数</button>
  </view>
  <view class="card advisor-card">
    <view class="advisor-text">{{agreed ? '已单独同意《工具使用说明》' : '提交前请单独阅读并同意《工具使用说明》'}}</view>
    <button class="advisor-button" bindtap="terms">阅读工具使用说明</button>
    <view wx:if="{{!passActive}}" class="advisor-text muted">每提交一次算 1 次，不论几家；排队中取消、或处理失败没出结果的，不算次数。</view>
    <view class="advisor-text muted">原文件不保存；任务里的名单 7 天后清空，结果文件（含提交的名单内容）30 天后删除。在“我的记录”里可取消排队中的、删除记录及结果。</view>
    <!-- 10/22 走查：没预览时提交按钮是灰的，紧挨着写明为什么、先做什么 -->
    <view wx:if="{{!previewed && !previewing}}" class="advisor-text">填好名单后，先点上面的“预览并核对行数”，通过后才能提交</view>
    <button class="advisor-button btn-primary" bindtap="submit" loading="{{submitting}}" disabled="{{previewing || submitting || !previewed}}">提交任务</button>
    <button class="advisor-button" bindtap="tasks" disabled="{{submitting}}">查看已有任务</button>
  </view>
</block>
