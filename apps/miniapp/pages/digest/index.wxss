/* 不用 .head：列表行组件 doc-row 共享页面样式（apply-shared），它自己也有 .head */
.digest-head { padding: 28rpx 32rpx; }
.digest-week { font-size: 34rpx; font-weight: 600; display: flex; align-items: center; gap: 12rpx; }
.demo { padding: 0 12rpx; line-height: 36rpx; border-radius: 8rpx; background: var(--fill); color: var(--t2); font-size: 22rpx; font-weight: 400; }
.digest-sum { margin-top: 10rpx; font-size: 26rpx; color: var(--t2); line-height: 1.6; }
.digest-note { margin-top: 8rpx; font-size: 24rpx; line-height: 1.6; }
.filters { margin: 18rpx 24rpx 0; display: flex; }
.filters picker { flex: 1; min-width: 0; }
.filter { padding: 20rpx 18rpx; display: flex; align-items: center; justify-content: space-between; background: var(--card); border-radius: 16rpx; color: var(--t1); font-size: 26rpx; line-height: 1.5; }
.list { margin-top: 18rpx; padding: 0 28rpx; }
.group-head { padding: 28rpx 0 4rpx; display: flex; align-items: baseline; justify-content: space-between; }
.group-name { font-size: 32rpx; font-weight: 600; }
.section-label { margin-top: 16rpx; padding-top: 12rpx; font-size: 24rpx; color: var(--t3); }
.more-btn { margin: 20rpx 24rpx 0; min-height: 80rpx; display: flex; align-items: center; justify-content: center; border-radius: 24rpx; background: var(--card); color: var(--brand); font-size: 28rpx; }
.page-note { margin: 20rpx 32rpx 0; font-size: 24rpx; line-height: 1.7; }
