@import "../../utils/advisor.wxss";
.interpret-notice { position: sticky; top: 0; z-index: 10; padding: 24rpx 32rpx; background: var(--brand-tint); color: var(--t1); font-size: 28rpx; line-height: 1.7; word-break: break-word; }
.interpret-item { margin-top: 24rpx; padding-top: 24rpx; border-top: 2rpx solid var(--line); white-space: pre-wrap; }
.interpret-meta { margin-top: 16rpx; color: var(--t2); font-size: 26rpx; line-height: 1.7; }
.interpret-ops { display: flex; flex-wrap: wrap; gap: 24rpx; }
.interpret-link { margin: 0; padding: 16rpx 0; min-height: 72rpx; color: var(--t2); background: var(--card); font-size: 26rpx; line-height: 1.5; }
.interpret-link::after { border: 0; }
