<view class="top" style="padding-top: {{statusBarHeight}}px">
  <view class="nav" style="height: {{navHeight}}px">
    <view class="nav-back" bindtap="goBack" aria-role="button" aria-label="返回"><t-icon name="chevron-left" size="48rpx" /></view>
    <text class="nav-title">名单看板</text>
  </view>
  <view class="sub">按已收录名单整理，“公示”“公布”按原文标题标注</view>
</view>

<notice-bar />
<view class="filters">
  <picker bindtap="openToolPicker" bindcancel="closeToolPicker" mode="selector" range="{{years}}" bindchange="pickYear"><view class="filter">{{year || '不限年度'}} <t-icon name="chevron-down" size="26rpx" /></view></picker>
  <picker bindtap="openToolPicker" bindcancel="closeToolPicker" mode="selector" range="{{provinces}}" bindchange="pickProvince"><view class="filter">{{province || '不限省份'}} <t-icon name="chevron-down" size="26rpx" /></view></picker>
  <picker bindtap="openToolPicker" bindcancel="closeToolPicker" mode="selector" range="{{types}}" bindchange="pickType"><view class="filter">{{type || '不限类型'}} <t-icon name="chevron-down" size="26rpx" /></view></picker>
</view>

<view wx:if="{{error}}" class="card empty"><text>{{error}}</text><text class="link retry" bindtap="retry">重试</text></view>
<view class="card list">
  <view class="section-title">最近 30 天发布的名单</view>
  <view wx:if="{{loading && !items.length}}" class="empty">正在加载…</view>
  <view wx:for="{{items}}" wx:key="id" class="item" data-id="{{item.id}}" bindtap="open">
    <view class="item-title">{{item.title}}</view>
    <view class="meta">{{item.dateText}} · {{item.issuer}} · {{item.province}}</view>
    <view class="item-foot"><text wx:if="{{item.wording}}" class="wording">{{item.wording}}</text><text wx:if="{{item.count !== null && item.count !== undefined}}">{{item.count}} 条</text><text wx:else class="count-unparsed">条数未解析</text></view>
  </view>
  <view wx:if="{{!loading && !error && !items.length}}" class="empty">最近 30 天没有已收录的名单</view>
  <view wx:if="{{items.length < total}}" class="more" bindtap="more">{{loading ? '加载中…' : '加载更多'}}</view>
</view>

<view class="card stats">
  <view class="section-title">统计</view>
  <view class="stat-group"><view class="stat-title">按年度</view><view class="table-head"><text>年度</text><text>名单份数</text><text>名单条数</text></view><view wx:for="{{stats.by_year}}" wx:key="year" class="table-row"><text>{{item.year}}</text><text>{{item.lists}}</text><text>{{item.entries}}</text></view><view wx:if="{{!stats.by_year.length}}" class="muted stat-empty">暂无数据</view></view>
  <view class="stat-group"><view class="stat-title">按省份</view><view class="table-head"><text>省份</text><text>名单份数</text><text>名单条数</text></view><view wx:for="{{stats.by_province}}" wx:key="province" class="table-row"><text>{{item.province}}</text><text>{{item.lists}}</text><text>{{item.entries}}</text></view><view wx:if="{{!stats.by_province.length}}" class="muted stat-empty">暂无数据</view></view>
  <view class="stat-group"><view class="stat-title">按名单类型</view><view class="table-head"><text>类型</text><text>名单份数</text><text>名单条数</text></view><view wx:for="{{stats.by_type}}" wx:key="type" class="table-row"><text>{{item.type}}</text><text>{{item.lists}}</text><text>{{item.entries}}</text></view><view wx:if="{{!stats.by_type.length}}" class="muted stat-empty">暂无数据</view></view>
</view>
<view class="note">只统计已收录网站的名单；名单条数只含从名单原文中解析出的企业；公示期内的名单也计入，最终结果以原文为准</view>
<tool-fab blocked="{{toolPickerOpen}}" />
