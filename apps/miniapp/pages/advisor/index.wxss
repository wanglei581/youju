@import "../../utils/advisor.wxss";
.recent-task::after { border: 0; }
/* 记录一行占满卡片宽：微信 style v2 的 button 不认 class 里的宽度和左右边距，要加 !important（原来被挤成中间一窄条） */
.recent-task { width: 100% !important; margin: 20rpx 0 0 !important; padding: 20rpx 0; min-height: 100rpx; display: flex; align-items: center; gap: 16rpx; text-align: left; white-space: normal; background: var(--card); border-top: 2rpx solid var(--line); border-radius: 0; font-size: 30rpx; line-height: 1.7; }
.recent-main { flex: 1; min-width: 0; }
