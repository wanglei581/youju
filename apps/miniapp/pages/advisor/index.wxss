@import "../../utils/advisor.wxss";
.task-section-title { margin: 32rpx 32rpx 4rpx; font-size: 34rpx; font-weight: 600; }
.context-row { display: flex; align-items: flex-start; gap: 16rpx; }
.context-label { flex: 1; min-width: 0; }
/* 微信 button 默认固定宽 184px，小屏上会把左边的文字挤没：按文字宽度排 */
.context-clear { flex-shrink: 0; margin: 0 !important; padding: 0 24rpx; width: auto !important; min-height: 88rpx; font-size: 28rpx; line-height: 88rpx; color: var(--brand); background: var(--brand-tint); }
.context-clear::after, .recent-task::after { border: 0; }
.context-note { margin-top: 16rpx; font-size: 26rpx; line-height: 1.6; color: var(--t2); }

/* 工具卡片 */
.tool-head { display: flex; align-items: flex-start; gap: 24rpx; }
.tool-ico { flex-shrink: 0; width: 80rpx; height: 80rpx; border-radius: 20rpx; background: var(--brand-tint); display: flex; align-items: center; justify-content: center; }
.tool-main { flex: 1; min-width: 0; }
.pass-link { padding-top: 28rpx; padding-bottom: 28rpx; font-size: 28rpx; }

/* 最近任务：一行一个，左边名称和时间，右边状态 */
.recent-head { margin: -16rpx 0; display: flex; align-items: center; justify-content: space-between; gap: 24rpx; }
.recent-all { flex-shrink: 0; min-height: 88rpx; padding-left: 24rpx; display: flex; align-items: center; font-size: 28rpx; }
.recent-task { margin: 0; padding: 24rpx 0; width: 100% !important; min-height: 112rpx; box-sizing: border-box; display: flex; align-items: center; gap: 16rpx; text-align: left; white-space: normal; background: var(--card); border-bottom: 2rpx solid var(--line); border-radius: 0; font-weight: 400; }
.recent-head + .recent-task { margin-top: 28rpx; }
.recent-task:last-child { border-bottom: 0; padding-bottom: 0; }
.recent-main { flex: 1; min-width: 0; }
.recent-name { font-size: 30rpx; font-weight: 500; line-height: 1.5; color: var(--t1); }
.recent-meta { margin-top: 4rpx; font-size: 26rpx; line-height: 1.5; color: var(--t3); }
