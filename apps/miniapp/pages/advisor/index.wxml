<notice-bar />
<view wx:if="{{loading}}" class="card advisor-card muted">正在加载…</view>
<block wx:elif="{{toolsEnabled}}">
  <view wx:if="{{aiEnabled}}" class="ai-internal"><text class="ai-internal-tag">{{aiLabel}}</text>{{aiNotice}}</view>
  <view wx:if="{{dataEnabled}}" class="card advisor-card">
    <view class="advisor-title">批量处理客户名单</view>
    <view class="advisor-text muted">{{dataStatus || '正在读取额度…'}}</view>
    <view wx:if="{{dataError}}" class="advisor-error">{{dataError}}<button class="advisor-button" bindtap="refreshQuota">刷新额度</button></view>
    <block wx:if="{{compareEnabled}}"><view class="advisor-text">批量名单比对：按企业名称或信用代码查询已收录名单，每条结果都能追溯官方原文。未查到不等于没有入选。</view><button class="advisor-button btn-primary" data-kind="compare" bindtap="dataTool">批量名单比对</button></block>
    <block wx:if="{{trackEnabled}}"><view class="advisor-text">客户相关通知表：按省份、可选城市、关键词和支持方式整理近 90 天申报通知，不判断能否申报，可下载 Excel。</view><button class="advisor-button" data-kind="track" bindtap="dataTool">制作客户相关通知表</button></block>
  </view>
  <view wx:if="{{!aiEnabled && aiGate === 'consent'}}" class="card advisor-card">
    <view>{{aiGateText}}</view><button class="advisor-button" bindtap="consent">阅读并同意后查看其他工具</button>
  </view>
  <view wx:if="{{aiEnabled && context}}" class="card advisor-card advisor-context">
    <view class="context-row"><text class="context-label">{{context.label}}</text><button class="context-clear" bindtap="clearContext">清除</button></view>
  </view>
  <view wx:if="{{aiEnabled && interpretEnabled}}" class="card advisor-card">
    <view class="advisor-title">政策解读与材料清单</view>
    <view class="advisor-text">AI 模型把通知正文里的申报对象、支持方式、申报条件、时间、方式和材料摘成原句，每条附段落编号，可以回到原文核对</view>
    <view class="advisor-text muted">今天剩余 {{remaining}} 次</view>
    <button wx:if="{{context && context.docId}}" class="advisor-button btn-primary" bindtap="interpret">解读这篇通知</button>
    <view wx:else class="advisor-text muted">请先打开一份申报通知，在详情页点右下角“{{fabText}}”</view>
    <button wx:if="{{!(context && context.docId)}}" class="advisor-button" bindtap="search">去找通知</button>
  </view>
  <view wx:if="{{aiEnabled && clauseEnabled}}" class="card advisor-card">
    <view class="advisor-title">条款对照</view>
    <view class="advisor-text">AI 模型列出通知里申报对象、申报条件的原句，和你填写的企业情况并排显示，方便你自己对照（不作资格判断）</view>
    <view class="advisor-text muted">今天剩余 {{clauseRemaining}} 次</view>
    <button wx:if="{{context && context.docId}}" class="advisor-button btn-primary" bindtap="clause">填写企业情况</button>
    <view wx:else class="advisor-text muted">请先打开一份申报通知，在详情页点右下角“{{fabText}}”</view>
  </view>
  <view class="card advisor-card">
    <view class="advisor-title">最近任务</view>
    <view wx:if="{{recentLoading}}" class="advisor-text muted">正在加载…</view>
    <view wx:elif="{{recentError}}" class="advisor-text"><view>{{recentError}}</view><button class="advisor-button" bindtap="retryRecent">重试</button></view>
    <view wx:elif="{{!recent.length}}" class="advisor-text muted">还没有任务。</view>
    <button wx:for="{{recent}}" wx:key="id" class="recent-task" data-id="{{item.id}}" bindtap="tasks">
      <view>{{item.kindLabel}} · {{item.stateLabel}}</view><view class="muted">{{item.docTitle || ''}}<text wx:if="{{item.docTitle}}"> · </text>{{item.time}}</view>
    </button>
    <button class="advisor-button" bindtap="tasks">全部任务</button>
  </view>
  <view wx:if="{{aiEnabled}}" class="card advisor-card">
    <view class="advisor-title">适用范围</view>
    <view wx:for="{{scope}}" wx:key="*this" class="advisor-text">{{item}}</view>
  </view>
  <view wx:if="{{disclosure}}" class="advisor-footer">{{disclosure}}</view>
  <view class="advisor-footer">第三方整理 · 非政府平台<text wx:if="{{aiEnabled}}"> · </text><text wx:if="{{aiEnabled}}" class="link" bindtap="report">投诉举报</text></view>
</block>
<block wx:else>
  <view class="card advisor-card muted">
    <view>{{gateText}}</view>
    <button wx:if="{{gate === 'consent'}}" class="advisor-button btn-primary" bindtap="consent">阅读并同意</button>
    <button wx:if="{{gate === 'offline'}}" class="advisor-button" bindtap="reload">重试</button>
  </view>
  <view class="advisor-footer">第三方整理 · 非政府平台</view>
</block>
