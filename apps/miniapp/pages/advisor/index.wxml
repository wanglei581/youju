<notice-bar />
<view wx:if="{{loading}}" class="card advisor-card muted">正在加载…</view>
<view wx:elif="{{error}}" class="card advisor-card"><view>{{error}}</view><button class="advisor-button" bindtap="load">重试</button></view>
<block wx:elif="{{enabled}}">
  <view wx:for="{{skills}}" wx:key="kind" class="card advisor-card">
    <view class="advisor-title">{{item.title}}</view>
    <view class="advisor-text">{{item.description}}</view>
    <view class="advisor-text muted">今天剩余 {{item.remaining}} 次 · 每次最多 {{item.maxRows}} 行</view>
    <button class="advisor-button btn-primary" data-kind="{{item.kind}}" bindtap="form">填写客户</button>
  </view>
  <view class="card advisor-card"><button class="advisor-button" bindtap="tasks">我的任务</button></view>
</block>
<view wx:else class="card advisor-card muted">暂时没有可用工具</view>
<view class="advisor-footer">第三方整理 · 非政府平台</view>
