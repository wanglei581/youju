<notice-bar />
<view wx:if="{{loading}}" class="card advisor-card muted">正在加载…</view>
<view wx:elif="{{error}}" class="card advisor-card"><view>{{error}}</view><button class="advisor-button" bindtap="load">重试</button></view>
<view wx:elif="{{!product}}" class="card advisor-card muted">{{closedNote || '正在加载…'}}</view>
<block wx:else>
  <!-- 沙箱真机付款会真实扣钱（10/20 创始人实测：付了款、账单里扣了），不能写"不扣真钱" -->
  <view wx:if="{{sandbox}}" class="card pass-sandbox">沙箱测试：只对测试人员开放。真机付款会真实扣款，开通的使用期仅供测试；不需要的可以在“我的 → 我的订单”按下面的退款规则申请退款。正式收费前《付费服务协议》会定稿。</view>
  <!-- 最上面一眼看到：给谁用、两档多少钱、会不会再扣钱；续买的规则和价格在同一屏（D-070） -->
  <view class="pass-hero">
    <view class="pass-name">批量工具</view>
    <view class="pass-lead">给要一次比对很多家客户的顾问用；查通知、查单家企业一直免费</view>
    <view class="pass-tiers" aria-role="radiogroup">
      <view wx:for="{{tiers}}" wx:key="productId" class="pass-tier {{index === selected ? 'pass-tier--on' : ''}}" data-index="{{index}}" bindtap="pick" aria-role="radio" aria-checked="{{index === selected}}">
        <view class="pass-tier-days">{{item.days}} 天</view>
        <view class="pass-price"><text class="pass-num">{{item.price}}</text><text class="pass-unit">元</text></view>
        <view class="pass-tier-sub">{{item.per30}}</view>
      </view>
    </view>
    <view class="pass-sub">一次付清，到期不再扣钱</view>
    <view wx:if="{{renew}}" class="pass-renew">{{renew.text}}{{renew.now ? '：现在付款就送' : ''}}</view>
    <view wx:if="{{soon}}" class="pass-now">{{soon}}</view>
    <view wx:elif="{{expires}}" class="pass-now">你的批量工具到 {{expires}}；再买一次，接着往后顺延</view>
  </view>

  <view class="card pass-card">
    <view class="pass-title">包含什么</view>
    <view class="pass-row">
      <view class="pass-ico"><t-icon name="bulletpoint" size="36rpx" color="#2A5CE0" /></view>
      <view class="pass-main"><view class="pass-lead-item">批量名单比对</view><view class="pass-desc">不限次数，每次 500 家以内</view></view>
    </view>
    <view class="pass-row">
      <view class="pass-ico"><t-icon name="task-checked" size="36rpx" color="#2A5CE0" /></view>
      <view class="pass-main"><view class="pass-lead-item">客户相关通知表</view><view class="pass-desc">不限次数，每次 500 家以内</view></view>
    </view>
    <view class="pass-row">
      <view class="pass-ico"><t-icon name="download" size="36rpx" color="#2A5CE0" /></view>
      <view class="pass-main"><view class="pass-lead-item">结果可导出 Excel</view><view class="pass-desc">带发文机关、日期和原文链接</view></view>
    </view>
  </view>

  <!-- 不买能用多少，和上面挨着写清楚：不想买的人不用猜 -->
  <view class="card pass-card">
    <view class="pass-title">不买也能用</view>
    <view class="pass-line">批量名单比对、客户相关通知表：每月各 3 次，每次 50 家以内（交一份名单算一次，系统出错、没出结果的不算）</view>
    <view class="pass-line">搜索、详情、附件、查名单、导出等一直免费</view>
  </view>

  <!-- 付款前要看得到的（D-070）：收录范围、只限本人、苹果退款、发票、到期后的结果 -->
  <view class="card pass-card">
    <view class="pass-title">付款前请看清楚</view>
    <view class="pass-note">这是第三方整理公开信息的工具，不是政府平台；不代办申报，不承诺申报结果。信息整理自政府部门公开网站，以发文机关原文为准。</view>
    <view class="pass-note">收录范围：已收录哪些省、哪些城市和栏目，请先<text class="link" bindtap="coverage" aria-role="button">查看收录范围</text>；没收录的地方查不到。</view>
    <view class="pass-note">只限本人的微信使用，不能转让，也不能几个人共用。</view>
    <view class="pass-note">使用期从开通时起算（一般付款后几秒内就开通）；已有使用期的，接着往后顺延。在加量体验期间买的，开通时体验结束，没用完的体验时间折成天数加在后面（不足一天按一天）。</view>
    <view class="pass-note">只收这一次的钱，到期后不会再扣款。到期后，已经生成的结果仍可查看、导出（结果保存 30 天）。</view>
    <view class="pass-note">退款：用安卓、鸿蒙手机或电脑版微信付款的，付款后 24 小时内没用过付费的量（没超出每月免费次数、没有一次超过 50 家）、也没开过发票，可在“我的 → 我的订单”申请无理由退款，全额原路退回；每个账号每月只能申请 1 次无理由退款；超过 24 小时或者已经用过的，不能无理由退款。</view>
    <view class="pass-note">因系统故障不能用、或我们停止服务（会提前至少 30 天公告）的，按剩余天数退款。退哪一笔只退那一笔，续买多送的天数随那一笔一起收回。</view>
    <view class="pass-note">苹果手机付款的，退款由苹果公司通过 App Store 处理，是否退款由苹果公司决定；也可以在“遇到问题”里提交，我们协助办理。苹果手机要 iOS 15 以上、微信 8.0.68 以上，并且用中国大陆的 App Store 账户才能付款。</view>
    <view class="pass-note">发票：{{invoiceText || '能开哪种发票还没确定，确定后写在这里（正式收费前）'}}。在“我的 → 我的订单”申请，申请当月开出电子发票，发到你填的邮箱。</view>
    <view class="pass-help">支付或订单有问题？<text class="link" bindtap="feedback" aria-role="button">遇到问题</text></view>
  </view>
  <view class="pass-space"></view>

  <!-- 付款栏固定在底部：不用翻到最后才找到按钮；协议不默认勾选。现网要协议定稿、写明了发票才能付款 -->
  <view class="pass-bar">
    <view wx:if="{{message}}" class="pass-msg {{payError ? 'pass-msg--error' : ''}}">{{message}}<text wx:if="{{ordersLink}}" class="link pass-orders" bindtap="orders" aria-role="button">查看我的订单</text></view>
    <block wx:if="{{((termsFinal && invoiceText) || sandbox) && loginOpen && !confirmed}}">
      <checkbox-group bindchange="check"><label class="pass-check"><checkbox value="agree" checked="{{checked}}" disabled="{{busy}}" /><text>我已阅读并同意</text><text class="advisor-link" catchtap="terms">《付费服务协议》</text></label></checkbox-group>
      <button class="pass-pay btn-primary" bindtap="buy" loading="{{busy}}" disabled="{{busy}}">{{sandbox ? '沙箱支付' : '支付'}} {{price}} 元（{{product.days}} 天）</button>
    </block>
    <view wx:elif="{{!confirmed}}" class="pass-closed">付费服务暂未开放</view>
    <button wx:if="{{confirmed}}" class="pass-pay btn-primary" bindtap="tools">去用工具</button>
  </view>
</block>
<view wx:if="{{loading || error || !product}}" class="exits"><button class="exit-btn" bindtap="feedback">遇到问题</button></view>
