<notice-bar />
<view wx:if="{{demo}}" class="local">演示数据：连上接口后，这里显示你在这台手机上导出的文件</view>
<!-- 有导出记录时显示列表；还没导出过时换成一张卡片，讲清怎么导出、怎么在电脑上保存 -->
<view wx:if="{{files.length}}" class="card">
  <view class="section-title">导出记录 {{files.length}}<text wx:if="{{!demo}}" class="link clear" bindtap="clearAll" aria-role="button">清空</text></view>
  <view wx:for="{{files}}" wx:key="id" class="file {{index === files.length - 1 ? 'file--last' : ''}}">
    <text class="badge badge--{{item.badge}} {{item.expired ? 'badge--expired' : ''}}">{{item.badge}}</text>
    <view class="file-main">
      <view class="file-name {{item.expired ? 'file-name--expired' : ''}}">{{item.name}}</view>
      <view class="muted file-meta">{{item.meta}}</view>
      <view class="actions">
        <block wx:if="{{!item.expired}}">
          <view class="act act--primary" data-index="{{index}}" bindtap="open" aria-role="button">站内查看</view>
          <view class="act" data-index="{{index}}" bindtap="forward" aria-role="button">转发</view>
        </block>
        <block wx:else>
          <text class="expired">文件已清理</text>
          <view class="act act--primary" data-index="{{index}}" bindtap="reexport" aria-role="button">查看当前结果</view>
        </block>
      </view>
    </view>
  </view>
</view>
<view wx:else class="card empty">
  <view class="empty-icon"><t-icon name="file" size="48rpx" /></view>
  <view class="empty-title">还没有导出过</view>
  <view class="steps">
    <view class="step"><text class="step-no">1</text><text class="step-text">在搜索结果点“选择”，或在文件详情点“结果”</text></view>
    <view class="step"><text class="step-no">2</text><text class="step-text">在小程序内查看结果，需要保存时再选 Excel 或 Word</text></view>
    <view class="step"><text class="step-no">3</text><text class="step-text">导出后可转发给同事或客户</text></view>
  </view>
  <view class="pc-tip">在电脑上保存：转发到“文件传输助手”，在电脑版微信打开</view>
</view>
<view class="tip">导出记录只保存在这台手机上；为节省空间只保留最近一份文件，更早的可按当前数据重新查看并保存。</view>
<view class="tab-page-bottom"></view>
