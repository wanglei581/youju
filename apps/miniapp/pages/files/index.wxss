.local { margin: 16rpx 24rpx 0; padding: 16rpx 24rpx; background: var(--brand-tint); border-radius: 16rpx; font-size: 24rpx; color: var(--t2); }
.intro { margin: 20rpx 32rpx 0; font-size: 26rpx; line-height: 1.7; color: var(--t2); }
.file { display: flex; gap: 24rpx; padding: 24rpx 0 28rpx; border-bottom: 2rpx solid var(--line); }
.file--last { border-bottom: 0; }
.badge { width: 80rpx; height: 80rpx; flex-shrink: 0; border-radius: 16rpx; display: flex; align-items: center; justify-content: center; font-size: 20rpx; font-weight: 700; }
.badge--XLSX { background: var(--g-tint); color: var(--g-txt); }
.badge--DOCX { background: var(--brand-tint); color: var(--brand); }
.badge--expired { opacity: 0.55; }
.file-main { flex: 1; min-width: 0; }
.file-name { font-size: 30rpx; font-weight: 600; }
.file-name--expired { color: var(--t2); }
.file-meta { margin-top: 6rpx; font-size: 25rpx; }
.actions { margin-top: 16rpx; display: flex; align-items: center; gap: 16rpx; }
.act { height: 56rpx; padding: 0 24rpx; display: flex; align-items: center; border: 2rpx solid var(--line2); border-radius: 28rpx; font-size: 26rpx; color: var(--t1); }
.act--primary { border-color: var(--brand); color: var(--brand); }
.expired { height: 48rpx; padding: 0 16rpx; display: flex; align-items: center; background: var(--fill); border-radius: 8rpx; font-size: 24rpx; color: var(--t3); }
.tip { margin: 24rpx 32rpx 0; font-size: 24rpx; line-height: 1.7; color: var(--t3); }
.clear { font-size: 28rpx; font-weight: 400; }
.empty { padding: 16rpx 0 32rpx; font-size: 26rpx; }
