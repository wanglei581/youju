@import "../../utils/advisor.wxss";
.draft { margin: 20rpx 24rpx 0; padding: 16rpx 24rpx; background: var(--o-tint); border-radius: 16rpx; font-size: 24rpx; color: var(--o-txt); }
.doc { padding: 32rpx; }
.doc-title { font-size: 34rpx; font-weight: 600; }
.sec { margin-top: 28rpx; }
.sec-h { font-size: 30rpx; font-weight: 600; }
.sec-p { margin-top: 12rpx; font-size: 27rpx; line-height: 1.75; color: var(--t1); }
.note { padding: 24rpx 32rpx; font-size: 24rpx; line-height: 1.7; color: var(--t2); }
.intro { padding: 24rpx 32rpx; font-size: 26rpx; line-height: 1.7; color: var(--t2); }
.agree { margin: 40rpx 32rpx 0; }
.agree--off { opacity: 0.5; }
.sec-p--key { font-weight: 600; }
.keybox { margin-top: 20rpx; padding: 20rpx 24rpx; background: var(--o-tint); border-radius: 16rpx; }
.keybox-h { font-size: 26rpx; font-weight: 600; color: var(--o-txt); }
.keybox-p { margin-top: 8rpx; font-size: 25rpx; line-height: 1.7; color: var(--t1); }

