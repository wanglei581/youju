<notice-bar />
<feature-closed wx:if="{{!loginOpen}}" />
<block wx:else>
  <view wx:if="{{message}}" class="card advisor-card">{{message}}</view>
  <view wx:if="{{loading}}" class="card advisor-card muted">正在加载…</view>
  <view wx:elif="{{error}}" class="card advisor-card"><view>{{error}}</view><button class="advisor-button" bindtap="load">重试</button></view>
  <view wx:elif="{{!items.length}}" class="card advisor-card muted">还没有订单</view>
  <block wx:else>
  <view wx:for="{{items}}" wx:key="orderId" class="card order">
    <view class="order-head"><text class="order-name">客户工作台 30 天</text><text class="order-status order-status--{{item.statusTone}}">{{item.statusText}}</text></view>
    <view class="order-line"><text class="order-amount">{{item.amountText}} 元</text><text wx:if="{{item.paidText}}" class="muted"> · {{item.paidText}} 付款</text></view>
    <view wx:if="{{item.period}}" class="order-line muted">使用期 {{item.period}}</view>
    <view class="order-line weak">订单号 {{item.orderId}}</view>
    <view wx:if="{{!item.canRefund && item.reason}}" class="order-reason">不能自助退款：{{item.reason}}</view>
    <view class="order-actions">
      <button wx:if="{{item.canRefund}}" class="order-btn" data-id="{{item.orderId}}" bindtap="refund" disabled="{{refunding !== null}}" loading="{{refunding === item.orderId}}">申请退款</button>
      <button class="order-btn" data-id="{{item.orderId}}" bindtap="invoice">申请发票</button>
    </view>
  </view>
  </block>
  <view class="order-help">支付或订单有问题？<text class="link" bindtap="feedback" aria-role="button">遇到问题</text></view>
</block>
