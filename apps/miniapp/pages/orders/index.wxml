<notice-bar />
<block wx:if="{{loginOpen}}">
  <view wx:if="{{message}}" class="card advisor-card">{{message}}</view>
  <view wx:if="{{loading}}" class="card advisor-card muted">正在加载…</view>
  <view wx:elif="{{error}}" class="card advisor-card"><view>{{error}}</view><button class="advisor-button" bindtap="load">重试</button></view>
  <view wx:elif="{{!items.length}}" class="card advisor-card muted">还没有订单</view>
  <block wx:else>
  <view wx:for="{{items}}" wx:key="orderId" class="card order">
    <view class="order-head"><text class="order-name">{{item.name}}</text><text class="order-status order-status--{{item.statusTone}}">{{item.statusText}}</text></view>
    <view class="order-line"><text class="order-amount">{{item.amountText}} 元</text><text wx:if="{{item.paidText}}" class="muted"> · {{item.paidText}} 付款</text><text wx:elif="{{item.orderedText}}" class="muted"> · {{item.orderedText}} 下单</text></view>
    <!-- 待确认、人工核对中、已关闭：说一句现在是什么情况、接下来会怎样 -->
    <view wx:if="{{item.note}}" class="order-note">{{item.note}}</view>
    <view wx:if="{{item.refundText}}" class="order-line muted">{{item.refundText}}</view>
    <view wx:if="{{item.period}}" class="order-line muted">使用期 {{item.period}}</view>
    <!-- 随这笔送的天数，每次一行（续买多送、加量体验折算） -->
    <view wx:for="{{item.gifts}}" wx:for-item="gift" wx:key="*this" class="order-line muted">{{gift}}</view>
    <view class="order-line weak">订单号 {{item.orderId}} <text wx:if="{{item.termsVersion}}" class="link" data-version="{{item.termsVersion}}" data-id="{{item.orderId}}" bindtap="terms" aria-role="button">《付费服务协议》</text></view>
    <view wx:if="{{!item.canRefund && item.reason}}" class="order-reason">不能自助退款：{{item.reason}}</view>
    <view wx:if="{{item.invoice}}" class="order-invoice">
      <view>发票：{{item.invoice.status}} · {{item.invoiceText}}</view>
      <view wx:if="{{item.invoice.note}}" class="order-reason">{{item.invoice.note}}</view>
    </view>
    <view wx:if="{{invoiceFor === item.orderId}}" class="invoice-form">
      <radio-group class="invoice-types" bindchange="titleType">
        <label class="invoice-type"><radio value="personal" checked="{{form.titleType === 'personal'}}" disabled="{{sending}}" />个人</label>
        <label class="invoice-type"><radio value="company" checked="{{form.titleType === 'company'}}" disabled="{{sending}}" />单位</label>
      </radio-group>
      <input class="invoice-input" value="{{form.title}}" maxlength="100" placeholder="{{form.titleType === 'company' ? '单位全称' : '个人姓名'}}" data-field="title" bindinput="field" disabled="{{sending}}" />
      <input wx:if="{{form.titleType === 'company'}}" class="invoice-input" value="{{form.taxId}}" maxlength="20" placeholder="税号（统一社会信用代码）" data-field="taxId" bindinput="field" disabled="{{sending}}" />
      <input class="invoice-input" value="{{form.email}}" maxlength="254" placeholder="接收发票的邮箱" data-field="email" bindinput="field" disabled="{{sending}}" />
      <view class="muted invoice-hint">申请当月开出电子发票，发到上面的邮箱。开出前可以修改。</view>
      <view wx:if="{{formError}}" class="advisor-error">{{formError}}</view>
      <view class="order-actions">
        <button class="order-btn btn-primary" bindtap="sendInvoice" loading="{{sending}}" disabled="{{sending}}">提交</button>
        <button class="order-btn" bindtap="cancelInvoice" disabled="{{sending}}">取消</button>
      </view>
    </view>
    <view wx:elif="{{item.canRefund || item.invoiceAction || item.canCheck || item.canReport}}" class="order-actions">
      <button wx:if="{{item.canReport}}" class="order-btn" data-id="{{item.orderId}}" bindtap="problem">遇到问题</button>
      <button wx:if="{{item.canCheck}}" class="order-btn order-btn--main" data-id="{{item.orderId}}" bindtap="recheck" disabled="{{checking !== null}}" loading="{{checking === item.orderId}}">重新核对</button>
      <button wx:if="{{item.canRefund}}" class="order-btn" data-id="{{item.orderId}}" bindtap="refund" disabled="{{refunding !== null}}" loading="{{refunding === item.orderId}}">申请退款</button>
      <button wx:if="{{item.invoiceAction}}" class="order-btn" data-id="{{item.orderId}}" bindtap="invoice">{{item.invoiceAction}}</button>
    </view>
  </view>
  </block>
  <view class="order-help">支付或订单有问题？<text class="link" bindtap="feedback" aria-role="button">遇到问题</text></view>
</block>
