@import "../../utils/advisor.wxss";

/* 一张订单一张卡片：名称和状态一行，金额、使用期、订单号各一行，下面是能做的事 */
.order { padding-top: 28rpx; padding-bottom: 24rpx; }
.order-head { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.order-name { font-size: 32rpx; font-weight: 600; color: var(--t1); }
.order-status { flex-shrink: 0; padding: 0 16rpx; line-height: 44rpx; border-radius: 8rpx; font-size: 24rpx; background: var(--fill); color: var(--t2); }
.order-status--on { background: var(--brand-tint); color: var(--brand); }
.order-status--refund { background: var(--o-tint); color: var(--o-txt); }
/* 待确认：在处理中（橙）；人工核对中：出了问题、要人看（红） */
.order-status--wait { background: var(--o-tint); color: var(--o-txt); }
.order-status--warn { background: var(--r-tint); color: var(--red); }
/* 待确认、人工核对中、已关闭的说明一句 */
.order-note { margin-top: 16rpx; padding: 14rpx 20rpx; border-radius: 12rpx; background: var(--fill); font-size: 26rpx; line-height: 1.6; color: var(--t2); }
.order-line { margin-top: 10rpx; font-size: 28rpx; line-height: 1.6; }
.order-amount { color: var(--t1); font-weight: 500; }
.order-reason { margin-top: 16rpx; padding: 14rpx 20rpx; border-radius: 12rpx; background: var(--fill); font-size: 26rpx; line-height: 1.6; color: var(--t2); }
.order-actions { margin-top: 20rpx; display: flex; justify-content: flex-end; gap: 16rpx; }
/* 微信的 button 默认是固定宽度的大按钮，这里做成右下角的小胶囊 */
.order-btn { margin: 0 !important; width: auto !important; min-height: 64rpx; padding: 0 32rpx; line-height: 60rpx; border: 2rpx solid var(--line2); border-radius: 32rpx; background: var(--card); font-size: 26rpx; font-weight: 400; color: var(--t1); }
.order-btn::after { border: 0; }
/* 这张订单最该点的那一个（待确认的"重新核对"）：品牌蓝描边 */
.order-btn--main { border-color: var(--brand); color: var(--brand); }
.order-help { padding: 32rpx 24rpx calc(48rpx + env(safe-area-inset-bottom)); text-align: center; font-size: 26rpx; color: var(--t2); }
/* 发票：状态一行；申请或修改时在本张订单里展开表单 */
.order-invoice { margin-top: 16rpx; font-size: 26rpx; line-height: 1.6; color: var(--t2); word-break: break-all; }
.invoice-form { margin-top: 20rpx; padding-top: 20rpx; border-top: 2rpx solid var(--line); }
.invoice-types { display: flex; gap: 40rpx; margin-bottom: 16rpx; font-size: 28rpx; }
.invoice-type { display: flex; align-items: center; gap: 8rpx; }
.invoice-input { margin-top: 16rpx; min-height: 80rpx; padding: 0 24rpx; border: 2rpx solid var(--line2); border-radius: 12rpx; background: var(--card); font-size: 28rpx; }
.invoice-hint { margin-top: 12rpx; font-size: 24rpx; line-height: 1.6; }
