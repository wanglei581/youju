@import "../../utils/advisor.wxss";

.dc-card { padding-top: 32rpx; padding-bottom: 28rpx; }
.dc-title { font-size: 34rpx; font-weight: 600; color: var(--t1); }
.dc-doc { margin-top: 16rpx; padding: 18rpx 20rpx; border-radius: 12rpx; background: var(--fill); font-size: 26rpx; line-height: 1.6; color: var(--t1); }
.dc-intro { margin-top: 20rpx; font-size: 26rpx; line-height: 1.75; color: var(--t2); }

/* 选择项：一行一项 */
.dc-fields { padding-top: 8rpx; padding-bottom: 8rpx; }
.dc-field { min-height: 104rpx; display: flex; align-items: center; gap: 16rpx; border-bottom: 2rpx solid var(--line); }
.dc-field--last { border-bottom: 0; }
.dc-name { flex-shrink: 0; font-size: 30rpx; font-weight: 500; color: var(--t1); }
.dc-value { flex: 1; text-align: right; font-size: 28rpx; color: var(--t1); }
.dc-value--empty { color: var(--t3); }
.dc-clear { display: flex; justify-content: flex-end; font-size: 26rpx; }
.dc-clear-link { min-height: 88rpx; padding-left: 32rpx; display: flex; align-items: center; }

.dc-input { display: block; box-sizing: border-box; margin-top: 20rpx; padding: 24rpx; width: 100%; min-height: 200rpx; border-radius: 12rpx; background: var(--fill); font-size: 28rpx; line-height: 1.8; }
.dc-ph { color: var(--t3); }
.dc-hint { margin-top: 16rpx; font-size: 24rpx; line-height: 1.7; color: var(--t3); }

.dc-actions { margin: 32rpx 24rpx 0; }
.dc-error { padding: 0 8rpx 16rpx; font-size: 26rpx; line-height: 1.6; color: var(--red); }
/* 微信的 button 默认是固定宽度，这里要占满一行 */
.dc-submit { width: 100% !important; margin: 0; min-height: 96rpx; font-size: 32rpx; line-height: 96rpx; padding: 0; }
.dc-submit::after { border: 0; }

/* 提交成功 */
.dc-done { display: flex; align-items: center; gap: 24rpx; }
.dc-done-ico { flex-shrink: 0; width: 72rpx; height: 72rpx; border-radius: 50%; background: var(--brand); display: flex; align-items: center; justify-content: center; }
.dc-done-text { font-size: 28rpx; line-height: 1.7; color: var(--t1); }
