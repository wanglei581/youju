<notice-bar />
<view wx:if="{{loading}}" class="card advisor-card muted">正在加载…</view>
<view wx:if="{{error}}" class="card advisor-card"><view>{{error}}</view><button class="advisor-button" bindtap="load">重试</button></view>
<view wx:if="{{actionError}}" class="card advisor-card advisor-error">操作没有成功：{{actionError}}</view>
<block wx:if="{{!loading}}">
  <block wx:if="{{toolsEnabled}}">
    <!-- AI 和批量工具都能用时：一排筛选（和"我的客户"的切换一个样子），从哪进来先选好哪一种，可以切回全部；后面写各有几条 -->
    <view wx:if="{{aiEnabled && mixed}}" class="seg" aria-role="tablist">
      <view wx:for="{{filters}}" wx:key="key" class="seg-item {{current === item.key ? 'seg-item--on' : ''}}" data-key="{{item.key}}" bindtap="pick" aria-role="tab" aria-selected="{{current === item.key}}">{{item.label}} {{counts[item.key]}}</view>
    </view>
    <view wx:if="{{aiEnabled && current !== 'tools'}}" class="ai-internal"><text class="ai-internal-tag">{{aiLabel}}</text>{{aiNotice}}</view>
    <!-- 空的时候按入口写，指回 AI 首页（用户看到的名字是底栏和页面标题上的"AI"）或批量工具 -->
    <view wx:if="{{!counts[current] && !error}}" class="card advisor-card">
      <block wx:if="{{aiEnabled && current === 'ai'}}">
        <view class="advisor-title">还没有 AI 记录</view>
        <view class="advisor-text muted">在“AI”里选一份通知，做 AI 解读或条款对照，结果会保存在这里。</view>
        <button class="advisor-button" bindtap="aiHome">去 AI</button>
      </block>
      <block wx:elif="{{current === 'tools'}}">
        <view class="advisor-title">还没有批量工具的记录</view>
        <view class="advisor-text muted">在批量工具里做批量名单比对或客户相关通知表，结果会保存在这里。</view>
        <button class="advisor-button" bindtap="tools">去批量工具</button>
      </block>
      <block wx:else>
        <view class="advisor-title">还没有记录</view>
        <block wx:if="{{aiEnabled && dataEnabled}}">
          <view class="advisor-text muted">AI 解读、条款对照和批量工具的结果，都会保存在这里。</view>
          <view class="advisor-actions"><button class="advisor-button" bindtap="aiHome">去 AI</button><button class="advisor-button" bindtap="tools">去批量工具</button></view>
        </block>
        <block wx:elif="{{aiEnabled}}">
          <view class="advisor-text muted">在“AI”里选一份通知，做 AI 解读或条款对照，结果会保存在这里。</view>
          <button class="advisor-button" bindtap="aiHome">去 AI</button>
        </block>
        <block wx:else>
          <view class="advisor-text muted">在批量工具里做批量名单比对或客户相关通知表，结果会保存在这里。</view>
          <button class="advisor-button" bindtap="tools">去批量工具</button>
        </block>
      </block>
    </view>
    <block wx:for="{{items}}" wx:key="id">
      <view wx:if="{{current === 'all' || item.recordType === current}}" class="card advisor-card {{focusId && focusId == item.id ? 'record--focus' : ''}}" data-id="{{item.id}}" bindtap="openTask">
        <!-- 类型标签放在标题行右边（放在前面会读成"AI AI 解读"，Grok 10/22） -->
        <view class="advisor-title record-head"><text>{{item.kindLabel}}</text><text wx:if="{{mixed}}" class="record-type {{item.recordType === 'ai' ? 'record-type--ai' : ''}}">{{item.recordTypeLabel}}</text></view>
        <view wx:if="{{item.docTitle}}" class="advisor-text">{{item.docTitle}}</view>
        <view class="advisor-text">{{item.stateLabel}}</view>
        <view class="advisor-text muted">{{item.time}}</view>
        <view wx:if="{{item.dataTask}}" class="advisor-text">提交 {{item.rowCount}} 家<text wx:if="{{item.status === 'done'}}"> · 结果 {{item.resultRows || 0}} 行</text></view>
        <view wx:if="{{item.downloadable && item.expiresText}}" class="advisor-text muted">结果保存至 {{item.expiresText}}，请及时下载</view>
        <view wx:if="{{item.resultNote}}" class="advisor-text muted">{{item.resultNote}}</view>
        <view wx:if="{{item.errorText}}" class="advisor-text muted">{{item.errorText}}</view>
        <view wx:if="{{item.refundNote}}" class="advisor-text muted">{{item.refundNote}}</view>
        <view class="advisor-actions">
          <button wx:if="{{item.downloadable}}" class="advisor-button btn-primary" data-id="{{item.id}}" catchtap="download" loading="{{downloadingId === item.id}}" disabled="{{busyId !== null}}">下载 Excel</button>
          <button wx:if="{{item.dataTask && item.terminal}}" class="advisor-button" data-kind="{{item.kind}}" catchtap="again">重新填写</button>
          <button wx:if="{{item.kind === 'interpret'}}" class="advisor-button btn-primary" data-id="{{item.id}}" catchtap="openTask">查看解读</button>
          <button wx:if="{{item.kind === 'clause'}}" class="advisor-button btn-primary" data-id="{{item.id}}" catchtap="openTask">查看对照</button>
          <button wx:if="{{item.status === 'queued'}}" class="advisor-button" data-id="{{item.id}}" catchtap="cancel" disabled="{{busyId !== null}}">取消</button>
          <button wx:if="{{item.terminal}}" class="advisor-button advisor-danger" data-id="{{item.id}}" catchtap="remove" disabled="{{busyId !== null}}">删除</button>
        </view>
      </view>
    </block>
  </block>
  <view wx:elif="{{!error}}" class="card advisor-card muted">
    <view>{{gateText}}</view>
    <button wx:if="{{gate === 'consent'}}" class="advisor-button btn-primary" bindtap="consent">阅读并同意</button>
    <button wx:if="{{gate === 'offline'}}" class="advisor-button" bindtap="reload">重试</button>
  </view>
</block>
