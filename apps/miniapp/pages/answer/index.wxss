.hero{background:#0b3633;color:#f7f4eb;border-radius:30rpx;padding:36rpx 34rpx 30rpx;min-height:335rpx;box-shadow:0 18rpx 42rpx rgba(6,38,36,.16)}
.hero-top,.hero-bottom{display:flex;align-items:center;justify-content:space-between}.hero-mark{display:flex;align-items:center;justify-content:center;width:54rpx;height:54rpx;border:1rpx solid rgba(255,255,255,.35);border-radius:16rpx;font-family:serif;color:#e7c8ad}.hero-title{font-size:56rpx;line-height:1.25;font-weight:800;margin-top:20rpx;letter-spacing:2rpx}.hero-desc{font-size:25rpx;color:#d7e5db;line-height:1.65;margin-top:14rpx}.hero-bottom{font-size:22rpx;color:#d5e2da;margin-top:28rpx}.hero-bottom .dot{margin-right:8rpx}
.search-card{padding:20rpx}.search-row{display:flex;align-items:center;border-bottom:1rpx solid #e2e8e0;min-height:78rpx}.search-glyph{font-size:46rpx;color:#487067;width:55rpx;text-align:center}.search-input{flex:1;height:78rpx;font-size:28rpx}.search-clear{font-size:42rpx;color:#81948a;padding:0 12rpx}.filter-grid{display:grid;grid-template-columns:1fr 1fr;gap:14rpx;margin-top:16rpx}.filter-grid picker{grid-column:span 2}.filter-grid .picker-value,.filter-grid .input{height:70rpx;font-size:25rpx}.search-submit{margin-top:18rpx}
.template-scroll{white-space:nowrap}.template-row{display:flex;gap:14rpx;padding-bottom:8rpx}.template{display:flex;flex-direction:column;min-width:172rpx;background:#fff;border:1rpx solid #e2e8e0;border-radius:22rpx;padding:19rpx 22rpx;box-sizing:border-box}.template-on{border-color:#164945;background:#e8efe8}.template-glyph{display:flex;align-items:center;justify-content:center;background:#e8efe8;color:#164945;width:52rpx;height:52rpx;border-radius:16rpx;font-family:serif;font-size:29rpx;font-weight:800}.template-name{font-size:25rpx;font-weight:700;margin-top:12rpx}.template-hint{font-size:21rpx;color:#82938b;margin-top:2rpx}.results-toolbar{display:flex;align-items:center;justify-content:space-between;color:#61766d;font-size:23rpx;margin:20rpx 4rpx}.results-toolbar text:last-child{color:#164945;font-weight:700}.selection-dock{position:fixed;left:0;right:0;bottom:100rpx;background:#fff;border-top:1rpx solid #dae5dc;box-shadow:0 -10rpx 28rpx rgba(9,49,42,.1);padding:18rpx 28rpx;z-index:10;display:flex;align-items:center;justify-content:space-between;gap:12rpx}.selection-info{display:flex;flex-direction:column;font-size:25rpx}.selection-clear{color:#a75132;font-size:22rpx;margin-top:4rpx}.selection-actions{display:flex;gap:10rpx}
