<view class="top" style="padding-top: {{statusBarHeight}}px">
  <view class="nav" style="height: {{navHeight}}px"><text class="nav-title">我的</text></view>
  <notice-bar onBlue="{{true}}" />
  <!-- 协议定稿前（D-056）没有登录：顶部只写"有据"和一句说明 -->
  <view wx:if="{{!loginOpen}}" class="brand">
    <view class="brand-name">有据</view>
    <view class="profile-sub">检索和导出不需要登录</view>
  </view>
  <block wx:else>
  <view class="profile">
    <view class="avatar"><t-icon name="user" size="56rpx" color="#FFFFFF" /></view>
    <view class="profile-main">
      <view class="profile-name">{{profileLoading ? '正在加载登录状态' : (profileError ? '登录状态未确认' : (signedIn ? '微信用户' : '未登录'))}}<text wx:if="{{passBadge && signedIn && !profileLoading && !profileError}}" class="pass-badge" bindtap="openPass" aria-role="button">{{passBadge}}</text></view>
      <view wx:if="{{profileLoading || profileError}}" class="profile-sub">{{profileLoading ? (serviceStarting ? '正在连接，比平时慢一点，请稍等…' : '请稍候') : '请重试以确认登录状态'}}</view>
      <view wx:elif="{{signedIn}}" class="profile-sub">关注 {{followCount}} 个条件<text wx:if="{{remindOpen}}"> · 还能提醒 {{reminderCount}} 次</text></view>
      <view wx:elif="{{outdated}}" class="profile-sub">用户协议或隐私保护指引已更新，请重新阅读并同意</view>
      <view wx:else class="profile-sub">登录后可以关注条件、{{remindOpen ? '订阅微信提醒、' : ''}}提交纠错</view>
    </view>
    <view wx:if="{{!profileLoading && !profileError && !signedIn && outdated}}" class="login login--on" bindtap="login">阅读更新</view>
    <view wx:elif="{{!profileLoading && !profileError && !signedIn}}" class="login {{agreed ? 'login--on' : ''}}" bindtap="login" aria-disabled="{{!agreed}}">微信登录</view>
  </view>
  <view wx:if="{{!profileLoading && !profileError && !signedIn && !outdated}}" class="agree">
    <view class="check-wrap" bindtap="toggleAgree" aria-role="checkbox" aria-checked="{{agreed}}">
      <view class="box {{agreed ? 'box--on' : ''}}"><t-icon wx:if="{{agreed}}" name="check" size="22rpx" color="#2A5CE0" /></view>
      <text>我已阅读并同意</text>
    </view>
    <text class="agree-link" data-type="user" bindtap="openAgreement">《用户协议》</text><text>和</text><text class="agree-link" data-type="privacy" bindtap="openAgreement">《隐私保护指引》</text>
    <view wx:if="{{nudge}}" class="nudge">请先勾选同意《用户协议》和《隐私保护指引》</view>
  </view>
  </block>
</view>

<view class="grid {{loginOpen ? '' : 'grid--2'}}">
  <view class="grid-item" data-url="/pages/files/index" data-tab="1" bindtap="go"><view class="gi gi--green"><t-icon name="download" size="40rpx" color="#13A677" /></view><text>导出记录</text></view>
  <view class="grid-item" data-url="/pages/clients/index" bindtap="go"><view class="gi gi--blue"><t-icon name="user" size="40rpx" color="#2A5CE0" /></view><text>我的客户</text></view>
  <view wx:if="{{loginOpen}}" class="grid-item" data-url="/pages/advisor/index" bindtap="go"><view class="gi gi--blue"><t-icon name="app" size="40rpx" color="#2A5CE0" /></view><text>批量工具</text></view>
  <view wx:if="{{loginOpen}}" class="grid-item" bindtap="feedback" aria-role="button"><view class="gi gi--red"><t-icon name="flag" size="40rpx" color="#E5484D" /></view><text>纠错</text></view>
</view>

<view wx:if="{{profileError}}" class="card load-error"><text>{{profileError}}</text><text class="link retry" bindtap="refresh">重试</text></view>

<view class="card">
  <view class="section-title">数据从哪里来</view>
  <view wx:if="{{stats}}" class="nums">
    <view class="num"><view class="num-v">{{stats.sources}}</view><view class="muted num-k">政府网站栏目</view></view>
    <view class="num num--line"><view class="num-v">{{stats.provinces}}</view><view class="muted num-k">个省 + 国家部委</view></view>
    <view class="num num--line"><view class="num-v">2</view><view class="muted num-k">次 / 天检查</view></view>
  </view>
  <view wx:if="{{stats.cities}}" class="data-note">其中已收录 {{stats.cities}} 个城市的栏目。地市目前只收录部分城市，<text class="link" data-url="/pages/about/index" bindtap="go">查看城市和栏目</text>。</view>
  <view wx:if="{{stats.districts}}" class="data-note">其中已收录 {{stats.districts}} 个区县的栏目。区县目前只收录少数地方，<text class="link" data-url="/pages/about/index" bindtap="go">查看区县和栏目</text>。</view>
  <view class="data-note">只收录政府网站公开发布的文件，每条都附原文链接<text wx:if="{{notCovered}}">；暂未收录：{{notCovered}}</text>。</view>
</view>

<view class="card">
  <view wx:if="{{loginOpen}}" class="row" data-url="/pages/advisor-tasks/index" bindtap="go"><t-icon name="file" size="40rpx" color="#4E5969" /><text class="row-text">我的记录</text><t-icon name="chevron-right" size="32rpx" color="#86909C" /></view>
  <!-- 去购买页的一行（D-076 ②）：写明是买（10/22：九宫格的「批量工具」是用工具的那一页，这里不能同名却去不同的页） -->
  <view wx:if="{{loginOpen && passEntry}}" class="row" data-url="/pages/pass/index" bindtap="go"><t-icon name="app" size="40rpx" color="#4E5969" /><text class="row-text">{{passLabel}}</text><text wx:if="{{passHint}}" class="row-hint">{{passHint}}</text><t-icon name="chevron-right" size="32rpx" color="#86909C" /></view>
  <view wx:if="{{loginOpen && ordersEntry}}" class="row" data-url="/pages/orders/index" bindtap="go"><t-icon name="bulletpoint" size="40rpx" color="#4E5969" /><text class="row-text">我的订单</text><t-icon name="chevron-right" size="32rpx" color="#86909C" /></view>
  <view wx:if="{{loginOpen}}" class="row" bindtap="coverage" aria-role="button"><t-icon name="add" size="40rpx" color="#4E5969" /><text class="row-text">申请覆盖：你关心的地区还没有？</text><t-icon name="chevron-right" size="32rpx" color="#86909C" /></view>
  <!-- 使用帮助和联系客服（D-075 第七节）：首发版也在，客服每天有人看、周末也看 -->
  <view class="row" data-url="/pages/help/index" bindtap="go" aria-role="button"><t-icon name="book" size="40rpx" color="#4E5969" /><text class="row-text">使用帮助</text><t-icon name="chevron-right" size="32rpx" color="#86909C" /></view>
  <contact-button variant="row" from="me" />
  <!-- 协议定稿前（D-056）：打开小程序后台填写的官方隐私保护指引，不显示草案 -->
  <view wx:if="{{loginOpen}}" class="row" data-type="user" bindtap="openAgreement"><t-icon name="secured" size="40rpx" color="#4E5969" /><text class="row-text">用户协议与隐私保护指引</text><t-icon name="chevron-right" size="32rpx" color="#86909C" /></view>
  <view wx:else class="row" bindtap="openPrivacy" aria-role="button"><t-icon name="secured" size="40rpx" color="#4E5969" /><text class="row-text">隐私保护指引</text><t-icon name="chevron-right" size="32rpx" color="#86909C" /></view>
  <view class="row {{hasRecord && !profileLoading && !profileError ? '' : 'row--last'}}" data-url="/pages/about/index" bindtap="go" aria-role="button"><t-icon name="info-circle" size="40rpx" color="#4E5969" /><text class="row-text">关于有据</text><t-icon name="chevron-right" size="32rpx" color="#86909C" /></view>
  <view wx:if="{{hasRecord && !profileLoading && !profileError}}" class="row" bindtap="myData" aria-role="button"><t-icon name="user-safety" size="40rpx" color="#4E5969" /><text class="row-text">我的数据</text><t-icon name="chevron-right" size="32rpx" color="#86909C" /></view>
  <view wx:if="{{hasRecord && !profileLoading && !profileError}}" class="row row--last" bindtap="deleteAccount" aria-role="button"><t-icon name="delete" size="40rpx" color="#E5484D" /><text class="row-text danger">注销并删除数据</text><t-icon name="chevron-right" size="32rpx" color="#86909C" /></view>
</view>
<view class="tab-page-bottom"></view>
