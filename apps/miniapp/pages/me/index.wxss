.top { padding: 0 32rpx 64rpx; background: linear-gradient(180deg, var(--brand-g1) 0%, var(--brand-g2) 100%); color: #FFFFFF; }
.nav { display: flex; align-items: center; justify-content: center; }
.nav-title { font-size: 34rpx; font-weight: 600; }
.profile { margin-top: 20rpx; display: flex; align-items: center; gap: 28rpx; }
.avatar { width: 112rpx; height: 112rpx; flex-shrink: 0; border-radius: 56rpx; background: rgba(255, 255, 255, 0.2); display: flex; align-items: center; justify-content: center; }
.profile-main { flex: 1; min-width: 0; }
.profile-name { font-size: 36rpx; font-weight: 600; }
.profile-sub { margin-top: 4rpx; font-size: 24rpx; color: rgba(255, 255, 255, 0.85); }
.login { flex-shrink: 0; height: 64rpx; padding: 0 28rpx; display: flex; align-items: center; border-radius: 32rpx; background: rgba(255, 255, 255, 0.28); color: rgba(255, 255, 255, 0.75); font-size: 28rpx; font-weight: 600; white-space: nowrap; }
.login--on { background: #FFFFFF; color: var(--brand); }
.agree { position: relative; margin-top: 24rpx; display: flex; align-items: center; flex-wrap: wrap; font-size: 23rpx; color: rgba(255, 255, 255, 0.85); }
.check-wrap { display: flex; align-items: center; gap: 12rpx; }
.box { width: 32rpx; height: 32rpx; box-sizing: border-box; border: 3rpx solid #FFFFFF; border-radius: 8rpx; display: flex; align-items: center; justify-content: center; }
.box--on { background: #FFFFFF; }
.agree-link { color: #FFFFFF; }
.nudge { position: absolute; left: -8rpx; bottom: calc(100% + 16rpx); padding: 12rpx 20rpx; border-radius: 12rpx; background: rgba(29, 33, 41, 0.92); color: #FFFFFF; font-size: 24rpx; white-space: nowrap; z-index: 5; }

.grid { position: relative; margin: -32rpx 24rpx 0; padding: 32rpx 8rpx 28rpx; background: var(--card); border-radius: 24rpx; box-shadow: 0 4rpx 20rpx rgba(29, 33, 41, 0.05); display: grid; grid-template-columns: repeat(4, 1fr); }
.grid-item { display: flex; flex-direction: column; align-items: center; gap: 12rpx; font-size: 25rpx; }
.gi { width: 80rpx; height: 80rpx; border-radius: 24rpx; display: flex; align-items: center; justify-content: center; }
.gi--orange { background: var(--o-tint); }
.gi--green { background: var(--g-tint); }
.gi--blue { background: var(--brand-tint); }
.gi--red { background: var(--r-tint); }

.nums { display: grid; grid-template-columns: repeat(3, 1fr); padding: 16rpx 0 24rpx; text-align: center; }
.num--line { border-left: 2rpx solid var(--line); }
.num-v { font-size: 40rpx; font-weight: 700; color: var(--brand); }
.num-k { font-size: 24rpx; }
.data-note { padding: 20rpx 0 28rpx; border-top: 2rpx solid var(--line); font-size: 25rpx; line-height: 1.75; color: var(--t2); }
.row { display: flex; align-items: center; gap: 24rpx; padding: 28rpx 0; border-bottom: 2rpx solid var(--line); }
.row--last { border-bottom: 0; }
.row-text { flex: 1; font-size: 30rpx; }
.foot { margin-top: 28rpx; text-align: center; font-size: 24rpx; color: var(--t3); }
.box--disabled { opacity: 0.5; }
.draft-note { width: 100%; margin-top: 8rpx; font-size: 22rpx; color: rgba(255, 255, 255, 0.7); }

.danger { color: var(--red); }
