<view class="page"><view class="eyebrow">SOURCE DIRECTORY</view><view class="serif source-title">来源目录</view><view class="notice">这里只列出管理员登记的来源和可用范围。登记不等于已经完成持续监测，也不保证该机构的所有资料都已收录。</view>
  <view class="section-head"><text class="section-title">已登记来源</text><text class="section-extra" wx:if="{{state === 'ready'}}">{{items.length}} 个</text></view>
  <state-view wx:if="{{state === 'loading'}}" type="loading" title="正在加载来源"/><state-view wx:elif="{{state === 'error'}}" type="error" title="来源加载失败" desc="{{error}}" action-text="重试" bindaction="load"/><state-view wx:elif="{{state === 'empty'}}" type="empty" glyph="源" title="尚无已登记来源" desc="需要管理员登记来源并审核使用范围。"/>
  <view wx:else><view wx:for="{{items}}" wx:key="id" class="card source-card"><view class="row-between"><text class="tag tag-{{item.rightsTone}}">{{item.rightsLabel}}</text><text class="small muted">#{{item.id}}</text></view><view class="card-title">{{item.name}}</view><view class="card-sub">{{item.publisher}} · {{item.homepageHost}}</view><view class="divider"></view><view class="small muted">{{item.rightsDesc}}</view><view class="btn btn-secondary btn-sm source-copy" data-url="{{item.homepageUrl}}" bindtap="onCopy">复制原站入口</view></view></view>
</view>
