.h1 { font-size: 36rpx; line-height: 1.5; font-weight: 600; }
.provenance { margin-top: 20rpx; font-size: 24rpx; line-height: 1.8; word-break: break-all; }
.notice, .error { margin: 24rpx 0; padding: 20rpx; background: var(--o-tint); color: var(--o-txt); font-size: 26rpx; line-height: 1.7; }
.segment { padding: 20rpx 0; border-bottom: 1rpx solid var(--line); }
.reading-text { display: block; white-space: pre-wrap; word-break: break-all; font-size: 30rpx; line-height: 1.9; }
.loc { display: block; margin-bottom: 12rpx; font-size: 24rpx; }
.table { display: inline-block; min-width: 100%; }
.table-row { display: flex; }
.cell { flex: 1; min-width: 220rpx; padding: 16rpx; border: 1rpx solid var(--line); font-size: 26rpx; white-space: pre-wrap; word-break: break-all; }
.pagination, .actions { display: flex; align-items: center; gap: 20rpx; margin-top: 28rpx; }
.pagination button, .actions button { flex: 1; font-size: 26rpx; }

.cell-head { font-weight: 600; background: var(--fill); }
