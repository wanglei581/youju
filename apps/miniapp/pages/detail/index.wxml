<notice-bar />
<view wx:if="{{error}}" class="card empty">{{error}}</view>
<block wx:if="{{doc}}">
  <view class="card head">
    <view class="tags">
      <text wx:for="{{doc.tags}}" wx:key="*this" class="tag tag--{{tagClasses[index]}}">{{item}}</text>
      <text class="region">{{doc.region}}</text>
    </view>
    <view class="title">{{doc.title}}</view>
    <view class="pub">{{doc.issuer}} · {{doc.date}} 发布</view>
    <view wx:if="{{doc.kind === '名单'}}" class="weak status-note">名单状态按标题用词标注，公示期和当前效力以原文为准</view>
  </view>

  <view wx:if="{{due}}" class="card due-card">
    <view class="due-top">
      <view>
        <view class="due-label">{{doc.deadline.label}}</view>
        <view class="due-date-row"><text class="due-date">{{dueDate}}</text><text class="due-week">{{dueWeek}}</text></view>
      </view>
      <text class="left-pill left-pill--{{due.tone || 'normal'}}">{{due.days < 0 ? '已截止' : '剩 ' + due.days + ' 天'}}</text>
    </view>
    <view class="due-notes"><view wx:for="{{doc.deadline.notes}}" wx:key="*this">{{item}}</view></view>
    <view wx:if="{{due.days >= 3}}" class="remind {{reminded ? 'remind--on' : ''}}" bindtap="toggleRemind">
      <t-icon name="notification" size="34rpx" />
      <text>{{reminded ? '已订阅：截止前 3 天用微信提醒你一次' : '订阅截止提醒'}}</text>
    </view>
  </view>
  <view wx:elif="{{doc.kind === '申报通知' && !changes.length}}" class="card due-card">
    <view class="due-label">申报截止</view>
    <view class="due-unverified">截止时间见原文</view>
  </view>

  <view wx:if="{{changes.length}}" class="card change-card">
    <view wx:for="{{changes}}" wx:key="index" class="change-item" data-id="{{item.newDocId}}" bindtap="openNew" aria-role="{{item.newDocId ? 'link' : 'text'}}">
      <view class="change-text">原定{{item.label}} {{item.dateText}} 已{{item.reason}}<text wx:if="{{item.newDocId}}">，以新通知为准</text></view>
      <view wx:if="{{item.newTitle}}" class="change-new">{{item.newTitle}} ›</view>
    </view>
  </view>

  <view class="card">
    <view class="section-title">要点</view>
    <view wx:for="{{doc.points}}" wx:key="index" class="kv {{index === doc.points.length - 1 ? 'kv--last' : ''}}">
      <text class="k">{{item[0]}}</text><text class="v">{{item[1]}}</text>
    </view>
  </view>

  <view wx:if="{{doc.excerpt}}" class="card">
    <view class="section-title">原文摘录<text class="weak excerpt-sec">{{doc.excerpt.section}}</text></view>
    <view class="excerpt">“{{doc.excerpt.text}}”</view>
  </view>

  <view wx:if="{{doc.attachments.length}}" class="card">
    <view class="section-title">附件 {{doc.attachments.length}}</view>
    <view wx:for="{{doc.attachments}}" wx:key="name" class="att">
      <text class="att-ext att-ext--{{item.ext}}">{{item.ext}}</text>
      <text class="att-name">{{item.name}}</text>
    </view>
    <view class="att-foot">
      <text>附件在原文页面下载</text>
      <view class="copy" bindtap="copy"><t-icon name="copy" size="28rpx" />复制原文链接</view>
    </view>
  </view>

  <view class="card source">
    <view class="source-top">
      <view>
        <view class="weak source-label">原文出处</view>
        <view class="source-site">{{doc.site || doc.issuer}}</view>
      </view>
      <view class="copy copy--big" bindtap="copy"><t-icon name="copy" size="30rpx" />复制原文链接</view>
    </view>
    <view class="source-note">原文网址 {{doc.host || ''}}。小程序内不能直接打开政府网站，复制链接后在浏览器打开。<text wx:if="{{doc.checked}}">以上要点由有据按原文逐条整理，以原文为准，{{doc.checked}} 核对。</text>申报请在主管部门的申报系统办理；有据是第三方整理的信息工具，不是政府平台，不提供填报入口。</view>
  </view>
  <view style="height: 220rpx"></view>

  <view class="bar">
    <view class="bar-item" bindtap="exportDoc"><t-icon name="download" size="44rpx" /><text>导出</text></view>
    <view class="bar-item" bindtap="feedback"><t-icon name="flag" size="44rpx" /><text>纠错</text></view>
    <view class="btn-primary bar-main" bindtap="copy"><t-icon name="copy" size="32rpx" color="#FFFFFF" />复制原文链接</view>
  </view>
</block>
