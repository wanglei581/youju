<notice-bar />
<view wx:if="{{error}}" class="card load-error"><text>{{error}}</text><text wx:if="{{takenDown}}" class="link retry" bindtap="goBack">返回</text><text wx:else class="link retry" bindtap="load">重试</text></view>
<!-- 加载中：灰色占位块占住标题和要点的位置 -->
<view wx:if="{{!error && (loading || !doc)}}" aria-label="正在加载">
  <view class="card head">
    <view class="sk-head"><view class="sk sk-tag"></view><view class="sk sk-chip"></view></view>
    <view class="sk sk-title"></view>
    <view class="sk sk-title sk-line--short"></view>
    <view class="sk sk-meta"></view>
  </view>
  <view class="card sk-card">
    <view class="sk sk-section"></view>
    <view wx:for="{{[1, 2, 3]}}" wx:key="*this" class="sk sk-line"></view>
  </view>
</view>
<view wx:if="{{loading && serviceStarting}}" class="muted startup-note">正在连接，比平时慢一点，请稍等…</view>
<block wx:if="{{doc && !loading}}">
  <view class="card head">
    <view class="tags">
      <text wx:for="{{doc.tags}}" wx:key="*this" class="tag tag--{{tagClasses[index]}}">{{item}}</text>
      <text wx:if="{{doc.category}}" class="tag tag--cat">{{doc.category}}</text>
      <text wx:if="{{doc.status}}" class="tag">发布阶段：{{doc.status}}</text>
      <text class="region">{{regionText || doc.region}}</text>
    </view>
    <view class="title">{{doc.title}}</view>
    <view class="pub">{{doc.issuer}} · {{doc.date}} 发布</view>
    <!-- 能解读时的一行提示（D-075，组件里判断显不显示）：点了滚到"要点"下面的卡片，卡片位置不动 -->
    <ai-hint doc-id="{{doc.id}}" doc-title="{{doc.title}}" issuer="{{doc.issuer}}" date="{{doc.date}}" ai="{{doc.ai}}" bind:jump="toAi" />
    <!-- 原文链接已失效（youju/link_check.py）：放在标题下面先说（失效了就不能再解读，和上面那行提示不会同时出现），下面的要点、正文都是之前收录的 -->
    <view wx:if="{{doc.link_gone}}" class="gone-note">原文链接已失效（{{doc.link_gone}} 检查时打不开，原网页可能已撤下或改了地址）。下面的要点和截止是之前收录的，通知可能已撤回或更正，请以发文机关现在公布的为准；正文和附件不再提供。</view>
    <view class="weak status-note">类型、类别和发布阶段按标题归类，仅供检索参考，非官方分类</view>
  </view>

  <!-- 首发版（D-061）：按类型逐条写截止。核对过的标"已核对"；机器摘录的标"机器摘录·未经人工核对"并附原句；其余写"截止未核对" -->
  <view wx:if="{{dls && dls.length}}" class="card due-card">
    <view class="dls-head"><text class="due-label">截止时间</text><text class="weak">以原文为准</text></view>
    <view wx:for="{{dls}}" wx:key="kind" class="dl {{index ? 'dl--line' : ''}}">
      <view class="due-top">
        <view>
          <view class="due-label">{{item.kind}}</view>
          <view wx:if="{{item.dateText}}" class="due-date-row"><text class="due-date">{{item.dateText}}</text><text class="due-week">{{item.week}}</text></view>
          <view wx:else class="due-unverified">截止未核对，请以原文为准</view>
        </view>
        <text wx:if="{{item.dateText}}" class="left-pill left-pill--{{item.tone}}">{{item.days < 0 ? '已截止' : item.days === 0 ? '今天截止' : '剩 ' + item.days + ' 天'}}</text>
      </view>
      <text wx:if="{{item.label}}" class="src src--{{item.source}}">{{item.label}}</text>
      <view wx:if="{{item.quote}}" class="dl-quote">原文：{{item.quote}}</view>
    </view>
    <!-- 转发合并的通知（D-055）：上面的日期只是本页这一版的，别的地方的版本截止可能不同（10/22 走查） -->
    <view wx:if="{{versions.length}}" class="weak ver-hint">上面这一栏只对应本页这一版{{versionLabel ? '（' + versionLabel + '）' : ''}}；同一通知其他地方的版本，截止看下面“各版本的截止”</view>
    <view wx:if="{{due && loginOpen && remindOpen && due.days >= 3}}" class="remind {{reminded ? 'remind--on' : ''}}" bindtap="toggleRemind">
      <t-icon name="notification" size="34rpx" />
      <text>{{reminded ? '已订阅：截止前 3 天用微信提醒你一次' : '订阅截止提醒（一次）'}}</text>
    </view>
  </view>
  <view wx:elif="{{due}}" class="card due-card">
    <view class="due-top">
      <view>
        <view class="due-label">{{doc.deadline.label}}</view>
        <view class="due-date-row"><text class="due-date">{{dueDate}}</text><text class="due-week">{{dueWeek}}</text></view>
      </view>
      <text class="left-pill left-pill--{{due.tone || 'normal'}}">{{due.days < 0 ? '已截止' : due.days === 0 ? '今天截止' : '剩 ' + due.days + ' 天'}}</text>
    </view>
    <view class="due-notes"><view wx:for="{{doc.deadline.notes}}" wx:key="*this">{{item}}</view></view>
    <!-- 转发合并的通知（D-055）：上面的日期只是本页这一版的，别的地方的版本截止可能不同（10/22 走查） -->
    <view wx:if="{{versions.length}}" class="weak ver-hint">上面这一栏只对应本页这一版{{versionLabel ? '（' + versionLabel + '）' : ''}}；同一通知其他地方的版本，截止看下面“各版本的截止”</view>
    <view wx:if="{{loginOpen && remindOpen && due.days >= 3}}" class="remind {{reminded ? 'remind--on' : ''}}" bindtap="toggleRemind">
      <t-icon name="notification" size="34rpx" />
      <text>{{reminded ? '已订阅：截止前 3 天用微信提醒你一次' : '订阅截止提醒（一次）'}}</text>
    </view>
  </view>
  <view wx:elif="{{dueNote && !changes.length}}" class="card due-card">
    <view class="due-label">申报截止</view>
    <view class="due-unverified">{{dueNote}}</view>
  </view>

  <view wx:if="{{changes.length}}" class="card change-card">
    <view wx:for="{{changes}}" wx:key="index" class="change-item" data-id="{{item.newDocId}}" bindtap="openNew" aria-role="{{item.newDocId ? 'link' : 'text'}}">
      <view class="change-text">原定{{item.label}} {{item.dateText}} 已{{item.reason}}<text wx:if="{{item.newDocId}}">，以新通知为准</text></view>
      <view wx:if="{{item.newTitle}}" class="change-new">{{item.newTitle}} ›</view>
    </view>
  </view>

  <!-- 转发版本（D-055）：同一份部里通知的各地版本，截止按版本列出、各自核对，不同版本的日期不互相套用；
       点一行打开那一版自己的详情，原文链接也是那一版自己的 -->
  <view wx:if="{{versions.length}}" class="card ver-card">
    <view class="section-title">各版本的截止</view>
    <view wx:if="{{upstream}}" class="ver-upstream">{{upstream}}</view>
    <view wx:for="{{versions}}" wx:key="id" class="ver" data-id="{{item.id}}" data-current="{{item.current}}" bindtap="openVersion" aria-role="{{item.current ? 'text' : 'link'}}" aria-label="{{item.label}}：{{item.deadline}}">
      <view class="ver-top">
        <text class="ver-label">{{item.label}}</text>
        <text wx:if="{{item.current}}" class="ver-here">本页</text>
        <view wx:if="{{!item.current}}" class="ver-go"><t-icon name="chevron-right" size="28rpx" color="#86909C" /></view>
      </view>
      <view class="ver-due {{item.verified ? '' : 'ver-due--none'}}">{{item.deadline}}</view>
      <view class="ver-meta">
        <text class="ver-meta-text">{{item.meta}}</text>
      </view>
    </view>
    <view class="weak ver-note">各版本的截止日期、报送要求可能不同，以各自原文为准</view>
  </view>

  <view class="card">
    <view class="section-title">要点</view>
    <view wx:for="{{doc.points}}" wx:key="index" class="kv {{index === doc.points.length - 1 ? 'kv--last' : ''}}">
      <text class="k">{{item[0]}}</text><text class="v">{{item[1]}}</text>
    </view>
  </view>

  <!-- 解读入口卡片（10/17 取代右下角浮动按钮）：只有白名单（capabilities.ai_advisor.enabled）或正式开放后才渲染，其余用户不渲染任何内容；做不了的文件写明原因 -->
  <view id="ai-entry"><ai-entry blocked="{{!doc}}" doc-id="{{doc.id}}" doc-title="{{doc.title}}" doc-url="{{doc.url}}" has-attachments="{{atts.length > 0}}" ai="{{doc.ai}}" body-status="{{doc.body ? doc.body.status : ''}}" body-total="{{doc.body && doc.body.total ? doc.body.total : 0}}" bind:attachments="toAttachments" /></view>

  <view wx:if="{{doc.excerpt}}" class="card">
    <view class="section-title">原文摘录<text class="weak excerpt-sec">{{doc.excerpt.section}}</text></view>
    <view class="excerpt">“{{doc.excerpt.text}}”</view>
  </view>

  <view wx:if="{{doc.fields && doc.fields.support && doc.fields.support.length}}" class="card support-card">
    <view class="section-title">支持方式<text class="weak excerpt-sec">已核对原文</text></view>
    <view class="support-tags">
      <view wx:for="{{doc.fields.support}}" wx:key="*this" class="support-tag {{supportExpanded === item ? 'support-tag--on' : ''}}" data-label="{{item}}" bindtap="toggleSupport">{{item}}</view>
    </view>
    <view wx:if="{{supportExpanded && supportEvidence}}" class="support-evidence"><text class="support-evidence-label">原文：</text>{{supportEvidence}}</view>
  </view>

  <view wx:if="{{doc.fields && doc.fields.audience && doc.fields.audience.text}}" class="card audience-card">
    <view class="section-title">申报对象（原文摘录）</view>
    <view class="audience-text">{{doc.fields.audience.text}}</view>
    <view class="weak audience-note">条件可能未列全，以原文为准</view>
  </view>

  <!-- 申报条件：只显示人工逐条核对、整份确认过的条目；每条是类别和通知原文里的原句（逐字引用），不显示概括的说法；不作能否申报的判断 -->
  <view wx:if="{{conds.length}}" class="card cond-card">
    <view class="section-title">申报条件<text class="weak excerpt-sec">（已核对原文）</text></view>
    <view wx:for="{{conds}}" wx:key="index" class="cond">
      <text class="cond-cat">{{item.showCat ? item.category : ''}}</text>
      <text class="cond-text" user-select>{{item.quote}}</text>
    </view>
    <view class="weak cond-note">条件以原文为准，不作为能否申报的判断</view>
  </view>

  <!-- 正文（D-097）：不满一屏的全部显示（"全文如下"），长的显示开头、在段末停（"下面是开头，全文约 N 字"）；
       正文下面和底栏两处同名的入口去同一页（阅读全文 / 阅读附件），都读不了时不显示。标题里写明是自动提取、没逐字核对 -->
  <view wx:if="{{doc.body}}" id="body" class="card">
    <view class="section-title">正文<text wx:if="{{bodyView}}">（自动提取，未经人工逐字核对）</text></view>
    <view wx:if="{{bodySummary}}" class="weak body-summary">{{bodySummary}}</view>
    <block wx:if="{{bodyView}}">
      <view class="weak body-note">从原网页或 PDF 提取<text wx:if="{{dueDated}}">；截止日期可先看上面的“截止时间”</text>，一切以原文为准。</view>
      <view class="body-label">{{bodyView.label}}</view>
      <text class="body-text" user-select>{{bodyView.text}}</text>
      <!-- 名单类通知：正文里的名单没展开（D-092），给去查名单的入口 -->
      <view wx:if="{{doc.body.listHidden}}" class="link body-lookup" bindtap="toLists" aria-role="button">名单请在“查名单”里按企业名称查询 ›</view>
    </block>
    <block wx:else>
      <view class="body-none">{{noBody}}</view>
      <view wx:if="{{doc.body.status === 'list'}}" class="link body-lookup" bindtap="toLists" aria-role="button">在“查名单”里按企业名称查询 ›</view>
    </block>
    <view wx:if="{{entry}}" id="read-entry" class="link body-more" bindtap="readBody" aria-role="button">{{entry.label}} ›</view>
  </view>

  <!-- 附件紧跟正文：每个直接写能不能读（和阅读页同一个判断）；能读的写"阅读"可点，读不了的灰色、不能点、写原因 -->
  <view wx:if="{{atts.length}}" id="attachments" class="card">
    <view class="section-title">附件 {{atts.length}}</view>
    <view wx:for="{{atts}}" wx:key="index" id="att-{{index}}" class="att {{item.canOpen ? '' : 'att--off'}}" hover-class="{{item.canOpen ? 'att--pressed' : 'none'}}" data-index="{{index}}" bindtap="openAttachment" aria-role="{{item.canOpen ? 'button' : 'text'}}" aria-disabled="{{!item.canOpen}}">
      <text class="att-ext att-ext--{{item.ext}}">{{item.ext}}</text>
      <view class="att-body">
        <text class="att-name">{{item.name}}</text>
        <text wx:if="{{item.meta}}" class="att-meta">{{item.meta}}</text>
      </view>
      <text wx:if="{{item.canOpen}}" class="att-action att-action--open">{{item.action}}</text>
    </view>
    <view wx:if="{{attNote}}" class="att-foot">
      <text>{{attNote}}</text>
    </view>
  </view>

  <view class="card source">
    <!-- 出处只写来源网站名称、发文机关、日期，不写网址（D-097：网址文字有被认为引导外跳的风险；10/23 审核退回过"复制链接去浏览器"） -->
    <view class="weak source-label">原文出处</view>
    <view class="source-site">{{doc.site || doc.issuer}}</view>
    <view class="source-meta">发文机关：{{doc.issuer}}<text wx:if="{{doc.date}}">　发布日期：{{doc.date}}</text></view>
    <view wx:if="{{doc.link_gone}}" class="source-gone">原网页 {{doc.link_gone}} 检查时已打不开。</view>
    <view class="source-note"><text wx:if="{{doc.checked}}">以上要点由有据按原文逐条整理，以原文为准，{{doc.checked}} 核对。</text>申报请在主管部门的申报系统办理，有据不提供填报入口。</view>
  </view>
  <view style="height: 220rpx"></view>

  <view class="bar">
    <view class="bar-item" bindtap="exportDoc"><t-icon name="download" size="44rpx" /><text>结果</text></view>
    <view wx:if="{{loginOpen}}" class="bar-item" bindtap="feedback"><t-icon name="flag" size="44rpx" /><text>纠错</text></view>
    <!-- 10/18 验收：只能从右上角"···"转发时，园区专员找不到；按钮和菜单走同一个 onShareAppMessage -->
    <button class="bar-item bar-share" open-type="share" disabled="{{!shareReady}}" hover-class="none" aria-label="转发给好友或群"><t-icon name="share" size="44rpx" /><text>转发</text></button>
    <view wx:if="{{entry}}" id="bar-read" class="btn-primary bar-main" bindtap="readBody"><t-icon name="file" size="32rpx" color="#FFFFFF" />{{entry.label}}</view>
  </view>
</block>
