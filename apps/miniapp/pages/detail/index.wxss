.head { padding-top: 32rpx; padding-bottom: 32rpx; }
.tags { display: flex; flex-wrap: wrap; align-items: center; gap: 12rpx; }
/* 项目类别：按标题归类、仅供检索参考，用描边和类型标签区分开 */
.tag--cat { border: 2rpx solid var(--line2); color: var(--t2); line-height: 36rpx; font-weight: 400; }
.region { font-size: 24rpx; color: var(--t2); line-height: 40rpx; }
.title { margin-top: 20rpx; font-size: 40rpx; line-height: 60rpx; font-weight: 700; }
.pub { margin-top: 20rpx; font-size: 26rpx; color: var(--t2); }

.due-card { padding-top: 32rpx; padding-bottom: 32rpx; }
.due-top { display: flex; align-items: flex-end; justify-content: space-between; }
.due-label { font-size: 24rpx; color: var(--t2); }
.due-date-row { margin-top: 4rpx; display: flex; align-items: baseline; gap: 16rpx; }
.due-date { font-size: 48rpx; font-weight: 700; line-height: 1.25; }
.due-week { font-size: 26rpx; color: var(--t2); }
.left-pill { height: 52rpx; padding: 0 20rpx; display: flex; align-items: center; border-radius: 26rpx; font-size: 26rpx; font-weight: 600; }
.left-pill--normal { background: var(--brand-tint); color: var(--brand); }
.left-pill--soon { background: var(--brand-tint); color: var(--red); }
.left-pill--urgent { background: var(--r-tint); color: var(--red); }
.left-pill--past { background: var(--fill); color: var(--t3); }
.due-notes { margin-top: 20rpx; padding-top: 20rpx; border-top: 2rpx solid var(--line); font-size: 26rpx; line-height: 1.7; color: var(--t2); }
.due-unverified { margin-top: 8rpx; font-size: 30rpx; color: var(--t1); }
.change-card { padding-top: 24rpx; padding-bottom: 24rpx; background: var(--o-tint); }
.change-item + .change-item { margin-top: 20rpx; padding-top: 20rpx; border-top: 2rpx solid rgba(217, 100, 15, 0.15); }
.change-text { font-size: 28rpx; font-weight: 600; color: var(--o-txt); }
.change-new { margin-top: 8rpx; font-size: 26rpx; line-height: 1.6; color: var(--brand); }
.remind { margin-top: 24rpx; min-height: 84rpx; padding: 12rpx 24rpx; box-sizing: border-box; display: flex; align-items: center; justify-content: center; gap: 12rpx; border-radius: 42rpx; border: 2rpx solid var(--brand); color: var(--brand); font-size: 28rpx; font-weight: 500; }
.remind--on { background: var(--fill); border-color: var(--fill); color: var(--t2); }

.kv { display: flex; gap: 24rpx; padding: 24rpx 0; border-bottom: 2rpx solid var(--line); font-size: 28rpx; line-height: 1.6; }
.kv--last { border-bottom: 0; padding-bottom: 32rpx; }
.k { flex-shrink: 0; min-width: 144rpx; max-width: 45%; color: var(--t3); }
.v { flex: 1; color: var(--t1); }

.excerpt-sec { font-size: 24rpx; font-weight: 400; }
.excerpt { margin: 12rpx 0 32rpx; padding: 24rpx 28rpx; background: #F7F8FA; border-radius: 16rpx; font-size: 28rpx; line-height: 1.8; }
.support-tags { display: flex; flex-wrap: wrap; gap: 12rpx; }
.support-tag { min-height: 48rpx; padding: 8rpx 16rpx; box-sizing: border-box; display: flex; align-items: center; border: 2rpx solid var(--line); border-radius: 8rpx; color: var(--t1); font-size: 26rpx; line-height: 1.5; }
.support-tag--on { border-color: var(--brand); background: var(--brand-tint); color: var(--brand); }
.support-evidence { margin-top: 20rpx; padding: 20rpx 24rpx; background: #F7F8FA; border-radius: 12rpx; color: var(--t2); font-size: 26rpx; line-height: 1.7; }
.support-evidence-label { color: var(--t3); }
.audience-text { margin-top: 12rpx; font-size: 28rpx; line-height: 1.8; color: var(--t1); }
.audience-note { margin-top: 12rpx; font-size: 24rpx; line-height: 1.6; }
/* 申报条件：左列类别（同类连着的只写一次），右侧是通知原文里的原句 */
.cond { display: flex; align-items: flex-start; gap: 20rpx; padding: 20rpx 0; border-bottom: 2rpx solid var(--line); font-size: 28rpx; line-height: 1.6; }
.cond-cat { flex-shrink: 0; width: 112rpx; font-size: 24rpx; line-height: 44.8rpx; color: var(--t3); }
.cond-text { flex: 1; min-width: 0; color: var(--t1); }
.cond-note { padding-top: 20rpx; font-size: 24rpx; line-height: 1.6; }

.att { display: flex; align-items: center; gap: 24rpx; padding: 24rpx 0; border-bottom: 2rpx solid var(--line); }
.att--pressed { opacity: 0.6; }
.att-ext { width: 72rpx; height: 72rpx; flex-shrink: 0; border-radius: 16rpx; display: flex; align-items: center; justify-content: center; font-size: 20rpx; font-weight: 700; background: var(--fill); color: var(--t2); }
.att-ext--PDF { background: var(--r-tint); color: var(--red); }
.att-ext--XLSX, .att-ext--XLS { background: var(--g-tint); color: var(--g-txt); }
.att-ext--DOC, .att-ext--DOCX { background: var(--brand-tint); color: var(--brand); }
.att-ext--PPT, .att-ext--PPTX { background: var(--o-tint); color: var(--o-txt); }
.att-body { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 4rpx; }
.att-name { font-size: 28rpx; line-height: 1.5; }
.att-meta { font-size: 24rpx; line-height: 1.5; color: var(--t3); }
.att-action { flex-shrink: 0; font-size: 26rpx; color: var(--t3); }
.att-action--open { color: var(--brand); font-weight: 500; }
.att-foot { display: flex; align-items: center; padding: 22rpx 0 24rpx; font-size: 25rpx; color: var(--t2); }

.source { padding-top: 28rpx; padding-bottom: 28rpx; }
.source-top { display: flex; align-items: center; justify-content: space-between; }
.source-label { font-size: 24rpx; }
.source-site { margin-top: 4rpx; font-size: 28rpx; }
.source-note { margin-top: 20rpx; font-size: 24rpx; line-height: 1.7; color: var(--t2); }
.source-gone { margin-top: 20rpx; font-size: 26rpx; line-height: 1.7; color: var(--orange); }
.gone-note { margin-top: 20rpx; padding: 16rpx 24rpx; background: var(--o-tint); color: var(--o-txt); border-radius: 12rpx; font-size: 26rpx; line-height: 1.7; }

.bar { position: fixed; left: 0; right: 0; bottom: 0; padding: 16rpx 32rpx calc(16rpx + env(safe-area-inset-bottom)); display: flex; align-items: center; gap: 8rpx; background: var(--card); border-top: 2rpx solid var(--line); }
.bar-item { width: 100rpx; height: 96rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 2rpx; font-size: 22rpx; color: var(--t2); }
.bar-main { margin-left: auto; padding: 0 44rpx; }
/* 转发是 button（open-type="share"）：去掉按钮自带的边距、背景和边框，和旁边两项一样；微信新版按钮样式要加 !important 才压得住 */
.bar-share { width: 100rpx !important; min-height: 0 !important; margin: 0 !important; padding: 0 !important; background: transparent !important; border-radius: 0 !important; line-height: normal !important; font-size: 22rpx !important; font-weight: normal !important; color: var(--t2) !important; }
.bar-share::after { border: none; }
.status-note { margin-top: 12rpx; font-size: 24rpx; }
/* 正文（D-030）：默认显示开头一段，点"展开全文"看全部 */
.body-note { margin: -4rpx 0 16rpx; font-size: 22rpx; line-height: 1.6; }
.body-text { display: block; font-size: 28rpx; line-height: 1.8; color: var(--t1); white-space: pre-wrap; word-break: break-all; }
.body-more { margin-top: 16rpx; font-size: 26rpx; }
.body-rest { margin-top: 12rpx; font-size: 24rpx; }
.body-none { font-size: 26rpx; line-height: 1.6; }
/* 加载中的占位块 */
.sk-title { height: 40rpx; margin-top: 22rpx; }
.sk-card { padding-top: 28rpx; padding-bottom: 28rpx; }
.sk-section { width: 112rpx; height: 32rpx; }
/* 转发版本（D-055）：各版本的截止按版本列出 */
.ver-card { padding-bottom: 8rpx; }
.ver-upstream { margin: 8rpx 0 4rpx; padding: 16rpx 20rpx; background: #F7F8FA; border-radius: 12rpx; font-size: 25rpx; line-height: 1.7; color: var(--t2); }
.ver { padding: 22rpx 0; border-bottom: 2rpx solid var(--line); }
.ver-top { display: flex; align-items: center; gap: 12rpx; }
.ver-label { font-size: 28rpx; font-weight: 600; color: var(--t1); }
.ver-here { padding: 0 10rpx; border-radius: 6rpx; background: var(--brand-tint); color: var(--brand); font-size: 22rpx; line-height: 36rpx; }
.ver-go { margin-left: auto; display: flex; align-items: center; }
.ver-due { margin-top: 6rpx; font-size: 28rpx; line-height: 1.6; color: var(--t1); }
.ver-due--none { color: var(--t3); }
.ver-meta { margin-top: 6rpx; display: flex; align-items: flex-start; gap: 16rpx; font-size: 24rpx; line-height: 1.6; color: var(--t2); }
.ver-meta-text { flex: 1; min-width: 0; }
.ver-note { padding: 20rpx 0; font-size: 24rpx; line-height: 1.6; }
.standard-link { display: flex; align-items: center; justify-content: space-between; padding: 24rpx 0 0; font-size: 26rpx; }
/* 按类型逐条的截止（D-061） */
.dls-head { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 8rpx; }
.dl { padding-top: 20rpx; display: flex; flex-direction: column; gap: 10rpx; }
.dl--line { margin-top: 20rpx; border-top: 2rpx solid var(--line); }
.src { align-self: flex-start; padding: 4rpx 12rpx; border-radius: 8rpx; font-size: 22rpx; font-weight: 600; }
.src--verified { background: var(--g-tint); color: var(--g-txt); }
.src--excerpt { background: var(--fill); color: var(--t2); }
.dl-quote { padding: 12rpx 16rpx; border-radius: 10rpx; background: var(--fill); font-size: 26rpx; line-height: 1.7; color: var(--t2); }
