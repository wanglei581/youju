.sticky-head { position: sticky; top: 0; z-index: 5; background: var(--bg); padding: 16rpx 24rpx 0; }
.tabs { display: grid; grid-template-columns: repeat(2, 1fr); gap: 12rpx; }
.tab { padding: 16rpx 12rpx; border-radius: 12rpx; background: var(--card); color: var(--t2); font-size: 24rpx; text-align: center; border: 2rpx solid var(--line2); }
.tab--on { color: var(--brand); background: var(--brand-tint); border-color: var(--brand); }
.reading-note { padding: 20rpx 8rpx; color: var(--t2); font-size: 24rpx; }
.basis { padding-bottom: 24rpx; }
.document-title { font-weight: 500; margin: 12rpx 0 20rpx; }
.meta { margin-top: 10rpx; color: var(--t2); font-size: 26rpx; }
.copy { padding: 24rpx 0; }
.source-notes { border-top: 2rpx solid var(--line); }
.source-note { display: block; margin-top: 20rpx; color: var(--t2); font-size: 26rpx; white-space: pre-wrap; overflow-wrap: break-word; }
.condition { display: flex; gap: 20rpx; padding: 28rpx 0; border-bottom: 2rpx solid var(--line); align-items: flex-start; }
.condition:last-child { border-bottom: 0; }
.check-box { width: 40rpx; height: 40rpx; border: 2rpx solid var(--line2); border-radius: 8rpx; flex-shrink: 0; display: flex; align-items: center; justify-content: center; }
.check-box--on { background: var(--brand); border-color: var(--brand); }
.condition-main { flex: 1; min-width: 0; }
.ref { color: var(--brand); font-size: 24rpx; margin-bottom: 12rpx; }
.original { white-space: pre-wrap; overflow-wrap: break-word; }
.clear { margin: 24rpx; padding: 24rpx; text-align: center; background: var(--card); border-radius: 16rpx; }
.message { padding: 24rpx 32rpx; }
.page-bottom { height: calc(48rpx + env(safe-area-inset-bottom)); }
