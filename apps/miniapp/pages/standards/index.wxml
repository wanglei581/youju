<notice-bar />
<view class="sticky-head">
  <view class="tabs" aria-role="tablist" aria-label="选择资质">
    <view wx:for="{{tabs}}" wx:key="key" class="tab {{active === item.key ? 'tab--on' : ''}}" data-key="{{item.key}}" bindtap="pickTab" aria-role="tab" aria-selected="{{active === item.key}}">{{item.name}}</view>
  </view>
  <view class="reading-note">本页仅供对照国家认定条件原文阅读，勾选只保存在本机，不构成任何认定建议；各地另有细则和年度通知，以主管部门当期文件为准。</view>
</view>
<view wx:if="{{error}}" class="card message">{{error}}<text class="link" bindtap="restore">　重试</text></view>
<view class="card basis">
  <view class="section-title">依据</view>
  <view class="document-title" user-select>{{standard.document.title}}</view>
  <view class="meta" user-select>文号：{{standard.document.number}}</view>
  <view class="meta" user-select>发文机关：{{standard.document.issuer}}</view>
  <view class="meta">印发日期：{{standard.document.issued}}</view>
  <view class="meta">施行日期：{{standard.document.effective || '自发布之日起实施（未明示具体日期）'}}</view>
  <view class="meta">核对日期 {{standard.verified_on}}</view>
  <view class="copy link" bindtap="copyOriginal" aria-role="button">复制原文链接</view>
  <view class="source-notes"><text wx:for="{{standard.notes}}" wx:key="index" class="source-note" user-select>{{item}}</text></view>
</view>
<view class="card conditions">
  <view class="section-title">条件原文</view>
  <view wx:for="{{rows}}" wx:key="ref" class="condition" data-index="{{index}}" bindtap="toggle" aria-role="checkbox" aria-checked="{{item.checked}}" aria-label="{{item.ref}}">
    <view class="check-box {{item.checked ? 'check-box--on' : ''}}"><t-icon wx:if="{{item.checked}}" name="check" size="28rpx" color="#FFFFFF" /></view>
    <view class="condition-main"><view class="ref">{{item.ref}}</view><text class="original" user-select>{{item.text}}</text></view>
  </view>
</view>
<view class="clear link" bindtap="clearChecks" aria-role="button">清空勾选</view>
<view class="page-bottom"></view>
