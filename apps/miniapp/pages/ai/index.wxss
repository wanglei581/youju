.top { padding: 0 32rpx 72rpx; background: linear-gradient(180deg, var(--brand-g1) 0%, var(--brand-g2) 100%); color: #FFFFFF; }
.nav { display: flex; align-items: center; justify-content: center; }
.nav-title { font-size: 34rpx; font-weight: 600; }
.hero { margin-top: 16rpx; }
.hero-sub { font-size: 28rpx; line-height: 1.7; color: rgba(255, 255, 255, 0.92); }
.badge { display: inline-block; margin-top: 16rpx; padding: 2rpx 12rpx; border: 2rpx solid rgba(255, 255, 255, 0.4); border-radius: 8rpx; font-size: 23rpx; color: rgba(255, 255, 255, 0.88); }

/* 说明条：压在页头下沿，和首页入口那一块一样的白卡片 */
.strip { position: relative; margin: -40rpx 24rpx 0; padding: 0 28rpx; background: var(--card); border-radius: 24rpx; box-shadow: 0 4rpx 20rpx rgba(29, 33, 41, 0.05); }
.strip-row { min-height: 88rpx; display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.strip-tag { font-size: 26rpx; font-weight: 600; color: var(--t1); }
.strip-more { display: flex; align-items: center; gap: 4rpx; font-size: 26rpx; }
.strip-body { padding: 4rpx 0 24rpx; border-top: 2rpx solid var(--line); }
.strip-line { margin-top: 16rpx; font-size: 25rpx; line-height: 1.7; color: var(--t2); }

.abilities { padding-top: 12rpx; padding-bottom: 28rpx; }
/* 还没确认、没有说明条压着页头时，卡片照样压住页头下沿 */
.abilities--first { position: relative; margin-top: -40rpx; }
.ability { padding: 24rpx 0; display: flex; flex-wrap: wrap; align-items: center; gap: 12rpx 24rpx; border-bottom: 2rpx solid var(--line); }
.ability-main { flex: 1; min-width: 360rpx; display: flex; flex-direction: column; gap: 6rpx; }
.ability-name { font-size: 32rpx; font-weight: 600; color: var(--t1); }
.ability-desc { font-size: 25rpx; line-height: 1.6; color: var(--t2); }
.ability-left { flex-shrink: 0; font-size: 25rpx; color: var(--t2); white-space: nowrap; }
.ability-num { font-size: 32rpx; font-weight: 700; color: var(--brand); }
.ability--out .ability-name { color: var(--t3); }
.ability-out { width: 100%; font-size: 25rpx; line-height: 1.6; color: var(--t2); }
.gate { padding: 20rpx 0 4rpx; }
.gate-text { font-size: 28rpx; line-height: 1.7; color: var(--t1); }
.gate-btn { margin-top: 24rpx; }
.gate-link { margin-top: 16rpx; padding: 8rpx 0; font-size: 28rpx; }
.gate-contact { margin-top: 24rpx; }
.find { margin-top: 28rpx; min-height: 80rpx; display: flex; align-items: center; justify-content: center; border: 2rpx solid var(--brand); border-radius: 40rpx; background: var(--brand-tint); color: var(--brand); font-size: 28rpx; font-weight: 500; }

.card-head { min-height: 88rpx; display: flex; align-items: center; justify-content: space-between; border-bottom: 2rpx solid var(--line); }
.card-title { font-size: 30rpx; font-weight: 600; }
.card-more { display: flex; align-items: center; gap: 4rpx; font-size: 26rpx; }
.list-note { padding-top: 16rpx; font-size: 24rpx; color: var(--t3); }
.list-tip { padding: 40rpx 0; text-align: center; font-size: 26rpx; line-height: 1.7; color: var(--t2); }

.last { padding: 24rpx 0 8rpx; }
.last-title { font-size: 30rpx; font-weight: 600; line-height: 1.6; color: var(--t1); }
.last-meta { margin-top: 8rpx; font-size: 25rpx; color: var(--t2); }
.last-ops { padding: 16rpx 0 28rpx; display: flex; align-items: center; gap: 32rpx; }
.last-clause { font-size: 26rpx; }

.record { padding: 24rpx 0; display: flex; align-items: center; gap: 16rpx; border-bottom: 2rpx solid var(--line); }
.record--last { border-bottom: 0; }
.record-main { flex: 1; min-width: 0; }
.record-title { font-size: 28rpx; line-height: 1.6; color: var(--t1); overflow: hidden; text-overflow: ellipsis; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }
.record-meta { margin-top: 6rpx; font-size: 24rpx; color: var(--t3); }

.help { padding-bottom: 28rpx; }
.help-contact { margin-top: 24rpx; }
.help-links { margin-top: 24rpx; display: flex; justify-content: center; gap: 64rpx; font-size: 26rpx; }

.foot { padding: 36rpx 24rpx 0; text-align: center; font-size: 24rpx; line-height: 1.8; color: var(--t3); }
