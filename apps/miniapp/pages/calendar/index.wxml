<notice-bar />
<view wx:if="{{truncated}}" class="card load-error">未截止和已截止各最多显示 1000 条，统计和筛选仅基于这些事项。</view>
<view wx:if="{{loaded && !loading && !error}}" class="seg" aria-role="tablist">
  <view wx:for="{{ranges}}" wx:key="key" class="seg-item {{range === item.key && !sel && !monthOnly ? 'seg-item--on' : ''}}" data-key="{{item.key}}" bindtap="pickRange" aria-role="tab" aria-selected="{{range === item.key && !sel && !monthOnly}}">{{item.label}} {{counts[item.key]}}</view>
</view>
<view class="filters">
  <text class="today">今天 {{today}}</text>
  <text class="report-link" bindtap="openReport">截止雷达 ›</text>
</view>

<view wx:if="{{error}}" class="card load-error"><text>{{error}}</text><text class="link retry" bindtap="reload">重试</text></view>
<view wx:if="{{loading}}" class="card empty">正在加载…</view>
<block wx:if="{{loaded && !loading && !error}}">
<view class="card month">
  <view class="month-head">
    <view class="month-nav"><text class="arrow" data-step="-1" bindtap="shiftMonth" aria-role="button" aria-label="上个月">‹</text><text class="month-title">{{year}}年{{month}}月</text><text class="arrow" data-step="1" bindtap="shiftMonth" aria-role="button" aria-label="下个月">›</text></view>
  </view>
  <view class="week"><text wx:for="{{['一','二','三','四','五','六','日']}}" wx:key="*this">{{item}}</text></view>
  <view class="grid">
    <view wx:for="{{cells}}" wx:key="key" class="cell {{item.due ? 'cell--due' : ''}} {{sel && item.day === selDay ? 'cell--sel' : ''}}"
          data-day="{{item.day}}" data-due="{{item.due}}" bindtap="pickDay">
      <block wx:if="{{!item.blank}}">
        <text class="num {{item.weekend && !item.due ? 'num--weekend' : ''}}">{{item.day}}</text>
        <view class="dot {{item.due ? 'dot--on' : ''}} {{item.past ? 'dot--past' : ''}}"></view>
      </block>
    </view>
  </view>
  <view class="weak month-legend">蓝点：有申报截止，点日期只看当天；灰点：近 30 天已截止</view>
</view>

<view wx:if="{{monthOnly && !sel}}" class="sel-row">
  <text>只看 <text class="b">{{year}}年{{month}}月</text> 截止的事项</text>
  <text class="link" bindtap="showAll">显示全部</text>
</view>
<view wx:if="{{sel}}" class="sel-row">
  <text>只看 <text class="b">{{selLabel}}</text> 截止的事项</text>
  <text class="link" bindtap="clearSel">取消选择</text>
</view>

<view wx:if="{{!shown.length}}" class="card empty">
  <view class="empty-title">{{items.length ? '这个时间段没有截止的申报事项' : '暂时没有未截止的申报事项'}}</view>
  <view wx:if="{{nearest}}" class="muted empty-sub">最近的截止在 {{nearest.date}}，还有 {{nearest.days}} 天</view>
  <block wx:if="{{!items.length}}">
    <view class="muted empty-sub">{{verifyingNote}}</view>
    <view class="link empty-link" bindtap="goSearch" aria-role="link">去搜索申报通知 ›</view>
  </block>
</view>

<view wx:for="{{shown}}" wx:key="id" class="card item">
  <view class="item-top">
    <text class="item-date">{{item.date}}</text>
    <text class="muted item-week">{{item.week}} {{item.time}}</text>
    <text class="pill pill--{{item.tone || 'normal'}}">{{item.days === 0 ? '今天截止' : '剩 ' + item.days + ' 天'}}</text>
  </view>
  <view class="item-body">
    <view class="item-main" data-id="{{item.docId}}" data-has="{{item.hasDetail}}" bindtap="open">
      <view class="item-tags"><text class="tag tag--apply">{{item.kind}}</text><text class="muted small">{{item.region}}</text></view>
      <view class="item-title">{{item.title}}</view>
      <view class="muted item-what">{{item.what}}</view>
    </view>
    <view wx:if="{{loginOpen && remindOpen}}" class="bell {{reminded[item.docId] ? 'bell--on' : ''}} {{item.days < 3 ? 'bell--off' : ''}}" data-id="{{item.id}}" data-days="{{item.days}}" bindtap="toggleRemind" aria-role="button" aria-label="设截止提醒">
      <t-icon name="notification" size="34rpx" />
    </view>
  </view>
</view>
<view wx:if="{{pastShown.length}}" class="card past">
  <view class="past-head" bindtap="togglePast" aria-role="button">
    <text>{{pastTitle}} {{pastShown.length}} 项</text>
    <t-icon name="{{pastOpen ? 'chevron-up' : 'chevron-down'}}" size="32rpx" color="#86909C" />
  </view>
  <block wx:if="{{pastOpen}}">
    <view wx:for="{{pastShown}}" wx:key="id" class="past-item" data-id="{{item.docId}}" data-has="{{item.hasDetail}}" bindtap="open">
      <view class="past-top"><text class="muted past-date">{{item.date}} {{item.week}}</text><text class="pill pill--past">已截止</text></view>
      <view class="past-title">{{item.title}}</view>
    </view>
  </block>
</view>
</block>
<view class="foot">只列人工核对过的截止时间，逐条取自原文。一个通知有多个截止时间时，按申报单位的截止时间排列，其余写在下方。申报请在主管部门的系统办理，有据不提供填报入口。</view>
<view style="height: 60rpx"></view>
