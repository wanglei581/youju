.seg { margin: 24rpx 24rpx 0; padding: 6rpx; display: grid; grid-template-columns: repeat(4, 1fr); gap: 6rpx; background: var(--card); border-radius: 38rpx; }
.seg-item { min-height: 64rpx; display: flex; align-items: center; justify-content: center; border-radius: 32rpx; font-size: 26rpx; color: var(--t2); }
.seg-item--on { background: var(--brand); color: #FFFFFF; font-weight: 500; }
.filters { margin: 20rpx 32rpx 0; display: flex; align-items: center; gap: 28rpx; font-size: 26rpx; }
.today { margin-left: auto; font-size: 24rpx; color: var(--t3); }
.report-link { color: var(--brand); font-size: 26rpx; }
.month { padding: 28rpx 32rpx 20rpx; }
.month-head { display: flex; align-items: baseline; justify-content: space-between; padding-bottom: 16rpx; }
.month-title { font-size: 32rpx; font-weight: 600; }
.month-hint { font-size: 24rpx; }
.week { display: grid; grid-template-columns: repeat(7, 1fr); text-align: center; font-size: 24rpx; color: var(--t3); padding-bottom: 8rpx; }
.grid { display: grid; grid-template-columns: repeat(7, 1fr); gap: 4rpx; }
.cell { height: 80rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 4rpx; border-radius: 20rpx; }
.cell--sel { box-shadow: inset 0 0 0 4rpx var(--brand); }
.num { font-size: 28rpx; color: var(--t2); }
.num--weekend { color: var(--t3); }
.cell--due .num { color: var(--t1); font-weight: 700; }
.dot { width: 10rpx; height: 10rpx; border-radius: 6rpx; background: transparent; }
.dot--on { background: var(--brand); }
.sel-row { margin: 24rpx 32rpx 0; display: flex; align-items: center; justify-content: space-between; font-size: 26rpx; color: var(--t2); }
.b { color: var(--t1); font-weight: 700; }
.empty { padding: 56rpx 32rpx; text-align: center; }
.empty-title { font-size: 32rpx; font-weight: 600; }
.empty-sub { margin-top: 12rpx; font-size: 26rpx; }
.item { padding: 28rpx 32rpx; }
.item-top { display: flex; align-items: center; gap: 16rpx; }
.item-date { font-size: 32rpx; font-weight: 700; }
.item-week { font-size: 26rpx; }
.pill { margin-left: auto; min-height: 44rpx; padding: 4rpx 16rpx; box-sizing: border-box; display: flex; align-items: center; border-radius: 22rpx; font-size: 24rpx; font-weight: 600; }
.pill--normal { background: var(--brand-tint); color: var(--brand); }
.pill--soon { background: var(--brand-tint); color: var(--red); }
.pill--urgent { background: var(--r-tint); color: var(--red); }
.item-body { margin-top: 20rpx; display: flex; gap: 24rpx; }
.item-main { flex: 1; min-width: 0; }
.item-tags { display: flex; align-items: center; gap: 12rpx; }
.small { font-size: 24rpx; }
.item-title { margin-top: 12rpx; font-size: 30rpx; font-weight: 600; line-height: 1.55; }
.item-what { margin-top: 10rpx; font-size: 25rpx; line-height: 1.6; }
.bell { width: 72rpx; height: 72rpx; flex-shrink: 0; display: flex; align-items: center; justify-content: center; border-radius: 36rpx; border: 2rpx solid var(--line2); color: var(--t2); background: var(--card); }
.bell--on { background: var(--brand); border-color: var(--brand); color: #FFFFFF; }
.foot { margin: 28rpx 32rpx 0; font-size: 24rpx; line-height: 1.7; color: var(--t3); }
.month-nav { display: flex; align-items: center; gap: 16rpx; }
.arrow { padding: 0 12rpx; font-size: 40rpx; color: var(--t2); line-height: 1; }
.bell--off { opacity: 0.4; }
.dot--past { background: var(--line2); }
.pill--past { background: var(--fill); color: var(--t3); }
.past { padding-bottom: 8rpx; }
.past-head { display: flex; align-items: center; justify-content: space-between; padding: 28rpx 0 20rpx; font-size: 28rpx; color: var(--t2); }
.past-item { padding: 20rpx 0; border-top: 2rpx solid var(--line); }
.past-top { display: flex; align-items: center; justify-content: space-between; }
.past-date { font-size: 24rpx; }
.past-title { margin-top: 8rpx; font-size: 28rpx; line-height: 1.5; color: var(--t2); }
.month-legend { padding: 8rpx 0 24rpx; font-size: 22rpx; text-align: center; }
