.top { padding-left: 32rpx; padding-right: 32rpx; padding-bottom: 28rpx; background: linear-gradient(180deg, var(--brand-g1) 0%, var(--brand-g2) 100%); color: #FFFFFF; }
.nav { position: relative; display: flex; align-items: center; justify-content: center; box-sizing: border-box; padding-left: 0; }
.nav-back { position: absolute; left: -20rpx; top: 50%; transform: translateY(-50%); width: 80rpx; height: 80rpx; display: flex; align-items: center; justify-content: center; }
.nav-title { font-size: 34rpx; font-weight: 600; }
.report-link { position: absolute; right: 0; top: 50%; transform: translateY(-50%); font-size: 26rpx; color: #FFFFFF; }
.h1 { margin-top: 16rpx; font-size: 40rpx; font-weight: 700; }
.sub { margin-top: 8rpx; font-size: 26rpx; line-height: 1.5; color: rgba(255, 255, 255, 0.88); }
.search { margin-top: 16rpx; height: 88rpx; display: flex; align-items: center; gap: 16rpx; padding: 0 8rpx 0 28rpx; background: #FFFFFF; border-radius: 44rpx; }
.search-input { flex: 1; min-width: 0; height: 80rpx; font-size: 28rpx; color: var(--t1); }
.search-btn { flex-shrink: 0; height: 72rpx; padding: 0 36rpx; display: flex; align-items: center; background: var(--brand); color: #FFFFFF; border-radius: 36rpx; font-size: 28rpx; font-weight: 500; }
.note { margin: 20rpx 32rpx 0; font-size: 25rpx; line-height: 1.6; color: var(--t2); }
.result { padding-bottom: 28rpx; }
.result-text { font-size: 26rpx; line-height: 1.7; }
.result-sum { font-size: 24rpx; padding-bottom: 8rpx; }
.warn { margin: 4rpx 0 12rpx; padding: 16rpx 20rpx; border-radius: 12rpx; background: var(--o-tint); color: var(--o-txt); font-size: 24rpx; line-height: 1.6; }
.hit { border-bottom: 2rpx solid var(--line); padding-bottom: 20rpx; }
.hit-line { margin-top: -8rpx; font-size: 24rpx; line-height: 1.6; color: var(--t2); }
.empty-lookup { padding: 12rpx 0 8rpx; }
.empty-title { font-size: 28rpx; font-weight: 600; color: var(--t1); }
.empty-text { margin-top: 8rpx; font-size: 24rpx; line-height: 1.7; }
.similar { margin-top: 20rpx; padding-top: 20rpx; border-top: 2rpx solid var(--line); }
.similar-title { font-size: 24rpx; color: var(--t2); }
.similar-item { min-height: 80rpx; display: flex; align-items: center; justify-content: space-between; gap: 16rpx; font-size: 26rpx; }
.similar-name { color: var(--brand); }
.count { font-size: 24rpx; font-weight: 400; }
.chips { margin-top: 12rpx; display: flex; gap: 16rpx; padding-bottom: 20rpx; border-bottom: 2rpx solid var(--line); }
.chip { height: 60rpx; padding: 0 24rpx; display: flex; align-items: center; border-radius: 30rpx; background: var(--fill); font-size: 26rpx; color: var(--t1); }
.chip--on { background: var(--brand-tint); color: var(--brand); }
.load-more { height: 96rpx; display: flex; align-items: center; justify-content: center; gap: 12rpx; border-top: 2rpx solid var(--line); font-size: 26rpx; color: var(--t3); }
