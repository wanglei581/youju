<view class="top" style="padding-top: {{statusBarHeight}}px">
  <view class="nav" style="height: {{navHeight}}px">
    <view class="nav-back" bindtap="back" aria-role="button" aria-label="返回"><t-icon name="chevron-left" size="48rpx" color="#FFFFFF" /></view>
    <text class="nav-title">查名单</text><text class="report-link" bindtap="openBoard">名单看板 ›</text>
  </view>
  <view class="h1">查企业在已收录名单里的记录</view>
  <view class="sub">高新技术企业、专精特新、科技型中小企业等，标题写明公示或公布的分开标注</view>
  <notice-bar onBlue="{{true}}" align="left" />
  <view class="search">
    <t-icon name="search" size="36rpx" color="#86909C" />
    <input class="search-input" value="{{name}}" placeholder="输入企业全称或统一社会信用代码" confirm-type="search" bindinput="onInput" bindconfirm="query" aria-label="企业全称或统一社会信用代码" />
    <view class="search-btn" bindtap="query">查询</view>
  </view>
</view>
<view class="note">按企业全称逐行比对名单原文；名称相近的企业分开列出，请核对统一社会信用代码。只查企业和机构，不查个人。名单状态按标题用词标注，公示期和当前效力以原文为准。</view>

<view wx:if="{{error}}" class="card load-error"><text>{{error}}</text><text class="link retry" bindtap="reload">重试</text></view>
<view wx:if="{{queried}}" class="card result">
  <view class="section-title">"{{queried}}" 的查询结果<text wx:if="{{demo}}" class="weak count">演示数据</text></view>
  <view wx:if="{{looking}}" class="muted result-text">正在比对名单原文…</view>
  <view wx:elif="{{lookupError}}" class="muted result-text">{{lookupError}}</view>
  <block wx:elif="{{result}}">
    <block wx:if="{{result.items.length}}">
      <view class="weak result-sum">在已收录的 {{result.coverage.lists}} 份名单中找到 {{result.items.length}} 份<text wx:if="{{result.truncated}}">（只列出最近的 {{result.items.length}} 份）</text></view>
      <view wx:if="{{result.ambiguous}}" class="warn">名单里有同名但统一社会信用代码不同的企业，下面不一定都是同一家，请逐条核对信用代码</view>
      <view wx:for="{{result.items}}" wx:key="id" class="hit">
        <doc-row doc="{{item}}" last="{{true}}" today="{{today}}" />
        <view class="hit-line">名单中写作"{{item.matched.name}}"<text wx:if="{{item.matched.via === 'creditCode'}}">（信用代码相同）</text><text wx:if="{{item.matched.batch}}"> · {{item.matched.batch}}</text><text wx:if="{{item.matched.sequence}}"> · 序号 {{item.matched.sequence}}</text><text wx:if="{{item.matched.region}}"> · {{item.matched.region}}</text><text wx:if="{{item.matched.creditCode}}"> · 信用代码 {{item.matched.creditCode}}</text></view>
      </view>
    </block>
    <view wx:else class="empty-lookup">
      <view class="empty-title">已收录的 {{result.coverage.lists}} 份名单中未找到</view>
      <view class="weak empty-text">收录范围：{{coverageSince ? coverageSince + '以来' : '近期'}}各省科技、工信部门发布、能读出企业名称的名单，仍在陆续补充。请核对企业全称，或换统一社会信用代码再查；最终以发文机关原文为准。</view>
    </view>
    <view wx:if="{{result.similar.length}}" class="similar">
      <view class="similar-title">名称相近的企业（不一定是同一家，请核对统一社会信用代码）</view>
      <view wx:for="{{result.similar}}" wx:key="name" class="similar-item" data-name="{{item.name}}" bindtap="pickSimilar" aria-role="button">
        <text class="similar-name">{{item.name}}</text><text class="weak">{{item.lists}} 份名单 ›</text>
      </view>
    </view>
  </block>
</view>

<view class="card">
  <view class="section-title">最近发布的名单<text class="weak count">{{loading || error ? '' : '本周 ' + weekTotal + ' 份'}}</text></view>
  <view class="chips">
    <view wx:for="{{chips}}" wx:key="*this" class="chip {{chip === item ? 'chip--on' : ''}}" data-chip="{{item}}" bindtap="pickChip">{{item}}</view>
  </view>
  <view class="rows">
    <view wx:if="{{loading}}" class="empty-lookup">正在加载…</view>
    <view wx:if="{{chip !== '全部'}}" class="weak result-text">仅筛选最近加载的 {{items.length}} 份名单</view>
    <doc-row wx:if="{{!loading && !error}}" wx:for="{{shown}}" wx:key="id" doc="{{item}}" last="{{index === shown.length - 1}}" today="{{today}}" />
    <view wx:if="{{!shown.length && !loading && !error}}" class="empty-lookup">暂无符合类型的名单</view>
  </view>
  <view wx:if="{{items.length < total}}" class="load-more">已显示 {{items.length}}/{{total}} 份 · <text class="link" bindtap="moreLists">查看全部 {{total}} 份</text></view>
</view>
<view style="height: 80rpx"></view>
