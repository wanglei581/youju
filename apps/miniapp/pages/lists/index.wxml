<view class="top" style="padding-top: {{statusBarHeight}}px">
  <view class="nav" style="height: {{navHeight}}px">
    <!-- 从转发卡片打开（页面栈只有这一页）时左上角是"首页"，点了回首页 -->
    <view class="nav-back" bindtap="back" aria-role="button" aria-label="{{firstPage ? '回首页' : '返回'}}"><t-icon name="{{firstPage ? 'home' : 'chevron-left'}}" size="{{firstPage ? '40rpx' : '48rpx'}}" color="#FFFFFF" /></view>
    <text class="nav-title">查名单</text>
  </view>
  <view class="h1">在政府公开名单里查企业</view>
  <view class="sub">只查科技、工信等部门公开发布的认定、立项名单</view>
  <view class="search">
    <t-icon name="search" size="36rpx" color="#86909C" />
    <input class="search-input" value="{{name}}" placeholder="输入企业全称" confirm-type="search" bindinput="onInput" bindconfirm="query" aria-label="企业全称" />
    <view class="search-btn" bindtap="query">查询</view>
  </view>
</view>
<notice-bar />
<!-- 查询规则默认收起成一行，点开后逐条显示，原来的说明一字不少 -->
<view class="rules">
  <view class="rules-head" bindtap="toggleRules" aria-role="button" aria-expanded="{{rulesOpen}}">
    <t-icon name="info-circle" size="30rpx" />
    <text>查询说明</text>
    <t-icon name="{{rulesOpen ? 'chevron-up' : 'chevron-down'}}" size="28rpx" />
  </view>
  <view wx:if="{{rulesOpen}}" class="rules-body">
    <view class="rule">按企业全称逐行比对名单原文</view>
    <view class="rule">名称相近的企业分开列出，不一定是同一家</view>
    <view class="rule">查到后可以看这家企业在原名单里的那一行</view>
    <view class="rule">只查企业和机构，不查个人</view>
    <view class="rule">发布阶段（公示、公布）按名单标题用词标注，是否还在公示期以原文为准</view>
  </view>
</view>

<view wx:if="{{error}}" class="card load-error"><text>{{error}}</text><text class="link retry" bindtap="reload">重试</text></view>
<view wx:if="{{queried}}" class="card result">
  <view class="section-title">"{{queried}}" 的查询结果<text wx:if="{{demo}}" class="weak count">演示数据</text></view>
  <view wx:if="{{looking}}" class="muted result-text">正在比对名单原文…<view wx:if="{{serviceStarting}}">正在连接，比平时慢一点，请稍等…</view></view>
  <view wx:elif="{{lookupError}}" class="muted result-text">{{lookupError}}<text class="link" bindtap="query">　重试</text></view>
  <block wx:elif="{{result}}">
    <block wx:if="{{result.items.length}}">
      <view class="weak result-sum">在已收录的 {{result.coverage.lists}} 份名单中找到 {{result.items.length}} 份<text wx:if="{{result.truncated}}">（只列出最近的 {{result.items.length}} 份）</text></view>
      <view wx:if="{{result.ambiguous}}" class="warn">名单里有名称相同、统一社会信用代码不同的企业，不能确定下面哪一份是你要查的这一家，请点"看原名单里的这一行"核对</view>
      <view wx:for="{{result.items}}" wx:key="id" class="hit">
        <doc-row doc="{{item}}" last="{{true}}" today="{{today}}" />
        <view class="hit-line">名单中写作"{{item.matched.name}}"<text wx:if="{{item.matched.category}}"> · {{item.matched.category}}</text><text wx:if="{{item.matched.via === 'creditCode'}}">（信用代码相同）</text><text wx:if="{{item.matched.batch}}"> · {{item.matched.batch}}</text><text wx:if="{{item.matched.sequence}}"> · 序号 {{item.matched.sequence}}</text><text wx:if="{{item.matched.region}}"> · {{item.matched.region}}</text><text wx:if="{{item.matched.creditCode}}"> · 信用代码 {{item.matched.creditCode}}</text></view>
        <!-- 整行可点进发布这份名单的通知（10/29 去掉同去处的第二个按钮）；这里只放"看原名单里的这一行" -->
        <view wx:if="{{item.matched.entryToken}}" class="hit-actions">
          <button class="hit-btn hit-btn--main" data-token="{{item.matched.entryToken}}" bindtap="record">看原名单里的这一行</button>
        </view>
      </view>
    </block>
    <!-- 输入的是简称：没有叫这个名字的企业，但有名称里带这几个字的——先列候选，点一个按全称查 -->
    <view wx:elif="{{result.candidates.length}}" class="empty-lookup">
      <view class="empty-title">你要查的是不是：</view>
      <view class="weak empty-text">名单里没有全称是"{{queried}}"的企业。下面是名称里带这几个字的，点一个按全称查。</view>
      <view class="candidates">
        <view wx:for="{{result.candidates}}" wx:key="*this" class="similar-item candidate" data-name="{{item}}" bindtap="pickSimilar" aria-role="button">
          <text class="similar-name">{{item}}</text><t-icon name="chevron-right" size="32rpx" color="#B4BAC6" />
        </view>
      </view>
      <view class="weak empty-text">最多列 20 个，没有你要找的，请输入企业全称再查。</view>
    </view>
    <view wx:else class="empty-lookup">
      <view class="empty-title">已收录的 {{result.coverage.lists}} 份名单中未找到</view>
      <view class="warn">{{missNote}}</view>
      <view class="weak empty-text">请核对企业全称再查；{{coverageSince ? coverageSince + '以来' : '近期'}}的名单份数见下方“比对范围”。</view>
    </view>
    <view wx:if="{{result.similar.length}}" class="similar">
      <view class="similar-title">名称相近的企业（不一定是同一家，点名称按全称查）</view>
      <view wx:for="{{result.similar}}" wx:key="name" class="similar-item" data-name="{{item.name}}" bindtap="pickSimilar" aria-role="button">
        <text class="similar-name">{{item.name}}</text><text class="weak">{{item.lists}} 份名单 ›</text>
      </view>
    </view>
  </block>
</view>

<view class="card">
  <view class="section-title">最近发布的名单<text class="weak count">{{loading || error ? '' : '本周 ' + weekTotal + ' 份'}}</text></view>
  <!-- 显示的是本机存的上次数据时写明（10/12） -->
  <view wx:if="{{cachedText}}" class="weak cached-note">下面是{{cachedText}}的名单{{staleError ? '，这次没更新成功' : '，正在更新…'}}</view>
  <view class="chips">
    <view wx:for="{{chips}}" wx:key="*this" class="chip {{chip === item ? 'chip--on' : ''}}" data-chip="{{item}}" bindtap="pickChip">{{item}}</view>
  </view>
  <view class="rows">
    <view wx:if="{{loading}}" aria-label="正在加载">
      <view wx:for="{{[1, 2, 3]}}" wx:key="*this" class="sk-row">
        <view class="sk-head"><view class="sk sk-tag"></view><view class="sk sk-chip"></view></view>
        <view class="sk sk-line"></view>
        <view class="sk sk-line sk-line--short"></view>
        <view class="sk sk-meta"></view>
      </view>
    </view>
    <view wx:if="{{loading && serviceStarting}}" class="muted">正在连接，比平时慢一点，请稍等…</view>
    <view wx:if="{{chip !== '全部'}}" class="weak result-text">仅筛选最近加载的 {{items.length}} 份名单</view>
    <doc-row wx:if="{{!loading && !error}}" wx:for="{{shown}}" wx:key="id" doc="{{item}}" last="{{index === shown.length - 1}}" today="{{today}}" />
    <view wx:if="{{!shown.length && !loading && !error}}" class="empty-lookup">暂无符合类型的名单</view>
  </view>
  <view wx:if="{{items.length < total}}" class="load-more">已显示 {{items.length}}/{{total}} 份 · <text class="link" bindtap="moreLists">查看全部 {{total}} 份</text></view>
</view>
<!-- 比对范围（D-061，原名单看板的统计并到这里）：查名单拿哪些名单比的 -->
<view wx:if="{{scope}}" class="card scope">
  <view class="section-title">比对范围<text class="weak count">能查的名单 {{scope.lists}} 份</text></view>
  <view class="weak scope-text">只统计能读出企业名称的名单，扫描件等读不出文字的不计入；公示期内的名单也计入，以发文机关最终公布的为准。</view>
  <view class="table-head"><text>名单类型</text><text>名单份数</text><text>企业条数</text></view>
  <view wx:for="{{scope.byType}}" wx:key="type" class="table-row"><text>{{item.type}}</text><text>{{item.lists}}</text><text>{{item.entries}}</text></view>
  <view class="scope-toggle" bindtap="toggleScope" aria-role="button" aria-expanded="{{scopeOpen}}"><text class="link">{{scopeOpen ? '收起' : '按省份、年度看'}}</text><t-icon name="{{scopeOpen ? 'chevron-up' : 'chevron-down'}}" size="26rpx" color="#2A5CE0" /></view>
  <block wx:if="{{scopeOpen}}">
    <view class="stat-title">按省份</view>
    <view class="table-head"><text>省份</text><text>名单份数</text><text>企业条数</text></view>
    <view wx:for="{{scope.byProvince}}" wx:key="province" class="table-row"><text>{{item.province}}</text><text>{{item.lists}}</text><text>{{item.entries}}</text></view>
    <view class="stat-title">按年度</view>
    <view class="table-head"><text>年度</text><text>名单份数</text><text>企业条数</text></view>
    <view wx:for="{{scope.byYear}}" wx:key="year" class="table-row"><text>{{item.year}}</text><text>{{item.lists}}</text><text>{{item.entries}}</text></view>
  </block>
</view>
<view wx:elif="{{scopeError}}" class="card load-error"><text>比对范围没加载出来</text><text class="link retry" bindtap="loadScope">重试</text></view>
<view style="height: 80rpx"></view>
