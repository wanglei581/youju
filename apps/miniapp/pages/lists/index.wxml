<view class="top" style="padding-top: {{statusBarHeight}}px">
  <view class="nav" style="height: {{navHeight}}px">
    <!-- 从转发卡片打开（页面栈只有这一页）时左上角是"首页"，点了回首页 -->
    <view class="nav-back" bindtap="back" aria-role="button" aria-label="{{firstPage ? '回首页' : '返回'}}"><t-icon name="{{firstPage ? 'home' : 'chevron-left'}}" size="{{firstPage ? '40rpx' : '48rpx'}}" color="#FFFFFF" /></view>
    <text class="nav-title">查名单</text>
  </view>
  <view class="h1">查企业上过哪些名单</view>
  <view class="sub">在已收录的高企、专精特新等公示和公布名单里查</view>
  <view class="search">
    <t-icon name="search" size="36rpx" color="#86909C" />
    <input class="search-input" value="{{name}}" placeholder="输入企业全称或统一社会信用代码" confirm-type="search" bindinput="onInput" bindconfirm="query" aria-label="企业全称或统一社会信用代码" />
    <view class="search-btn" bindtap="query">查询</view>
  </view>
</view>
<notice-bar />
<!-- 查询规则默认收起成一行，点开后逐条显示，原来的说明一字不少 -->
<view class="rules">
  <view class="rules-head" bindtap="toggleRules" aria-role="button" aria-expanded="{{rulesOpen}}">
    <t-icon name="info-circle" size="30rpx" />
    <text>查询说明</text>
    <t-icon name="{{rulesOpen ? 'chevron-up' : 'chevron-down'}}" size="28rpx" />
  </view>
  <view wx:if="{{rulesOpen}}" class="rules-body">
    <view class="rule">按企业全称逐行比对名单原文</view>
    <view class="rule">名称相近的企业分开列出，请核对统一社会信用代码</view>
    <view class="rule">只查企业和机构，不查个人</view>
    <view class="rule">名单状态按标题用词标注，公示期和当前效力以原文为准</view>
  </view>
</view>

<view wx:if="{{error}}" class="card load-error"><text>{{error}}</text><text class="link retry" bindtap="reload">重试</text></view>
<view wx:if="{{queried}}" class="card result">
  <view class="section-title">"{{queried}}" 的查询结果<text wx:if="{{demo}}" class="weak count">演示数据</text></view>
  <view wx:if="{{looking}}" class="muted result-text">正在比对名单原文…<view wx:if="{{serviceStarting}}">正在连接，比平时慢一点，请稍等…</view></view>
  <view wx:elif="{{lookupError}}" class="muted result-text"><text>{{lookupError}}</text><button bindtap="retryLookup">{{lookupChanged ? '重新查询' : '重试本页'}}</button></view>
  <block wx:elif="{{lookupMode === 'identities' && identityResult}}">
    <block wx:if="{{identityResult.identities.length}}">
      <view class="identity-intro">请选择本次要查的记录</view>
      <view class="weak empty-text">同名但信用代码不同的记录分开查询。代码仅用于区分名单中的记录，不代表资质或信用已经核验。</view>
      <button wx:for="{{identityResult.identities}}" wx:key="key" class="identity-option" data-index="{{index}}" bindtap="pickIdentity">
        <text>{{item.name}}</text>
        <text wx:if="{{item.kind === 'code'}}" class="identity-code">统一社会信用代码 {{item.creditCode}}</text>
        <text wx:else class="identity-code">未核实：原文未提供有效信用代码</text>
      </button>
      <view class="lookup-pagination"><button disabled="{{identityPage <= 1}}" bindtap="previousIdentity">上一页身份</button><text>第 {{identityPage}} 页</text><button disabled="{{nextIdentityCursor === null}}" bindtap="nextIdentity">下一页身份</button></view>
      <view wx:if="{{nextIdentityCursor !== null}}" class="weak empty-text">还有其他身份记录，请继续翻页查看。</view>
    </block>
    <view wx:elif="{{identityResult.candidates.length}}" class="empty-lookup">
      <view class="empty-title">你要查的是不是：</view>
      <view class="weak empty-text">以下仅为名称建议，请选择企业或机构全称重新查询，不代表已找到同一家。</view>
      <view class="candidates"><view wx:for="{{identityResult.candidates}}" wx:key="*this" class="similar-item candidate" data-name="{{item}}" bindtap="pickSimilar" aria-role="button"><text class="similar-name">{{item}}</text><t-icon name="chevron-right" size="32rpx" color="#B4BAC6" /></view></view>
      <view class="weak empty-text">最多列 20 个建议，没有你要找的，请输入企业全称或统一社会信用代码再查。</view>
    </view>
    <view wx:else class="empty-lookup"><view class="empty-title">已收录范围内未找到对应记录</view><view class="warn">没找到不代表没上过名单。尚未读出企业名称的扫描件等，不在可查询范围内。</view></view>
    <view wx:if="{{identityResult.coverage}}" class="weak empty-text">查询范围：{{identityResult.coverage.lists}} 份已收录名单{{coverageSince ? '，' + coverageSince + '以来' : ''}}。{{identityResult.coverage.note}}</view>
  </block>
  <block wx:elif="{{result}}">
    <view class="selected-identity">
      <text>{{selectedIdentity.name}}</text>
      <text wx:if="{{selectedIdentity.kind === 'code'}}" class="identity-code">统一社会信用代码 {{selectedIdentity.creditCode}}</text>
      <view wx:else class="warn">未核实：这些记录没有有效信用代码，仅名称相同，不能认定是同一家。请逐条核对名单中的名称、地区和批次。</view>
      <button bindtap="changeIdentity">重新选择查询身份</button>
    </view>
    <view class="weak result-sum">第 {{matchPage}} 页，本页 {{result.items.length}} 份名单<text wx:if="{{nextMatchCursor !== null}}">，还有下一页</text></view>
    <view wx:for="{{result.items}}" wx:key="id" class="hit">
      <doc-row doc="{{item}}" last="{{true}}" today="{{today}}" />
      <view class="hit-line">名单中写作“{{item.matched.name}}”<text wx:if="{{item.matched.category}}"> · {{item.matched.category}}</text><text wx:if="{{item.matched.via === 'creditCode'}}">（信用代码相同）</text><text wx:if="{{item.matched.batch}}"> · {{item.matched.batch}}</text><text wx:if="{{item.matched.sequence}}"> · 原表序号 {{item.matched.sequence}}</text><text wx:if="{{item.matched.region}}"> · {{item.matched.region}}</text><text wx:if="{{item.matched.creditCode}}"> · 信用代码 {{item.matched.creditCode}}</text></view>
      <button wx:if="{{item.matched.entryId}}" data-index="{{index}}" bindtap="locate">在小程序内查看命中依据</button>
      <button data-id="{{item.id}}" bindtap="evidence">查看名单文件和依据</button>
    </view>
    <view wx:if="{{!result.items.length}}" class="empty-lookup"><view class="empty-title">本页没有对应名单记录</view><view class="weak empty-text">未找到不代表未上过名单，结果以已收录且可读取的范围为限。</view></view>
    <view class="lookup-pagination"><button disabled="{{matchPage <= 1}}" bindtap="previousMatch">上一页结果</button><text>第 {{matchPage}} 页</text><button disabled="{{nextMatchCursor === null}}" bindtap="nextMatch">下一页结果</button></view>
    <view wx:if="{{nextMatchCursor === null && result.items.length}}" class="weak empty-text">已到当前身份、本版本查询结果末尾。</view>
    <view wx:if="{{result.coverage}}" class="weak empty-text">查询范围：{{result.coverage.lists}} 份已收录名单。{{result.coverage.note}}</view>
  </block>
</view>

<view class="card">
  <view class="section-title">最近发布的名单<text class="weak count">{{loading || error ? '' : '本周 ' + weekTotal + ' 份'}}</text></view>
  <!-- 显示的是本机存的上次数据时写明（10/12） -->
  <view wx:if="{{cachedText}}" class="weak cached-note">下面是{{cachedText}}的名单{{staleError ? '，这次没更新成功' : '，正在更新…'}}</view>
  <view class="chips">
    <view wx:for="{{chips}}" wx:key="*this" class="chip {{chip === item ? 'chip--on' : ''}}" data-chip="{{item}}" bindtap="pickChip">{{item}}</view>
  </view>
  <view class="rows">
    <view wx:if="{{loading}}" aria-label="正在加载">
      <view wx:for="{{[1, 2, 3]}}" wx:key="*this" class="sk-row">
        <view class="sk-head"><view class="sk sk-tag"></view><view class="sk sk-chip"></view></view>
        <view class="sk sk-line"></view>
        <view class="sk sk-line sk-line--short"></view>
        <view class="sk sk-meta"></view>
      </view>
    </view>
    <view wx:if="{{loading && serviceStarting}}" class="muted">正在连接，比平时慢一点，请稍等…</view>
    <view wx:if="{{chip !== '全部'}}" class="weak result-text">仅筛选最近加载的 {{items.length}} 份名单</view>
    <doc-row wx:if="{{!loading && !error}}" wx:for="{{shown}}" wx:key="id" doc="{{item}}" last="{{index === shown.length - 1}}" today="{{today}}" />
    <view wx:if="{{!shown.length && !loading && !error}}" class="empty-lookup">暂无符合类型的名单</view>
  </view>
  <view wx:if="{{items.length < total}}" class="load-more">已显示 {{items.length}}/{{total}} 份 · <text class="link" bindtap="moreLists">查看全部 {{total}} 份</text></view>
</view>
<!-- 比对范围（D-061，原名单看板的统计并到这里）：查名单拿哪些名单比的 -->
<view wx:if="{{scope}}" class="card scope">
  <view class="section-title">比对范围<text class="weak count">能查的名单 {{scope.lists}} 份</text></view>
  <view class="weak scope-text">查名单在读出了企业名称的名单里逐行比对；扫描件、图片等读不出文字的名单暂时查不到，不计入下面的份数和条数。公示期内的名单也计入，最终以发文机关公布的为准。</view>
  <view class="table-head"><text>名单类型</text><text>名单份数</text><text>企业条数</text></view>
  <view wx:for="{{scope.byType}}" wx:key="type" class="table-row"><text>{{item.type}}</text><text>{{item.lists}}</text><text>{{item.entries}}</text></view>
  <view class="scope-toggle" bindtap="toggleScope" aria-role="button" aria-expanded="{{scopeOpen}}"><text class="link">{{scopeOpen ? '收起' : '按省份、年度看'}}</text><t-icon name="{{scopeOpen ? 'chevron-up' : 'chevron-down'}}" size="26rpx" color="#2A5CE0" /></view>
  <block wx:if="{{scopeOpen}}">
    <view class="stat-title">按省份</view>
    <view class="table-head"><text>省份</text><text>名单份数</text><text>企业条数</text></view>
    <view wx:for="{{scope.byProvince}}" wx:key="province" class="table-row"><text>{{item.province}}</text><text>{{item.lists}}</text><text>{{item.entries}}</text></view>
    <view class="stat-title">按年度</view>
    <view class="table-head"><text>年度</text><text>名单份数</text><text>企业条数</text></view>
    <view wx:for="{{scope.byYear}}" wx:key="year" class="table-row"><text>{{item.year}}</text><text>{{item.lists}}</text><text>{{item.entries}}</text></view>
  </block>
</view>
<view wx:elif="{{scopeError}}" class="card load-error"><text>比对范围没加载出来</text><text class="link retry" bindtap="loadScope">重试</text></view>
<view style="height: 80rpx"></view>
