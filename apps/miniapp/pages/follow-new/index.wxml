<notice-bar />
<!-- 还没同意协议（服务端返回 403）：说明怎样才能看，带去"我的"的入口，不当作加载失败 -->
<view wx:if="{{gated}}" class="card gate">
  <view class="gate-text">同意用户协议和隐私保护指引后，可以查看关注条件的新文件</view>
  <view class="link gate-link" bindtap="goMe" aria-role="link">去“我的” ›</view>
</view>
<block wx:else>
<view wx:if="{{!loading && !error}}" class="summary muted">上次查看之后有 {{total + folded}} 份新文件</view>
<view wx:if="{{!loading && !error && fold.text}}" class="fold-note muted" bindtap="toggleGuides" aria-role="button">{{fold.text}}<text class="link">{{fold.link}}</text></view>
<view wx:if="{{error}}" class="card load-error"><text>{{error}}</text><text class="link retry" bindtap="load" data-reset="1">重试</text></view>
<view class="card">
  <view wx:if="{{loading}}" class="empty muted">正在加载…</view>
  <doc-row wx:for="{{items}}" wx:key="id" doc="{{item}}" last="{{index === items.length - 1}}" today="{{today}}" />
  <view wx:if="{{!items.length && !loading && !error}}" class="empty muted">{{folded ? '除折叠的资讯与指南外，没有新文件' : '没有新文件'}}</view>
  <view wx:if="{{items.length < total}}" class="load-more">已显示 {{items.length}}/{{total}} 份 · 上拉加载更多</view>
</view>
<view wx:if="{{total + folded}}" class="btn-primary seen" bindtap="markSeen" aria-role="button">全部标为已读</view>
</block>
<view style="height: 80rpx"></view>
