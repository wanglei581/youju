<notice-bar />
<feature-closed wx:if="{{!loginOpen}}" />
<view wx:elif="{{error}}" class="card load-error"><text>{{error}}</text><text class="link retry" bindtap="load">重试</text></view>
<view wx:elif="{{loading}}" class="card muted loading-tip">正在加载…<view wx:if="{{serviceStarting}}">正在连接，比平时慢一点，请稍等…</view></view>

<block wx:if="{{loginOpen && !loading && !error}}">
  <view wx:if="{{!user}}" class="card intro">
    <view class="intro-title">你的账号下没有保存个人信息</view>
    <view class="muted intro-text">检索、查看、导出、查名单不需要登录。同意用户协议和隐私保护指引后使用关注、{{remindOpen ? '微信提醒、' : ''}}纠错，才会保存相关信息。访问日志按法律要求保存，不在这里显示。</view>
  </view>

  <block wx:else>
    <view class="card intro">
      <view class="intro-title">你账号下保存的个人信息</view>
      <view class="muted intro-text">同意记录、关注、{{remindOpen || subs.length ? '微信提醒授权、' : ''}}纠错都在这里，可以复制保存，也可以改关注名称、删除记录。复制单条包含这条记录的完整条件、状态和时间；个人数据概览包含本页返回的数据；不含未加载的对话和逐条问题，问题请在对话内分页复制。访问日志不在这里显示。更新于 {{exportedAt}}</view>
      <view class="btn-primary copy" bindtap="copyAll" aria-role="button"><t-icon name="copy" size="36rpx" color="#FFFFFF" />复制个人数据概览</view>
    </view>

    <view class="card">
      <view class="section-title">账号</view>
      <view class="kv"><text class="kv-k">微信用户标识</text><text class="kv-v">{{user.id}}</text></view>
      <!-- 完整标识：联系客服排查问题时用；创始人给自己开 AI 白名单时也从这里复制，填到云托管的 YOUJU_AI_ADVISOR_OPENIDS。
           10/18 验收：正式包不再写"内测白名单"（所有人都看得到这一行） -->
      <view class="kv"><text class="kv-k">完整标识</text><text class="kv-v link" bindtap="copyOpenid" aria-role="button">复制（联系客服时用）</text></view>
      <view class="kv"><text class="kv-k">同意的协议版本</text><text class="kv-v">{{user.agreedVersion || '未同意'}}</text></view>
      <view wx:if="{{user.agreedAt}}" class="kv"><text class="kv-k">同意时间</text><text class="kv-v">{{user.agreedAt}}</text></view>
      <view class="kv kv--last"><text class="kv-k">最近使用</text><text class="kv-v">{{user.visited || user.created}}</text></view>
    </view>

    <view class="card">
      <view class="section-title">关注 {{follows.length}}</view>
      <view wx:for="{{follows}}" wx:key="id" class="item">
        <view class="item-main">{{item.name}}</view>
        <view class="item-sub">{{item.desc}} · 建立于 {{item.created}}</view>
        <view class="item-ops">
          <text class="op" data-id="{{item.id}}" data-name="{{item.name}}" bindtap="rename" aria-role="button">改名</text>
          <text class="op" data-kind="follow" data-id="{{item.id}}" bindtap="copyOne" aria-role="button">复制单条</text>
          <text class="op op--danger" data-kind="follow" data-id="{{item.id}}" bindtap="remove" aria-role="button">删除</text>
        </view>
      </view>
      <view wx:if="{{!follows.length}}" class="empty weak">没有</view>
    </view>

    <!-- 订阅模板申请下来之前没有微信提醒：没有授权记录时整栏不显示（以前的内测版留下的记录照样列出） -->
    <view wx:if="{{remindOpen || subs.length}}" class="card">
      <view class="section-title">微信提醒授权 {{totals.subs}}</view>
      <view wx:for="{{subs}}" wx:key="id" class="item">
        <view class="item-main">{{item.kind}}：{{item.target}}</view>
        <view class="item-sub">{{item.status}} · 授权于 {{item.created}}</view>
        <view wx:if="{{item.attempted}}" class="item-sub">尝试发送于 {{item.attempted}}</view>
        <view class="item-ops">
          <text class="op" data-kind="sub" data-id="{{item.id}}" bindtap="copyOne" aria-role="button">复制单条</text>
          <text class="op op--danger" data-kind="sub" data-id="{{item.id}}" bindtap="remove" aria-role="button">{{item.unused ? '取消提醒' : '删除记录'}}</text>
        </view>
      </view>
      <view wx:if="{{!subs.length}}" class="empty weak">没有</view>
      <view wx:if="{{totals.subs > subs.length}}" class="more weak">只显示最近 {{subs.length}} 条，复制个人数据概览里也是这些</view>
    </view>

    <view class="card">
      <view class="section-title">纠错 {{totals.feedback}}</view>
      <view wx:for="{{feedback}}" wx:key="id" class="item">
        <view class="item-sub">{{item.title}}</view>
        <view class="item-main">{{item.content}}</view>
        <view class="item-sub">提交于 {{item.created}} · 内容安全：{{item.check}}</view>
        <view wx:if="{{item.outcome}}" class="item-sub">处理结果：{{item.outcome}}<text wx:if="{{item.handledAt}}"> · 处理于 {{item.handledAt}}</text></view>
        <view wx:else class="item-sub">处理状态：{{item.handling}}<text wx:if="{{item.handledAt}}"> · 处理于 {{item.handledAt}}</text></view>
        <view wx:if="{{item.reply}}" class="item-sub">处理说明：{{item.reply}}</view>
        <view class="item-ops">
          <text class="op" data-kind="feedback" data-id="{{item.id}}" bindtap="copyOne" aria-role="button">复制单条</text>
          <text class="op op--danger" data-kind="feedback" data-id="{{item.id}}" bindtap="remove" aria-role="button">删除</text>
        </view>
      </view>
      <view wx:if="{{!feedback.length}}" class="empty weak">没有</view>
      <view wx:if="{{totals.feedback > feedback.length}}" class="more weak">只显示最近 {{feedback.length}} 条，复制个人数据概览里也是这些</view>
    </view>

    <!-- 工具记录：本人随时能看（复制单条是这条的完整记录）、能删，功能关着、协议升了版本也一样（D-093 上线门槛第 8 条）；
         没有记录时整栏不显示。类型名、栏目名从 JS 来（AI 以外页面的模板里不写 AI，见 ai-entry.test.js） -->
    <view wx:if="{{tasks.length}}" class="card">
      <view class="section-title">{{tasksTitle}} {{totals.tasks}}</view>
      <view wx:for="{{tasks}}" wx:key="id" class="item">
        <view class="item-main">{{item.kind}}<text wx:if="{{item.rows}}">（{{item.rows}} 家）</text></view>
        <view class="item-sub">{{item.state}} · 提交于 {{item.created}}<text wx:if="{{item.finished}}"> · 结束于 {{item.finished}}</text></view>
        <view class="item-ops">
          <text class="op" data-kind="task" data-id="{{item.id}}" bindtap="copyOne" aria-role="button">复制单条</text>
          <text wx:if="{{!item.running}}" class="op op--danger" data-kind="task" data-id="{{item.id}}" bindtap="remove" aria-role="button">删除</text>
          <text wx:else class="op-wait">正在处理，结束后可以删除</text>
        </view>
      </view>
      <view wx:if="{{totals.tasks > tasks.length}}" class="more weak">只显示最近 {{tasks.length}} 条，复制个人数据概览里也是这些</view>
      <view wx:if="{{fileNote}}" class="more weak">{{fileNote}}</view>
    </view>

    <view wx:if="{{chats.length}}" class="card">
      <view class="section-title">{{chatsTitle}} {{totals.chats}} 条 · {{totals.chatTurns}} 问</view>
      <view class="muted plain">这里查看保存的问题、时间、状态和次数记录，不含回答。复制个人数据概览包含已加载的对话目录；问题按页查看、复制。</view>
      <view wx:for="{{chats}}" wx:key="id" class="item">
        <view class="item-main">{{item.title}}</view>
        <view class="item-sub">{{item.turns}} 问 · 最近 {{item.last}}</view>
        <view class="item-ops">
          <text class="op" data-id="{{item.id}}" bindtap="viewChat" aria-role="button">查看问题</text>
          <text class="op op--danger" data-kind="chat" data-id="{{item.id}}" bindtap="remove" aria-role="button">删除整条对话</text>
        </view>
      </view>
      <view wx:if="{{chatsNext}}" class="op" bindtap="moreChats" aria-role="button">{{chatsLoading ? '加载中…' : '查看更多对话'}}</view>
      <view wx:if="{{chatLoading}}" class="muted">问题加载中…</view>
      <view wx:if="{{chatDetail}}" id="chat-detail">
        <view class="section-title">对话 {{chatDetail.id}} · 第 {{chatDetail.range.from}}–{{chatDetail.range.to}} 问，共 {{chatDetail.total}} 问</view>
        <view wx:for="{{chatDetail.turns}}" wx:for-item="turn" wx:key="seq" class="item">
          <view class="item-main">{{turn.question}}</view>
          <view class="item-sub">{{turn.skillLabel}} · {{turn.state}} · {{turn.created}} · {{turn.counted ? '已计次数' : '未计次数'}}</view>
        </view>
        <view class="item-ops">
          <text class="op" bindtap="copyChatPage" aria-role="button">复制本页问题（含范围）</text>
          <text wx:if="{{chatDetail.hasMore}}" class="op" bindtap="earlierChat" aria-role="button">更早的问题</text>
        </view>
      </view>
    </view>

    <view wx:if="{{extras}}" class="card">
      <view class="section-title">其他记录</view>
      <view class="muted plain">{{extras}}</view>
    </view>

    <view wx:if="{{totals.events}}" class="card">
      <view class="section-title">使用记录 {{totals.events}}</view>
      <view class="muted plain">搜索、导出等操作的次数和类型，不含搜索的文字；在复制个人数据概览里可以看到每一条。</view>
    </view>

    <view class="card">
      <view class="section-title">保存多久</view>
      <view class="muted plain">
        <view>· 账号、同意记录、关注：保存到你注销</view>
        <view>· 纠错：提交 {{retention.feedback}} 天后删除</view>
        <!-- 10/18 验收：和隐私保护指引（2026-11）第三节第 2 条"保存期限"一致，补上批量工具、AI、加量体验和按天次数 -->
        <!-- 批量工具、加量体验、按天次数：包里有工具中心或这个账号有过工具记录时才写（过审版没有这些功能，D-091） -->
        <view wx:if="{{retention.toolTasks && toolsShown}}">· 批量工具：任务里解析出的名单 {{retention.toolInput}} 天后清空，任务记录和结果文件（含提交的名单内容）{{retention.toolTasks}} 天后删除；可以在本页提前删除</view>
        <view wx:if="{{aiRetention}}">{{aiRetention}}</view>
        <view wx:if="{{chatRetention}}">{{chatRetention}}</view>
        <view wx:if="{{boostShown}}">· 加量体验记录：开始和结束时间保存到你注销，注销时一并删除</view>
        <view wx:if="{{toolsShown}}">· 按天的使用次数：保留本月和上个月的</view>
        <view wx:if="{{remindOpen || subs.length}}">· 微信提醒授权：发出或失效 {{retention.usedSubscriptions}} 天后删除，没用上的 {{retention.unusedSubscriptions}} 天后删除</view>
        <view wx:if="{{totals.events}}">· 使用记录：{{retention.events}} 天后删除</view>
        <view>· 访问日志：保存 190 天（法律要求不少于 6 个月），不在这里显示</view>
        <view>· 数据库备份：每天备份一次，保留 30 天，只用于数据丢失时恢复；注销后的数据随备份到期清除</view>
      </view>
    </view>

    <view class="danger-btn" bindtap="deleteAll" aria-role="button">注销并删除全部数据</view>
  </block>
</block>
<view style="height: 80rpx"></view>
