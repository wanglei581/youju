{
  "description": "行业政策 · 微信原生小程序（本地受控试用版）",
  "projectname": "industry-policy-miniapp",
  "appid": "",
  "compileType": "miniprogram",
  "libVersion": "2.32.3",
  "packOptions": {
    "ignore": [
      {
        "type": "file",
        "value": "README.md"
      }
    ],
    "include": []
  },
  "setting": {
    "urlCheck": false,
    "es6": true,
    "enhance": true,
    "postcss": true,
    "minified": true,
    "minifyWXML": true,
    "minifyWXSS": true,
    "coverView": true,
    "showShadowRootInWxmlPanel": true,
    "ignoreUploadUnusedFiles": true,
    "packNpmManually": false,
    "packNpmRelationList": [],
    "babelSetting": {
      "ignore": [],
      "disablePlugins": [],
      "outputPath": ""
    }
  },
  "condition": {},
  "editorSetting": {
    "tabIndent": "insertSpaces",
    "tabSize": 2
  }
}
