/* 行业研究台 design tokens and shared primitives.
 * Evergreen ink + paper + copper accent; serif display type for headings. */
page {
  --ink: #172b2a;
  --ink-2: #33504a;
  --deep: #164945;
  --deep-2: #0b3633;
  --deep-3: #062624;
  --paper: #f5f3ee;
  --paper-2: #efece4;
  --card: #ffffff;
  --muted: #657a73;
  --faint: #93a39c;
  --line: #e2e8e0;
  --line-2: #eef1ec;
  --soft: #e8efe8;
  --copper: #b96f4b;
  --copper-soft: #f6e9df;
  --copper-ink: #8c4f31;
  --ok: #276f53;
  --ok-soft: #e2f0e7;
  --warn: #a75132;
  --warn-soft: #fcefe7;
  --gold: #e7c8ad;
  --radius: 24rpx;
  --radius-sm: 16rpx;
  --shadow: 0 12rpx 36rpx rgba(19, 47, 43, 0.07);
  --serif: "Songti SC", "STSong", "Noto Serif SC", "Source Han Serif SC", serif;

  background: var(--paper);
  color: var(--ink);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  line-height: 1.6;
}

/* ---------- layout ---------- */
.page {
  padding: 24rpx 28rpx 48rpx;
  box-sizing: border-box;
}
.page-bar-space {
  padding-bottom: 200rpx;
}
.row {
  display: flex;
  align-items: center;
}
.row-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.wrap {
  flex-wrap: wrap;
}
.flex-1 {
  flex: 1;
  min-width: 0;
}

/* ---------- typography ---------- */
.serif {
  font-family: var(--serif);
}
.muted {
  color: var(--muted);
}
.faint {
  color: var(--faint);
}
.small {
  font-size: 24rpx;
}
.tiny {
  font-size: 22rpx;
}
.strong {
  font-weight: 700;
}
.break {
  word-break: break-all;
}
.mono {
  font-family: Menlo, "SF Mono", Consolas, monospace;
  font-size: 24rpx;
  word-break: break-all;
}

/* ---------- section head ---------- */
.section-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin: 40rpx 4rpx 18rpx;
}
.section-title {
  font-family: var(--serif);
  font-size: 34rpx;
  font-weight: 800;
  color: var(--deep-2);
  letter-spacing: 1rpx;
}
.section-extra {
  font-size: 24rpx;
  color: var(--muted);
}
.eyebrow {
  font-size: 20rpx;
  letter-spacing: 6rpx;
  font-weight: 800;
  color: var(--copper);
}

/* ---------- cards ---------- */
.card {
  background: var(--card);
  border: 1rpx solid var(--line);
  border-radius: var(--radius);
  padding: 28rpx;
  box-shadow: 0 6rpx 20rpx rgba(31, 64, 51, 0.035);
  box-sizing: border-box;
}
.card + .card {
  margin-top: 20rpx;
}
.card-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--ink);
  line-height: 1.45;
}
.card-sub {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--muted);
  line-height: 1.6;
}
.divider {
  height: 1rpx;
  background: var(--line-2);
  margin: 22rpx 0;
}

/* ---------- buttons (views with hover-class) ---------- */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  min-height: 80rpx;
  padding: 0 32rpx;
  border-radius: 18rpx;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.2;
  text-align: center;
  white-space: nowrap;
}
.btn-sm {
  min-height: 60rpx;
  padding: 0 22rpx;
  font-size: 24rpx;
  border-radius: 14rpx;
}
.btn-block {
  display: flex;
  width: 100%;
}
.btn-primary {
  background: var(--deep);
  color: #ffffff;
}
.btn-secondary {
  background: #ffffff;
  color: var(--deep);
  border: 1rpx solid #cbdacf;
}
.btn-ghost {
  background: var(--soft);
  color: var(--deep);
}
.btn-copper {
  background: var(--copper);
  color: #ffffff;
}
.btn-danger {
  background: var(--warn-soft);
  color: var(--warn);
  border: 1rpx solid #efd4c7;
}
.btn-hover {
  opacity: 0.78;
}
.is-disabled {
  opacity: 0.42;
}
.link {
  color: var(--deep);
  font-weight: 700;
}

/* ---------- tags ---------- */
.tag {
  display: inline-flex;
  align-items: center;
  box-sizing: border-box;
  height: 40rpx;
  padding: 0 14rpx;
  border-radius: 999rpx;
  font-size: 21rpx;
  font-weight: 700;
  white-space: nowrap;
  background: var(--soft);
  color: var(--deep);
  margin: 0 10rpx 10rpx 0;
}
.tag-ok {
  background: var(--ok-soft);
  color: var(--ok);
}
.tag-muted {
  background: #f0f1ed;
  color: #687b71;
}
.tag-copper {
  background: var(--copper-soft);
  color: var(--copper-ink);
}
.tag-warn {
  background: var(--warn-soft);
  color: var(--warn);
}
.tag-deep {
  background: var(--deep-2);
  color: #f3efe4;
}
.tag-line {
  background: transparent;
  border: 1rpx solid var(--line);
  color: var(--muted);
}

/* ---------- notices ---------- */
.notice {
  background: #eaf1e9;
  border: 1rpx solid #d5e3d5;
  border-radius: var(--radius-sm);
  color: #3c6155;
  font-size: 24rpx;
  line-height: 1.7;
  padding: 20rpx 24rpx;
}
.notice-copper {
  background: var(--copper-soft);
  border-color: #ecd6c6;
  color: var(--copper-ink);
}
.notice-warn {
  background: var(--warn-soft);
  border-color: #efd4c7;
  color: var(--warn);
}
.notice-title {
  display: block;
  font-weight: 800;
  margin-bottom: 6rpx;
  font-size: 26rpx;
}

/* ---------- status dot ---------- */
.dot {
  display: inline-block;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: var(--faint);
  margin-right: 10rpx;
  flex-shrink: 0;
}
.dot-ok {
  background: #3fae7c;
  box-shadow: 0 0 0 6rpx rgba(63, 174, 124, 0.18);
}
.dot-warn {
  background: #d9774f;
  box-shadow: 0 0 0 6rpx rgba(217, 119, 79, 0.18);
}
.dot-busy {
  background: var(--gold);
}

/* ---------- form ---------- */
.field + .field {
  margin-top: 22rpx;
}
.field-label {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--ink-2);
  margin-bottom: 10rpx;
}
.input {
  box-sizing: border-box;
  width: 100%;
  height: 84rpx;
  padding: 0 24rpx;
  background: #fbfcf9;
  border: 1rpx solid #d7e1d7;
  border-radius: 16rpx;
  font-size: 28rpx;
  color: var(--ink);
}
.input-placeholder {
  color: #a7b3ad;
}
.picker-value {
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
  height: 84rpx;
  padding: 0 24rpx;
  background: #fbfcf9;
  border: 1rpx solid #d7e1d7;
  border-radius: 16rpx;
  font-size: 28rpx;
}
.caret {
  width: 0;
  height: 0;
  border-left: 10rpx solid transparent;
  border-right: 10rpx solid transparent;
  border-top: 12rpx solid var(--muted);
  margin-left: 12rpx;
}

/* ---------- menu list ---------- */
.menu {
  background: var(--card);
  border: 1rpx solid var(--line);
  border-radius: var(--radius);
  overflow: hidden;
}
.menu-item {
  display: flex;
  align-items: center;
  padding: 30rpx 28rpx;
  font-size: 28rpx;
}
.menu-item + .menu-item {
  border-top: 1rpx solid var(--line-2);
}
.menu-glyph {
  width: 56rpx;
  height: 56rpx;
  border-radius: 16rpx;
  background: var(--soft);
  color: var(--deep);
  font-family: var(--serif);
  font-weight: 800;
  font-size: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 22rpx;
  flex-shrink: 0;
}
.menu-text {
  flex: 1;
  min-width: 0;
}
.menu-desc {
  display: block;
  font-size: 22rpx;
  color: var(--muted);
  margin-top: 2rpx;
}
.chevron {
  width: 14rpx;
  height: 14rpx;
  border-top: 3rpx solid #b3c0ba;
  border-right: 3rpx solid #b3c0ba;
  transform: rotate(45deg);
  margin-left: 16rpx;
  flex-shrink: 0;
}
.menu-hover {
  background: #f6f8f4;
}

/* ---------- skeleton ---------- */
.skeleton {
  background: var(--card);
  border: 1rpx solid var(--line);
  border-radius: var(--radius);
  padding: 28rpx;
  margin-bottom: 20rpx;
}
.sk-line {
  height: 26rpx;
  border-radius: 8rpx;
  background: linear-gradient(90deg, #eef1ec 25%, #f7f8f5 50%, #eef1ec 75%);
  background-size: 400% 100%;
  animation: shimmer 1.4s ease infinite;
}
.sk-line + .sk-line {
  margin-top: 18rpx;
}
.sk-w-90 { width: 90%; }
.sk-w-70 { width: 70%; }
.sk-w-50 { width: 50%; }
.sk-w-30 { width: 30%; }
.sk-tall { height: 34rpx; }
@keyframes shimmer {
  0% { background-position: 100% 0; }
  100% { background-position: 0 0; }
}

/* ---------- footnote ---------- */
.footnote {
  margin: 36rpx 8rpx 0;
  font-size: 22rpx;
  line-height: 1.8;
  color: var(--faint);
}
