.advisor-card { padding-top: 32rpx; padding-bottom: 32rpx; font-size: 30rpx; line-height: 1.7; word-break: break-word; }
.advisor-title { font-size: 34rpx; font-weight: 600; }
.advisor-text { margin-top: 16rpx; font-size: 30rpx; line-height: 1.7; }
.advisor-button { margin: 24rpx 0 0; padding: 18rpx 28rpx; min-height: 88rpx; box-sizing: border-box; font-size: 30rpx; line-height: 1.6; white-space: normal; }
.advisor-button::after { border: 0; }
.advisor-button.selected { background: var(--brand-tint); color: var(--brand); }
.advisor-actions { display: flex; flex-wrap: wrap; gap: 20rpx; align-items: center; }
.advisor-actions .advisor-button { flex: 1; min-width: 160rpx; }
.advisor-input { display: block; box-sizing: border-box; margin-top: 24rpx; padding: 24rpx; width: 100%; min-height: 280rpx; background: var(--fill); border-radius: 12rpx; font-size: 30rpx; line-height: 1.8; }
.advisor-error, .advisor-danger { color: var(--red); }
.advisor-error { margin-top: 16rpx; }
.advisor-check { display: flex; align-items: flex-start; gap: 12rpx; padding: 24rpx 0; min-height: 88rpx; box-sizing: border-box; }
.advisor-footer { padding: 40rpx 24rpx calc(40rpx + env(safe-area-inset-bottom)); text-align: center; font-size: 28rpx; line-height: 1.7; color: var(--t2); }
