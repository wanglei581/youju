# 2.0 云服务器的配置。复制成 .env，填好后 chmod 600 .env。.env 不进代码库。
# 标了【创始人】的要创始人提供或在后台操作；其余按说明生成。
# 生成随机串：openssl rand -hex 32

# ---- 镜像和域名 ----
YOUJU_IMAGE=youju-selfhost:latest
# 【创始人】已备案、解析到这台服务器的接口域名（不带 https://）
YOUJU_DOMAIN=api.example.com

# ---- 数据库（容器内的 MySQL）----
MYSQL_ROOT_PASSWORD=换成随机串
MYSQL_PASSWORD=换成随机串
# 和上面 MYSQL_PASSWORD 一致；切换时从云托管恢复的数据导进这个库
YOUJU_DATABASE_URL=mysql+pymysql://youju:换成上面的MYSQL_PASSWORD@mysql:3306/youju?charset=utf8mb4

# ---- 部署方式（2.0 自建服务器）----
YOUJU_HOSTING=self
YOUJU_SESSION_LOGIN=true
YOUJU_SESSION_SECRET=换成随机串
YOUJU_WX_OPEN_API=token
YOUJU_CLIENT_IP_HEADER=x-forwarded-for
YOUJU_LOG_MASK_IP=true
YOUJU_PUBLIC_REPLICA=true
# 核对台口令（只在服务器上经 SSH 隧道用），至少 32 位
YOUJU_ADMIN_TOKEN=换成随机串

# ---- 小程序（【创始人】小程序后台"开发管理 → 开发设置"）----
YOUJU_WX_APPID=wx________________
YOUJU_WX_APPSECRET=
# 消息推送（虚拟支付发货、退款、投诉，客服消息）：小程序后台"开发管理 → 消息推送"填
#   URL：https://<YOUJU_DOMAIN>/api/wx/push，Token、EncodingAESKey 和这里一致，选"安全模式"、数据格式 JSON
YOUJU_WX_PUSH_MODE=signed
YOUJU_WX_PUSH_TOKEN=换成3到32位英文数字
YOUJU_WX_PUSH_AES_KEY=换成43位英文数字

# ---- 对象存储：用户的批量工具结果、附件副本、每天的备份（只备用户数据，D-129 ⑥）都放服务器硬盘（COS 下载要付流量费）----
YOUJU_STORAGE_BACKEND=disk
YOUJU_STORAGE_DIR=/data/storage
# 沿用云托管的环境 ID 和存储桶名：切换时拷过来的旧文件 ID 不用改（见切换手册）
YOUJU_CLOUD_ENV=prod-d5getqftefb61fc92
YOUJU_STORAGE_BUCKET=youju-self

# ---- 本机推公开数据过来的密钥（和本机 .env 里的一样），至少 32 位 ----
YOUJU_SYNC_SECRET=换成随机串

# ---- 异地备份（【创始人】腾讯云 COS 建一个存储桶，子账号只给这个桶的上传、列表、删除权限；
#      本机另用一个只能列表、下载的子账号，每天下一份密文再留一份）----
YOUJU_OFFSITE_S3_ENDPOINT=https://cos.ap-shanghai.myqcloud.com
YOUJU_OFFSITE_S3_REGION=ap-shanghai
YOUJU_OFFSITE_S3_BUCKET=youju-backup-1250000000
YOUJU_OFFSITE_S3_ACCESS_KEY=
YOUJU_OFFSITE_S3_SECRET_KEY=
# 低频：能直接下载，本机才拉得到副本（归档 ARCHIVE 更便宜但要先恢复几小时才能下）
YOUJU_OFFSITE_STORAGE_CLASS=STANDARD_IA
# 【创始人】age-keygen 生成的公钥（age1 开头）；私钥只在创始人手里，不放服务器
YOUJU_OFFSITE_AGE_RECIPIENT=

# ---- 其余照抄云托管现在的环境变量（AI、支付、协议版本、提醒模板、告警群机器人……）----
# YOUJU_AGREEMENT_VERSION=2027-01
# YOUJU_ALERT_WEBHOOK=
# YOUJU_AI_API_KEY=
# YOUJU_PAY_ENABLED=...
