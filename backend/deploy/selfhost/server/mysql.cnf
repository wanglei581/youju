# 2 核 4G 服务器上的 MySQL 8：容器限 1.4G 内存。
[mysqld]
innodb_buffer_pool_size = 768M
innodb_log_file_size = 256M
innodb_flush_log_at_trx_commit = 1
max_connections = 80
# 性能统计要多占 400MB 左右内存，小服务器关掉
performance_schema = OFF
table_open_cache = 1024
tmp_table_size = 32M
max_heap_table_size = 32M
# 二进制日志（binlog）关掉：没在用——不做主从，也没有按时刻恢复，恢复只用每天的备份（手册第八节）
disable_log_bin
# 慢查询日志、通用查询日志都关着（MySQL 8 默认就关，这里写明）
slow_query_log = OFF
general_log = OFF
# 同步一批最多 64MB（压缩前更大），写库用的单条语句要放得下
max_allowed_packet = 128M
skip_name_resolve = ON
