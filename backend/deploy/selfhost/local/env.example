# 2.0 本机（Windows 主机）的配置。复制成 .env 填好。.env 不进代码库。
# 本机只有公开数据：不配 AppSecret、支付密钥这些用户相关的东西。

YOUJU_IMAGE=youju-selfhost:latest
# 不在云托管上：不信任任何微信请求头，本机也不调微信接口
YOUJU_HOSTING=self
MYSQL_ROOT_PASSWORD=换成随机串
MYSQL_PASSWORD=换成随机串
YOUJU_DATABASE_URL=mysql+pymysql://youju:换成上面的MYSQL_PASSWORD@mysql:3306/youju?charset=utf8mb4

# 核对台口令（只在这台电脑的浏览器里用：http://127.0.0.1:8080/admin），至少 32 位
YOUJU_ADMIN_TOKEN=换成随机串

# 原始文件（附件副本、整库备份）存在 Docker 卷里
YOUJU_STORAGE_BACKEND=disk
YOUJU_STORAGE_DIR=/data/storage
YOUJU_CLOUD_ENV=prod-d5getqftefb61fc92
YOUJU_STORAGE_BUCKET=youju-self

# 推到服务器：地址和密钥（和服务器 .env 里的 YOUJU_SYNC_SECRET 一样）
YOUJU_SYNC_URL=https://api.example.com
YOUJU_SYNC_SECRET=换成和服务器一样的随机串

# 后台 AI（截止日期交叉核对、分类、申报条件抽取）：照抄云托管 admin 现在的
# YOUJU_AI_BASE_URL=
# YOUJU_AI_API_KEY=
# YOUJU_AI_MODEL=
# YOUJU_AI_REQUEST_EXTRA=
# 告警群机器人（任务失败、服务器不通都提醒到这里）
# YOUJU_ALERT_WEBHOOK=
